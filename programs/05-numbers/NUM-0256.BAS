1 REM FBCS NUM-0256
2 REM CLAIM A-5.6.4-TR144
3 REM TYPE OUTPUT
4 REM STD 5.6.4 l.2287-2289 and 8.2.6: ON GOTO to an OPTION line inside an EXTERNAL FUNCTION continues at the next line.
10 DECLARE EXTERNAL FUNCTION F
20 PRINT F
30 END
100 EXTERNAL FUNCTION F
110 LET K = 0
120 OPTION ANGLE DEGREES
130 LET K = K + 1
140 ON K GOTO 120, 150
150 LET F = K
160 END FUNCTION
