1 REM FBCS NUM-0122
2 REM CLAIM A-5.3.2-01
3 REM TYPE SELF
100 REM VALID CALLS OF SUPPLIED FUNCTIONS WITH EXPRESSIONS OF EVERY FORM STILL LOAD (CONTROL OF NUM-0117 TO NUM-0121)
110 DIM N(3)
120 LET N(1) = -2
130 LET S$ = "abc"
140 LET OK = 1
150 IF ABS(N(1)) <> 2 OR ABS(-3 + 1) <> 2 OR MAX(1, 2) <> 2 OR MIN(N(1), 4) <> -2 OR MOD(7, 3) <> 1 THEN LET OK = 0
160 IF LEN(S$) <> 3 OR LEN(S$ & "x") <> 4 OR LEN(S$(1:2)) <> 2 OR LEN(UCASE$(S$)) <> 3 OR LEN("") <> 0 THEN LET OK = 0
170 IF POS(S$, "b") <> 2 OR POS(S$, "b", 1) <> 2 OR POS(S$ & "x", LCASE$("C"), N(1) + 3) <> 3 THEN LET OK = 0
180 IF VAL("12") <> 12 OR VAL(STR$(5)) <> 5 OR ORD("A") <> 65 OR CHR$(65) <> "A" OR REPEAT$("ab", 2) <> "abab" THEN LET OK = 0
190 IF STR$(MAX(1, 2)) <> "2" OR USING$("##", 12) <> "12" THEN LET OK = 0
200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
