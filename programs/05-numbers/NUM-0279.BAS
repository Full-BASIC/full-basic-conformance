1 REM FBCS NUM-0279
2 REM CLAIM A-5.4.4-CL30
3 REM TYPE SELF
4 REM STD 5.4.4 l.2001-2002 and l.2014-2015: MOD and REMAINDER are exact in DECIMAL even when the quotient has hundreds of digits.
100 OPTION ARITHMETIC DECIMAL
110 LET OK = 1
120 LET A = MOD(1E40, 7)
130 LET B = MOD(-1E40, 7)
140 LET C = REMAINDER(1E30, 3)
150 LET D = REMAINDER(-1E40, 7)
160 LET E = MOD(1E39, .3)
170 LET F = MOD(-7.5, 2)
180 LET G = REMAINDER(-7.5, 2)
190 LET H = MOD(999999999999999999, 7)
200 IF A <> 4 OR B <> 3 OR C <> 1 OR D <> -4 THEN LET OK = 0
210 IF E <> .1 OR F <> .5 OR G <> -1.5 OR H <> 0 THEN LET OK = 0
220 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END
