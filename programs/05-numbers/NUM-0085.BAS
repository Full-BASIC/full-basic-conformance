1 REM FBCS NUM-0085
2 REM CLAIM A-5.4-G01
3 REM TYPE SELF
100 PRINT "NUM-0085 ACOS AND ASIN AT PLUS/MINUS ONE (5.4)"
110 LET OK = 1
120 IF ABS(ACOS(1) - 0) > 1E-12 THEN LET OK = 0
130 IF ABS(ACOS(-1) - PI) > 1E-12 THEN LET OK = 0
