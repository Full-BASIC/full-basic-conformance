1 REM FBCS NUM-0112
2 REM CLAIM A-5.6.4-03
3 REM TYPE SELF
100 REM WITH OPTION ANGLE DEGREES THE TRUE RESULT OF SIN, COS, TAN, COT, SEC AND CSC AT A MULTIPLE OF 90
101 REM DEGREES IS 0, 1 OR -1. THE EXACT RESULT IS REQUIRED ONLY WITH DECIMAL ARITHMETIC (5.6.4 L.2252-2257,
102 REM NUM-0110). 15.1.4 L.12230-12234 (FIXED): THE ACCURACY OF NUMERIC FUNCTION
103 REM EVALUATION IS IMPLEMENTATION-DEFINED;
104 REM SO HERE THE RESULT SHALL BE WITHIN .001 OF THE TRUE VALUE - FIXED
105 OPTION ARITHMETIC FIXED *8.4
110 OPTION ANGLE DEGREES
115 LET T = .001
120 LET BAD = 0
130 IF ABS(SIN(0)) > T OR ABS(SIN(180)) > T OR ABS(SIN(360)) > T OR ABS(SIN(-180)) > T THEN LET BAD = BAD + 1
140 IF ABS(SIN(90) - 1) > T OR ABS(SIN(450) - 1) > T OR ABS(SIN(270) + 1) > T THEN LET BAD = BAD + 1
145 IF ABS(SIN(-90) + 1) > T THEN LET BAD = BAD + 1
150 IF ABS(COS(0) - 1) > T OR ABS(COS(180) + 1) > T OR ABS(COS(90)) > T OR ABS(COS(270)) > T THEN LET BAD = BAD + 1
155 IF ABS(COS(-90)) > T THEN LET BAD = BAD + 1
160 IF ABS(TAN(0)) > T OR ABS(TAN(180)) > T OR ABS(TAN(360)) > T THEN LET BAD = BAD + 1
170 IF ABS(COT(90)) > T OR ABS(COT(270)) > T OR ABS(COT(-90)) > T THEN LET BAD = BAD + 1
180 IF ABS(SEC(0) - 1) > T OR ABS(SEC(180) + 1) > T OR ABS(CSC(90) - 1) > T OR ABS(CSC(270) + 1) > T THEN LET BAD = BAD + 1
190 IF ABS(SIN(30) - .5) > T OR ABS(COS(60) - .5) > T OR ABS(TAN(45) - 1) > T THEN LET BAD = BAD + 1
200 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; BAD
210 END
