1 REM FBCS NUM-0283
2 REM CLAIM A-5.6.4-FN1
3 REM TYPE SELF
4 REM STD 5.4.5 l.2091-2092, 5.6.4: the domain of ACOS, ASIN and LOG is checked on the exact decimal argument.
5 REM 1.00000000000000001 and -1.0000000000000001 exceed 1 in magnitude by 1E-17 and raise 3007; LOG of a tiny negative raises 3004.
100 LET F = 0
110 WHEN EXCEPTION IN
120   LET X = ACOS(1.00000000000000001)
130   LET F = F + 1
140 USE
150   IF EXTYPE <> 3007 THEN LET F = F + 1
160 END WHEN
170 WHEN EXCEPTION IN
180   LET X = ASIN(-1.0000000000000001)
190   LET F = F + 1
200 USE
210   IF EXTYPE <> 3007 THEN LET F = F + 1
220 END WHEN
230 WHEN EXCEPTION IN
240   LET X = LOG(-1E-300)
250   LET F = F + 1
260 USE
270   IF EXTYPE <> 3004 THEN LET F = F + 1
280 END WHEN
290 IF ACOS(1) <> 0 OR ASIN(-1) + ACOS(0) <> 0 THEN LET F = F + 1
300 IF LOG(1E-300) >= 0 THEN LET F = F + 1
310 IF F = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
320 END
