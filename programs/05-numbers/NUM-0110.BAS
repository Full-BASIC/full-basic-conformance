1 REM FBCS NUM-0110
2 REM CLAIM A-5.6.4-03
3 REM TYPE SELF
100 REM WITH OPTION ANGLE DEGREES THE TRUE RESULT OF SIN, COS, TAN, COT, SEC AND CSC AT A MULTIPLE OF 90
101 REM DEGREES IS 0, 1 OR -1, EXPRESSIBLE WITH M+1 DIGITS, SO THE COMPUTED RESULT SHALL BE EXACT (5.6.4
102 REM L.2252-2257; THE ARGUMENT IS EXACT, 5.4.4 L.2058-2065) - DEFAULT (DECIMAL)
110 OPTION ANGLE DEGREES
120 LET BAD = 0
130 IF SIN(0) <> 0 OR SIN(180) <> 0 OR SIN(360) <> 0 OR SIN(-180) <> 0 THEN LET BAD = BAD + 1
140 IF SIN(90) <> 1 OR SIN(450) <> 1 OR SIN(270) <> -1 OR SIN(-90) <> -1 THEN LET BAD = BAD + 1
150 IF COS(0) <> 1 OR COS(180) <> -1 OR COS(90) <> 0 OR COS(270) <> 0 OR COS(-90) <> 0 THEN LET BAD = BAD + 1
160 IF TAN(0) <> 0 OR TAN(180) <> 0 OR TAN(360) <> 0 THEN LET BAD = BAD + 1
170 IF COT(90) <> 0 OR COT(270) <> 0 OR COT(-90) <> 0 THEN LET BAD = BAD + 1
180 IF SEC(0) <> 1 OR SEC(180) <> -1 OR CSC(90) <> 1 OR CSC(270) <> -1 THEN LET BAD = BAD + 1
190 IF ABS(SIN(30) - .5) > 1E-9 OR ABS(COS(60) - .5) > 1E-9 OR ABS(TAN(45) - 1) > 1E-9 THEN LET BAD = BAD + 1
200 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; BAD
210 END
