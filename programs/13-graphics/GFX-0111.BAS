1 REM FBCS GFX-0111
2 REM CLAIM E-11088
3 REM TYPE SELF
100 PRINT "GFX-0111 COLOR MIX COMPONENT OUT OF [0,1] IS NONFATAL 11088 (13.2.5)"
110 SET COLOR MIX(1) 0.1, 0.2, 0.3
120 LET OK = 1
130 WHEN EXCEPTION IN
140   SET COLOR MIX(1) 0.5, 1.5, 0.2
150 USE
160   IF EXTYPE <> 11088 THEN LET OK = 0
170 END WHEN
180 ASK COLOR MIX(1) R, G, B
190 IF ABS(R - .1) > 1E-9 OR ABS(G - .2) > 1E-9 OR ABS(B - .3) > 1E-9 THEN LET OK = 0
200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
