1 REM FBCS GFX-0103
2 REM CLAIM E-11051
3 REM TYPE SELF
100 PRINT "GFX-0103 ZERO OR NEGATIVE WIDTH/HEIGHT IS NONFATAL 11051, KEEPS CURRENT (13.1.5)"
110 LET OK = 1
120 WHEN EXCEPTION IN
130   SET WINDOW 5, 5, 0, 1
140 USE
150   IF EXTYPE <> 11051 THEN LET OK = 0
160 END WHEN
170 ASK WINDOW L, R, B, T
180 IF NOT (L = 0 AND R = 1 AND B = 0 AND T = 1) THEN LET OK = 0
190 WHEN EXCEPTION IN
200   SET VIEWPORT 0.5, 0.2, 0, 1
210 USE
220   IF EXTYPE <> 11051 THEN LET OK = 0
230 END WHEN
240 ASK VIEWPORT L, R, B, T
250 IF NOT (L = 0 AND R = 1 AND B = 0 AND T = 1) THEN LET OK = 0
260 WHEN EXCEPTION IN
270   SET DEVICE WINDOW 0, 0, 0, 1
280 USE
290   IF EXTYPE <> 11051 THEN LET OK = 0
300 END WHEN
310 ASK DEVICE WINDOW L, R, B, T
320 IF NOT (L = 0 AND R = 1 AND B = 0 AND T = 1) THEN LET OK = 0
330 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
340 END
