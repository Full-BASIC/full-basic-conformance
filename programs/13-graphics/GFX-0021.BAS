1 REM FBCS GFX-0021
2 REM CLAIM A-13.1.4-05
3 REM TYPE SELF
100 PRINT "GFX-0021 SET CLIP ON/OFF ANY CASE AND CLIPPING STARTS ENABLED (13.1.4)"
110 ASK CLIP C$
120 LET OK = 1
130 IF C$ <> "ON" THEN LET OK = 0
140 SET CLIP "on"
150 ASK CLIP C$
160 IF C$ <> "ON" THEN LET OK = 0
170 SET CLIP "Off"
180 ASK CLIP C$
190 IF C$ <> "OFF" THEN LET OK = 0
200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
