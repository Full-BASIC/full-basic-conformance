1 REM FBCS GFX-0018
2 REM CLAIM A-13.5.3-EX
3 REM TYPE GRAPHIC
100 PRINT "GFX-0018 ALL EXAMPLES OF 13.5.3 (13.5.3)"
110 DECLARE PICTURE HOUSE, SPIN
120 DECLARE EXTERNAL PICTURE CIRCLE
130 DRAW CIRCLE
140 DRAW CIRCLE WITH SHIFT(2,0) * SCALE(.4)
150 DRAW HOUSE("SPLIT-LEVEL", 80000) WITH SHEAR(.1)
160 DRAW SPIN
170 DIM SPIN_SHRINK(4,4)
180 MAT SPIN_SHRINK = ROTATE(180)*SCALE(.1)
190 DIM WHERE_AM_I(4,4)
200 MAT WHERE_AM_I = TRANSFORM
210 LET X = .5
220 PLOT LINES: X, SIN(X);
230 STOP
240 PICTURE HOUSE(S$, N)
250 PLOT LINES: 0,0; 1,0; 1,1; 0,1; 0,0;
260 END PICTURE
270 PICTURE SPIN
280 EXIT PICTURE
290 PLOT LINES: 9,9;
300 END PICTURE
999 END
1000 EXTERNAL PICTURE CIRCLE
1010 LET P = 2*PI/50
1020 FOR I = 0 TO 50
1030 LET IP = I*P
1040 PLOT LINES: COS(IP), SIN(IP);
1050 NEXT I
1060 END PICTURE
