1 REM FBCS GFX-0026
2 REM CLAIM A-13.1.4-10
3 REM TYPE SELF
100 PRINT "GFX-0026 ASK DEVICE SIZE H V AND METERS/OTHER UPPER CASE (13.1.4)"
110 ASK DEVICE SIZE H, V, U$
120 LET OK = 1
130 IF U$ <> "METERS" AND U$ <> "OTHER" THEN LET OK = 0
140 IF UCASE$(U$) <> U$ THEN LET OK = 0
150 IF H <= 0 OR V <= 0 THEN LET OK = 0
160 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END
