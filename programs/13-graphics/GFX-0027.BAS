1 REM FBCS GFX-0027
2 REM CLAIM A-13.1.4-11
3 REM TYPE SELF
100 PRINT "GFX-0027 ASK CLIP STORES ON OR OFF UPPER CASE (13.1.4)"
110 SET CLIP "ON"
120 ASK CLIP C$
130 LET OK = 1
140 IF C$ <> "ON" THEN LET OK = 0
150 SET CLIP "off"
160 ASK CLIP C$
170 IF C$ <> "OFF" THEN LET OK = 0
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
