1 REM FBCS GFX-0036
2 REM CLAIM A-13.2.4-08
3 REM TYPE SELF
100 PRINT "GFX-0036 SET COLOR ROUNDS INDEX, FOREGROUND INDICES START AS ONE (13.2.4)"
110 ASK LINE COLOR LC
120 ASK POINT COLOR PC
130 ASK TEXT COLOR TC
140 ASK AREA COLOR AC
150 LET OK = 1
160 IF LC <> 1 OR PC <> 1 OR TC <> 1 OR AC <> 1 THEN LET OK = 0
170 SET LINE COLOR 3.7
180 ASK LINE COLOR LC
190 IF LC <> 4 THEN LET OK = 0
200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
