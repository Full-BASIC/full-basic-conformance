1 REM FBCS GFX-0017
2 REM CLAIM A-13.4.3-EX
3 REM TYPE SELF
100 PRINT "GFX-0017 ALL EXAMPLES OF 13.4.3 RUN (13.4.3)"
110 SET WINDOW 0, 10, 0, 10
120 LET OK = 1
130 LOCATE POINT: X_IN, Y_IN
140 LOCATE POINT, AT 4.7, 5.2: WIDE, LONG
150 IF ABS(WIDE - 4.7) > 1E-9 OR ABS(LONG - 5.2) > 1E-9 THEN LET OK = 0
160 LOCATE VALUE(3), RANGE -7 TO 7: AMPS
170 IF AMPS < -7 OR AMPS > 7 THEN LET OK = 0
180 LOCATE CHOICE: BUTTON
190 ASK MAX CHOICE DEVICE MAXB
200 IF BUTTON < 0 OR BUTTON > MAXB THEN LET OK = 0
210 DIM XVALS(2), YVALS(2)
220 MAT LOCATE POINT: XVALS(?), YVALS(?)
230 LET INDEV = 1
240 DIM POINTS(2,2)
250 MAT LOCATE POINT(INDEV), AT 0,0: POINTS
260 DIM SKETCH(2,2)
270 MAT LOCATE POINT: SKETCH(?,)
280 DIM TIMES(2), TEMPS(2)
290 MAT LOCATE POINT: TIMES, TEMPS
300 ASK MAX CHOICE DEVICE LAST_BUTTON_SET
310 ASK MAX MULTIPOINT DEVICE NSTROKES
320 ASK PIXEL SIZE(.5,2.5;0,0) XV, YV
330 DIM PIX_VALS(2,2)
340 ASK PIXEL ARRAY(.5,2.5) PIX_VALS
350 LET TIMEL = 1
360 LET WEIGHT = 2
370 ASK PIXEL VALUE(TIMEL,WEIGHT) CURPOINT
380 IF CURPOINT <> -1 THEN LET OK = 0
390 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
400 END
