1 REM FBCS GFX-0164
2 REM CLAIM A-13.5.4-14
3 REM TYPE OUTPUT
100 REM The OPTION ANGLE of an external picture-def applies inside it only (5.6, 13.5.4)
110 DECLARE EXTERNAL PICTURE P
120 DRAW P
130 IF ABS(SIN(90) - 1) < .00001 THEN PRINT "MAIN DEGREES" ELSE PRINT "MAIN RADIANS"
140 END
200 EXTERNAL PICTURE P
210 OPTION ANGLE DEGREES
220 IF ABS(SIN(90) - 1) < .00001 THEN PRINT "PICTURE DEGREES" ELSE PRINT "PICTURE RADIANS"
230 END PICTURE
