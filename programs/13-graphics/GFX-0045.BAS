130 ASK TEXT JUSTIFY H$, V$
140 IF H$ <> "CENTER" OR V$ <> "HALF" THEN LET OK = 0
150 SET TEXT JUSTIFY "LEFT", "TOP"
160 ASK TEXT JUSTIFY H$, V$
170 IF H$ <> "LEFT" OR V$ <> "TOP" THEN LET OK = 0
180 SET TEXT JUSTIFY "right", "Cap"
190 ASK TEXT JUSTIFY H$, V$
