1 REM FBCS GFX-0031
2 REM CLAIM A-13.2.4-03
3 REM TYPE SELF
100 PRINT "GFX-0031 AT LEAST FOUR LINE STYLES, LINE STYLE STARTS AS ONE (13.2.4)"
110 ASK MAX LINE STYLE M
120 ASK LINE STYLE S
130 LET OK = 1
140 IF M < 4 OR S <> 1 THEN LET OK = 0
150 FOR I = 1 TO 4
160   WHEN EXCEPTION IN
170     SET LINE STYLE I
180   USE
190     LET OK = 0
200   END WHEN
210 NEXT I
220 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END
