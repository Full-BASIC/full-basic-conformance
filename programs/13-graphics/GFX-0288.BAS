1 REM FBCS GFX-0288
2 REM CLAIM A-13.4.4-10
3 REM TYPE SELF
4 REM 13.4.2 syntax 15 (l.10140-10142), 6.1 syntax 2 (l.2405-2407), 6.5.4 (l.2797-2810): the presence
5 REM variable of ASK PIXEL ARRAY is any string-variable, also an array element or a substring.
100 PRINT "GFX-0288 ASK PIXEL ARRAY PRESENCE IN AN ELEMENT AND A SUBSTRING (13.4.4)"
110 DIM P(2,2), S$(3)
120 LET S$(1) = "A"
130 LET S$(3) = "C"
140 LET T$ = "XYZW"
150 ASK PIXEL ARRAY (0,0) P, S$(2)
160 ASK PIXEL ARRAY (0,0) P, T$(2:3)
170 LET OK = 1
180 IF S$(2) <> "PRESENT" AND S$(2) <> "ABSENT" THEN LET OK = 0
190 IF S$(1) <> "A" OR S$(3) <> "C" THEN LET OK = 0
200 IF T$ <> "XPRESENTW" AND T$ <> "XABSENTW" THEN LET OK = 0
210 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 END
