1 REM FBCS GFX-0093
2 REM CLAIM E-4101
3 REM TYPE SELF
100 PRINT "GFX-0093 SET CLIP NEITHER ON NOR OFF IS NONFATAL 4101 (13.1.5)"
110 SET CLIP "ON"
120 WHEN EXCEPTION IN
130   SET CLIP "SIDEWAYS"
140   PRINT "*** TEST FAILED: NO EXCEPTION ***"
150 USE
160   IF EXTYPE <> 4101 THEN PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
170 END WHEN
180 ASK CLIP C$
190 IF C$ = "ON" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: CLIP CHANGED"
200 END
