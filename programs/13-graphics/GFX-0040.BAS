1 REM FBCS GFX-0040
2 REM CLAIM A-13.2.4-12
3 REM TYPE SELF
100 PRINT "GFX-0040 ASK MAX COLOR LARGEST USABLE INDEX, 0..MAX VALID (13.2.4)"
110 ASK MAX COLOR M
120 LET OK = 1
130 IF M < 1 THEN LET OK = 0
140 WHEN EXCEPTION IN
150   SET COLOR MIX(0) 0, 0, 0
160   SET LINE COLOR M
170   SET AREA COLOR 0
180 USE
190   LET OK = 0
200 END WHEN
210 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 END
