1 REM FBCS GFX-0109
2 REM CLAIM E-11073
3 REM TYPE SELF
100 PRINT "GFX-0109 TEXT HEIGHT <= 0 IS NONFATAL 11073, KEEPS CURRENT (13.2.5)"
110 LET OK = 1
120 WHEN EXCEPTION IN
130   SET TEXT HEIGHT 0
140 USE
150   IF EXTYPE <> 11073 THEN LET OK = 0
160 END WHEN
170 ASK TEXT HEIGHT H
180 IF ABS(H - .01) > 1E-9 THEN LET OK = 0
190 WHEN EXCEPTION IN
200   SET TEXT HEIGHT -1
210 USE
220   IF EXTYPE <> 11073 THEN LET OK = 0
230 END WHEN
240 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 END
