1 REM FBCS GFX-0060
2 REM CLAIM A-13.4.4-03
3 REM TYPE SELF
100 PRINT "GFX-0060 LOCATE POINT STORES X FIRST Y SECOND INSIDE WINDOW (13.4.4)"
110 SET WINDOW 0, 10, 0, 10
120 LOCATE POINT: X, Y
130 IF X >= 0 AND X <= 10 AND Y >= 0 AND Y <= 10 AND ABS(X - 5) < 1E-9 AND ABS(Y - 5) < 1E-9 THEN PRINT "*** TEST PASSED ***" ELSE &
&PRINT "*** TEST FAILED ***"
140 END
