190    PRINT "*** TEST PASSED ***"
200 ELSE
210    PRINT "*** TEST FAILED: THE PICTURE DID NOT SEE OR CHANGE THE VARIABLES OF ITS UNIT"
220 END IF
230 STOP
300 PICTURE P
