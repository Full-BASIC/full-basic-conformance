1 REM FBCS GFX-0105
2 REM CLAIM E-11053
3 REM TYPE SELF
100 PRINT "GFX-0105 DEVICE WINDOW OUTSIDE [0,1] IS NONFATAL 11053 (13.1.5)"
110 LET OK = 1
120 WHEN EXCEPTION IN
130   SET DEVICE WINDOW 1.5, 2, 0, 1
140 USE
150   IF EXTYPE <> 11053 THEN LET OK = 0
160 END WHEN
170 ASK DEVICE WINDOW L, R, B, T
180 IF NOT (L = 0 AND R = 1 AND B = 0 AND T = 1) THEN LET OK = 0
190 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
