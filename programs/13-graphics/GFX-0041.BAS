1 REM FBCS GFX-0041
2 REM CLAIM A-13.2.4.1-01
3 REM TYPE SELF
100 PRINT "GFX-0041 TEXT HEIGHT STARTS AT 0.01 AND ASK RETURNS THE SET VALUE (13.2.4 l.9637-9641)"
110 ASK TEXT HEIGHT H
120 LET OK = 1
130 IF ABS(H - .01) > 1E-9 THEN LET OK = 0
140 SET TEXT HEIGHT 0.5
150 ASK TEXT HEIGHT H2
160 IF ABS(H2 - .5) > 1E-9 THEN LET OK = 0
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
