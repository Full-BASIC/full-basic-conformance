1 REM FBCS GFX-0035
2 REM CLAIM A-13.2.4-07
3 REM TYPE SELF
100 PRINT "GFX-0035 EVERY STYLE 1..MAX IS VALID (13.2.4)"
110 ASK MAX LINE STYLE ML
120 ASK MAX POINT STYLE MP
130 LET OK = 1
140 FOR I = 1 TO ML
150   WHEN EXCEPTION IN
160     SET LINE STYLE I
170   USE
180     LET OK = 0
190   END WHEN
200 NEXT I
210 FOR I = 1 TO MP
220   WHEN EXCEPTION IN
230     SET POINT STYLE I
240   USE
250     LET OK = 0
260   END WHEN
270 NEXT I
280 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
290 END
