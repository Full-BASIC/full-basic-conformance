1 REM FBCS GFX-0034
2 REM CLAIM A-13.2.4-06
3 REM TYPE SELF
100 PRINT "GFX-0034 ASK MAX LINE/POINT STYLE STORES LARGEST AVAILABLE (13.2.4)"
110 ASK MAX LINE STYLE ML
120 ASK MAX POINT STYLE MP
130 LET OK = 1
140 IF ML < 4 OR MP < 5 THEN LET OK = 0
150 WHEN EXCEPTION IN
160   SET LINE STYLE ML
170 USE
180   LET OK = 0
190 END WHEN
200 WHEN EXCEPTION IN
210   SET POINT STYLE MP
220 USE
230   LET OK = 0
240 END WHEN
250 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 END
