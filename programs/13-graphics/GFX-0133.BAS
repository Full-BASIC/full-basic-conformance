1 REM FBCS GFX-0133
2 REM CLAIM D-13.4-2
3 REM TYPE INPUT
100 PRINT "GFX-0133 INPUT OUTSIDE WINDOW ACCEPTED, INDICATOR POSITION RETURNED (Ap C 13.4)"
110 SET WINDOW 0, 1, 0, 1
120 LOCATE POINT: X, Y
130 IF ABS(X - .5) < 1E-9 AND ABS(Y - .5) < 1E-9 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
140 END
