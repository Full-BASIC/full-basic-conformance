1 REM FBCS GFX-0136
2 REM CLAIM D-13.5.4.1-1
3 REM TYPE SELF
100 PRINT "GFX-0136 GET POINT WITH SINGULAR TRANSFORM RETURNS RAW POINT (Ap C 13.5)"
110 DECLARE PICTURE Q
120 DRAW Q WITH SCALE(0)
130 STOP
200 PICTURE Q
210 GET POINT: X, Y
220 IF ABS(X - .5) < 1E-9 AND ABS(Y - .5) < 1E-9 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END PICTURE
999 END
