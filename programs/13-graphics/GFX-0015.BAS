1 REM FBCS GFX-0015
2 REM CLAIM A-13.2.3-EX
3 REM TYPE SELF
100 PRINT "GFX-0015 ALL EXAMPLES OF 13.2.3 ARE ACCEPTED (13.2.3)"
110 LET N = 39
120 LET R = 1
130 LET RED = 3
140 LET P_STYLE = 2
150 LET OK = 1
160 SET LINE STYLE 2
170 SET TEXT COLOR 5
180 SET AREA COLOR RED
190 SET TEXT HEIGHT (N+3)/42
200 SET TEXT JUSTIFY "Center", "Half"
210 SET COLOR MIX (4) .5, R*.5, .3
220 SET POINT STYLE P_STYLE
230 ASK MAX COLOR COLOR_MAX
240 ASK MAX POINT STYLE PTSTYLES
250 ASK COLOR MIX (4) MR, MG, MB
260 IF ABS(MR - .5) > 1E-9 OR ABS(MG - .5) > 1E-9 OR ABS(MB - .3) > 1E-9 THEN LET OK = 0
270 IF COLOR_MAX < 1 OR PTSTYLES < 5 THEN LET OK = 0
280 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
290 END
