1 REM FBCS GFX-0137
2 REM CLAIM E-11085
3 REM TYPE SELF
100 PRINT "GFX-0137 CELLS COLOR INDEX OUT OF RANGE IS NONFATAL 11085 (13.3.5)"
110 DIM C(2,2)
120 MAT C = CON
130 LET C(1,1) = 999
140 LET OK = 0
150 WHEN EXCEPTION IN
160   MAT GRAPH CELLS, IN 0,0; 1,1: C
