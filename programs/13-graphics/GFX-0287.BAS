1 REM FBCS GFX-0287
2 REM CLAIM A-13.4.4-07
3 REM TYPE SELF
4 REM STD 13.4.4 l.10286-10289: with no device-select the value one is used, so a LOCATE VALUE without
5 REM device-select reuses the range remembered for device one, and the reverse.
100 PRINT "GFX-0287 AN OMITTED DEVICE-SELECT MEANS DEVICE ONE (13.4.4)"
110 LET OK = 1
120 LOCATE VALUE (1), RANGE 2 TO 4: V1
130 LOCATE VALUE: V2
140 IF V2 < 2 OR V2 > 4 THEN LET OK = 0
150 LOCATE VALUE, RANGE 6 TO 8: V3
160 LOCATE VALUE (1): V4
170 IF V4 < 6 OR V4 > 8 THEN LET OK = 0
180 IF OK = 0 THEN
190    PRINT "*** TEST FAILED: OMITTED DEVICE-SELECT IS NOT DEVICE ONE ***"
200 ELSE
210    PRINT "*** TEST PASSED ***"
220 END IF
230 END
