1 REM FBCS GFX-0020
2 REM CLAIM A-13.1.4-04
3 REM TYPE SELF
100 PRINT "GFX-0020 SET VIEWPORT NDC EDGES IN [0,1], DEFAULT (0,1,0,1) (13.1.4)"
110 ASK VIEWPORT L, R, B, T
120 LET OK = 1
130 IF L <> 0 OR R <> 1 OR B <> 0 OR T <> 1 THEN LET OK = 0
140 SET VIEWPORT 0.1, 0.9, 0.2, 0.8
150 ASK VIEWPORT L, R, B, T
160 IF ABS(L - .1) > 1E-9 OR ABS(R - .9) > 1E-9 OR ABS(B - .2) > 1E-9 OR ABS(T - .8) > 1E-9 THEN LET OK = 0
170 IF L < 0 OR R > 1 OR B < 0 OR T > 1 OR L >= R OR B >= T THEN LET OK = 0
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
