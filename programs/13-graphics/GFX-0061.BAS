1 REM FBCS GFX-0061
2 REM CLAIM A-13.4.4-04
3 REM TYPE SELF
100 PRINT "GFX-0061 MAT LOCATE FILLS PAIR, LONE MATRIX COLS, REDIM SECOND DIM 2 (13.4.4)"
110 SET WINDOW 0, 10, 0, 10
120 LET OK = 1
130 DIM X(3), Y(3)
140 MAT LOCATE POINT: X(?), Y(?)
150 IF UBOUND(X,1) <> 3 OR UBOUND(Y,1) <> 3 THEN LET OK = 0
160 IF ABS(X(1) - 5) > 1E-9 OR ABS(Y(2) - 5) > 1E-9 THEN LET OK = 0
170 DIM M(2,2)
180 MAT LOCATE POINT: M(?,)
190 IF UBOUND(M,2) <> 2 THEN LET OK = 0
200 IF ABS(M(1,1) - 5) > 1E-9 OR ABS(M(1,2) - 5) > 1E-9 THEN LET OK = 0
210 DIM T(2), E(2)
220 MAT LOCATE POINT: T, E
230 IF ABS(T(1) - 5) > 1E-9 OR ABS(E(2) - 5) > 1E-9 THEN LET OK = 0
240 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 END
