1 REM FBCS GFX-0094
2 REM CLAIM E-4102
3 REM TYPE SELF
100 PRINT "GFX-0094 SET TEXT JUSTIFY ILLEGAL VALUE IS NONFATAL 4102 (13.2.5)"
110 SET TEXT JUSTIFY "LEFT", "BASE"
120 WHEN EXCEPTION IN
130   SET TEXT JUSTIFY "X", "BASE"
140   PRINT "*** TEST FAILED: NO EXCEPTION ***"
150 USE
160   IF EXTYPE <> 4102 THEN PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
170 END WHEN
180 WHEN EXCEPTION IN
190   SET TEXT JUSTIFY "LEFT", "MIDDLE"
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE <> 4102 THEN PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 ASK TEXT JUSTIFY H$, V$
250 IF H$ = "LEFT" AND V$ = "BASE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: CHANGED"
260 END
