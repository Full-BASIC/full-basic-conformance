1 REM FBCS GFX-0063
2 REM CLAIM A-13.4.4-06
3 REM TYPE SELF
100 PRINT "GFX-0063 LOCATE VALUE SCALES TO RANGE, REUSES LAST RANGE (13.4.4)"
110 LOCATE VALUE, RANGE -7 TO 7: V
120 LOCATE VALUE: V2
130 LOCATE VALUE, RANGE 0 TO 10: V3
140 IF V >= -7 AND V <= 7 AND ABS(V) < 1E-9 AND V2 >= -7 AND V2 <= 7 AND V3 >= 0 AND V3 <= 10 THEN PRINT "*** TEST PASSED ***" &
&ELSE PRINT "*** TEST FAILED ***"
150 END
