1 REM FBCS GFX-0062
2 REM CLAIM A-13.4.4-05
3 REM TYPE SELF
100 PRINT "GFX-0062 LOCATE CHOICE STORES POSITIVE INT <= MAX, 0 IF NONE (13.4.4)"
110 ASK MAX CHOICE DEVICE M
120 LOCATE CHOICE: B
130 LOCATE CHOICE, AT 2: B2
140 IF B >= 0 AND B <= M AND B2 >= 0 AND B2 <= M THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
150 END
