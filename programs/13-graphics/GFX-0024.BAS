1 REM FBCS GFX-0024
2 REM CLAIM A-13.1.4-08
3 REM TYPE SELF
100 PRINT "GFX-0024 SET DEVICE VIEWPORT RECTANGLE, DEFAULT WHOLE SURFACE (13.1.4)"
110 ASK DEVICE SIZE H, V, U$
120 ASK DEVICE VIEWPORT L, R, B, T
130 LET OK = 1
140 IF L <> 0 OR ABS(R - H) > 1E-9 OR B <> 0 OR ABS(T - V) > 1E-9 THEN LET OK = 0
150 SET DEVICE VIEWPORT 0.1, 0.9, 0.2, 0.8
160 ASK DEVICE VIEWPORT L, R, B, T
170 IF ABS(L - .1) > 1E-9 OR ABS(R - .9) > 1E-9 OR ABS(B - .2) > 1E-9 OR ABS(T - .8) > 1E-9 THEN LET OK = 0
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
