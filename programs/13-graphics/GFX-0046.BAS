1 REM FBCS GFX-0046
2 REM CLAIM A-13.2.4.1-06
3 REM TYPE SELF
100 PRINT "GFX-0046 JUSTIFY STARTS LEFT BASE, ASK TEXT JUSTIFY UPPER CASE (13.2.4.1)"
110 ASK TEXT JUSTIFY H$, V$
120 LET OK = 1
130 IF H$ <> "LEFT" OR V$ <> "BASE" THEN LET OK = 0
140 SET TEXT JUSTIFY "Center", "Half"
150 ASK TEXT JUSTIFY H$, V$
160 IF H$ <> "CENTER" OR V$ <> "HALF" THEN LET OK = 0
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
