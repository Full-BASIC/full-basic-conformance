1 REM FBCS GFX-0014
2 REM CLAIM A-13.1.3-EX
3 REM TYPE SELF
100 PRINT "GFX-0014 ALL EXAMPLES OF 13.1.3 RUN AND ASK BACK WHAT WAS SET (13.1.3)"
110 LET WIDTH = 0.8
120 LET HEIGHT = 0.6
130 LET OK = 1
140 SET WINDOW 0, PI*2, -1, 1
150 ASK WINDOW X1, X2, Y1, Y2
160 IF X1 <> 0 OR ABS(X2 - PI*2) > 1E-9 OR Y1 <> -1 OR Y2 <> 1 THEN LET OK = 0
170 SET VIEWPORT .5*WIDTH, WIDTH, .5*HEIGHT, HEIGHT
180 ASK VIEWPORT L, R, B, T
190 IF ABS(L - .4) > 1E-9 OR ABS(R - .8) > 1E-9 OR ABS(B - .3) > 1E-9 OR ABS(T - .6) > 1E-9 THEN LET OK = 0
200 SET DEVICE WINDOW 0, .8, 0, 1
210 ASK DEVICE WINDOW XMIN, XMAX, YMIN, YMAX
220 IF XMIN <> 0 OR ABS(XMAX - .8) > 1E-9 OR YMIN <> 0 OR YMAX <> 1 THEN LET OK = 0
230 SET DEVICE VIEWPORT .3, .5, .1, 1
240 ASK DEVICE VIEWPORT LEFT, RIGHT, BOTTOM, TOP
250 IF ABS(LEFT - .3) > 1E-9 OR ABS(RIGHT - .5) > 1E-9 OR ABS(BOTTOM - .1) > 1E-9 OR ABS(TOP - 1) > 1E-9 THEN LET OK = 0
260 SET CLIP "Off"
270 ASK CLIP CLIPSTATE$
280 IF CLIPSTATE$ <> "OFF" THEN LET OK = 0
290 ASK DEVICE SIZE W, H, UNITS$
300 IF UNITS$ <> "METERS" AND UNITS$ <> "OTHER" THEN LET OK = 0
310 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
320 END
