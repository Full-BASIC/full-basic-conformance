1 REM FBCS GFX-0106
2 REM CLAIM E-11054
3 REM TYPE SELF
100 PRINT "GFX-0106 DEVICE VIEWPORT OUTSIDE DISPLAY SPACE IS NONFATAL 11054 (13.1.5)"
110 LET OK = 1
120 WHEN EXCEPTION IN
130   SET DEVICE VIEWPORT 0, 2, 0, 1
140 USE
150   IF EXTYPE <> 11054 THEN LET OK = 0
160 END WHEN
170 ASK DEVICE VIEWPORT L, R, B, T
180 IF NOT (L = 0 AND R = 1 AND B = 0 AND T = 1) THEN LET OK = 0
190 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
