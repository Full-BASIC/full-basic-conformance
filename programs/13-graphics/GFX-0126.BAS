1 REM FBCS GFX-0126
2 REM CLAIM D-13.2-8
3 REM TYPE SELF
100 PRINT "GFX-0126 INITIAL MIXES UNSET FOR EVERY INDEX 0..15 (Ap C 13.2)"
110 LET OK = 1
120 FOR I = 0 TO 15
130   ASK COLOR MIX(I) R, G, B STATUS S
140   IF S <> 11087 OR R <> 0 OR G <> 0 OR B <> 0 THEN LET OK = 0
150 NEXT I
160 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END
