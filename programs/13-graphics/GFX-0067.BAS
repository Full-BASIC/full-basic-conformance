1 REM FBCS GFX-0067
2 REM CLAIM A-13.4.4-10
3 REM TYPE SELF
100 PRINT "GFX-0067 ASK PIXEL ARRAY -1 UNDETERMINABLE, PRESENT/ABSENT (13.4.4)"
110 DIM P(2,3)
120 ASK PIXEL ARRAY(0,0) P, S$
130 LET OK = 1
140 IF S$ <> "PRESENT" AND S$ <> "ABSENT" THEN LET OK = 0
150 IF P(1,1) <> -1 OR P(2,3) <> -1 THEN LET OK = 0
160 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END
