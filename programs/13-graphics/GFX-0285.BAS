1 REM FBCS GFX-0285
2 REM CLAIM E-11085-03
3 REM TYPE GRAPHIC
100 PRINT "GFX-0285 HANDLED 11085 DOES NOT APPLY THE DEFAULT RECOVERY (4.1, 13.3.5)"
110 OPTION BASE 1
120 DIM C(2,2)
130 MAT READ C
140 DATA 1,20,3,4
150 LET OK = 0
160 SET LINE COLOR 7
170 WHEN EXCEPTION IN
180   MAT GRAPH CELLS, IN 0,0; 1,1: C
190   LET OK = 9
200 USE
210   IF EXTYPE = 11085 THEN LET OK = 1
220 END WHEN
230 WHEN EXCEPTION IN
240   SET LINE COLOR 999
250   LET OK = 9
260 USE
270   IF EXTYPE = 11085 AND OK = 1 THEN LET OK = 2
280 END WHEN
290 ASK LINE COLOR K
300 IF OK = 2 AND K = 7 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
310 END
