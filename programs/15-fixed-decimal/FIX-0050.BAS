1 REM FBCS FIX-0050
2 REM CLAIM A-15.1.4-08
3 REM TYPE OUTPUT
4 REM A constant of 17 or 18 integer digits (P >= 18) is not an overflow under a smaller default size
5 REM STD 15.1.4 l.12204-12207 (only more than P digits left of the point overflow), l.12227-12235, l.12250-12259
10 OPTION ARITHMETIC FIXED*4.2
20 DECLARE NUMERIC*18.0 X, Y
30 PRINT 12345678901234567
40 PRINT 123456789012345678
50 LET X = 12345678901234567
60 LET Y = -123456789012345678
70 PRINT X
80 PRINT Y
90 LET Z = 5
100 WHEN EXCEPTION IN
110   LET Z = 12345678901234567
120   PRINT "NO OVERFLOW"
130 USE
140   PRINT "OVERFLOW"
150 END WHEN
160 PRINT Z
170 END
