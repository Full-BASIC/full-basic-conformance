1 REM FBCS FIX-0179
2 REM CLAIM A-15.1.4-FI14
3 REM TYPE OUTPUT
4 REM STD 15.1.4 l.12189-12199, l.12261-12266: a constant keeps its own precision in an INTERNAL file
10 OPTION ARITHMETIC FIXED*8.2
20 DECLARE NUMERIC*2.5 B, C
30 OPEN #1: NAME "fix0179.dat", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
40 WRITE #1: 0.12345
50 SET #1: POINTER BEGIN
60 ASK #1: DATUM D$
70 PRINT D$
80 READ #1: B
90 LET C = 0.12345
100 PRINT B; C
110 IF B = C THEN PRINT "same"
120 ERASE #1
130 CLOSE #1
140 END
