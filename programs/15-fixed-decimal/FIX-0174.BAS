1 REM FBCS FIX-0174
2 REM CLAIM A-15.1.4-110
3 REM TYPE SELF
4 REM Constants and variables keep their precision as operands; a value is rounded only when it is assigned
5 REM Intermediate results with P+2 digits are the recommendation of 15.1.6
10 OPTION ARITHMETIC FIXED *8.2
20 DECLARE NUMERIC *10.4 X
30 DIM V(3)
40 LET OK = 1
50 LET A = 0.004*1000
60 IF A <> 4 THEN LET OK = 0
70 IF 1.555 = 1.56 THEN LET OK = 0
80 LET B = 1.555
90 IF B <> 1.56 THEN LET OK = 0
100 LET C = 1/3*3
110 IF C <> 1 THEN LET OK = 0
120 LET X = 1.2345
130 LET Y = X*2
140 IF Y <> 2.47 OR X*2 <> 2.469 THEN LET OK = 0
150 LET V(2) = 0.004*1000
160 IF V(2) <> 4 THEN LET OK = 0
170 READ R
180 DATA 1.555
190 IF R <> 1.56 THEN LET OK = 0
200 LET N = 0
210 FOR I = 0 TO 0.02 STEP 0.005
220   LET N = N+1
230 NEXT I
240 IF N <> 3 THEN LET OK = 0
250 DECLARE NUMERIC *2.2 T
260 LET E = 0
270 WHEN EXCEPTION IN
280   LET T = 50*3
290 USE
300   LET E = EXTYPE
310 END WHEN
320 IF E <> 1011 THEN LET OK = 0
330 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
340 END
