1 REM FBCS FIX-0031
2 REM CLAIM A-15.2.3-EX
3 REM TYPE OUTPUT
10 OPTION ARITHMETIC FIXED *8.2
20 DIM A(3)
30 DECLARE NUMERIC B(2,2)*4.4
40 DEF AVERAGE*10.3 (X*10.3, Y*10.3) = (X+Y)/2
50 DIM V(3)
60 MAT A = CON
70 MAT B = CON
80 LET V(1) = 1
90 LET V(2) = 2
100 LET V(3) = 3
110 DECLARE FUNCTION SUMVECTOR*5.2
120 DECLARE EXTERNAL SUB P
130 DECLARE EXTERNAL FUNCTION ANSWER*1
140 CALL P(A, B)
150 PRINT SUMVECTOR(V)
160 PRINT ANSWER("YES")
170 PRINT AVERAGE(1.234, 2.345)
180 FUNCTION SUMVECTOR*5.2 (V()*5.2)
190 LET S = 0
200 FOR I = 1 TO 3
210 LET S = S + V(I)
220 NEXT I
230 LET SUMVECTOR = S
240 END FUNCTION
250 END
260 EXTERNAL SUB P(A()*8.2, B(,)*4.4)
270 OPTION ARITHMETIC FIXED *8.2
280 PRINT A(1); B(1,1)
290 END SUB
300 EXTERNAL FUNCTION ANSWER*1 (A$)
310 OPTION ARITHMETIC FIXED *8.2
320 IF A$ = "YES" THEN LET ANSWER = 1 ELSE LET ANSWER = 0
330 END FUNCTION
