1 REM FBCS FIX-0151
2 REM CLAIM A-15.1.4-109
3 REM TYPE SELF
4 REM A wide FIXED variable in a comparison or expression does not give 1011; expression overflow is 1002
5 REM STD 15.1.4 l.12204-12233 (result precision implementation-defined, l.12230-12234), 5.3.5 l.1843, 15.1.5 l.12296
10 OPTION ARITHMETIC FIXED*4.2
20 DECLARE NUMERIC*18.0 X, Y, Z, V, U
30 LET X = 123456789012345678
40 IF X > 1 THEN
50   LET A$ = "MAYOR"
60 END IF
70 LET Y = 12345678901234567
80 LET Z = Y + 1
90 LET V = ABS(Y)
100 LET U = Y - 1
110 IF A$ <> "MAYOR" THEN PRINT "*** TEST FAILED: COMPARISON ***"
120 IF Z <> 12345678901234568 THEN PRINT "*** TEST FAILED: SUM ***"
130 IF V <> 12345678901234567 THEN PRINT "*** TEST FAILED: ABS ***"
140 IF U <> 12345678901234566 THEN PRINT "*** TEST FAILED: DIFFERENCE ***"
150 LET Z = 12345678901234567 + 1
160 IF Z <> 12345678901234568 THEN PRINT "*** TEST FAILED: CONSTANT SUM ***"
170 LET OK$ = ""
180 WHEN EXCEPTION IN
190   LET Z = X * 10
200 USE
210   IF EXTYPE = 1002 THEN LET OK$ = "1002"
220 END WHEN
230 IF OK$ <> "1002" THEN PRINT "*** TEST FAILED: EXPRESSION OVERFLOW IS 1002 ***"
240 LET OK$ = ""
250 WHEN EXCEPTION IN
260   LET Q = Y + 1
270 USE
280   IF EXTYPE = 1011 THEN LET OK$ = "1011"
290 END WHEN
300 IF OK$ <> "1011" THEN PRINT "*** TEST FAILED: ASSIGNMENT OVERFLOW IS 1011 ***"
310 PRINT "*** TEST PASSED ***"
320 END
