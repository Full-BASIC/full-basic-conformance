1 REM FBCS CTL-0034
2 REM CLAIM A-8.3.4-01
3 REM TYPE SELF
100 REM WHILE demands exit when false, UNTIL when true (l.3827)
110 LET C = 0
120 DO WHILE C < 3
130   LET C = C + 1
140 LOOP
150 LET D = 0
160 DO
170   LET D = D + 1
180 LOOP UNTIL D = 3
190 IF C = 3 AND D = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
