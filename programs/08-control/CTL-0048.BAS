1 REM FBCS CTL-0048
2 REM CLAIM A-8.4.2-03
3 REM TYPE SELF
100 REM transfer to the if-then-line or select-line of a block is allowed (l.3955)
110 LET T1 = 0
120 LET T2 = 0
130 LET X = 1
140 GOTO 200
150 PRINT "*** TEST FAILED: FALL1 ***"
160 GOTO 400
200 IF X = 1 THEN
210   LET T1 = 1
220 END IF
230 GOTO 300
240 PRINT "*** TEST FAILED: FALL2 ***"
250 GOTO 400
300 SELECT CASE X
310 CASE 1
320   LET T2 = 1
330 CASE ELSE
340   PRINT "*** TEST FAILED: CASEELSE ***"
350 END SELECT
400 IF T1 = 1 AND T2 = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
410 END
