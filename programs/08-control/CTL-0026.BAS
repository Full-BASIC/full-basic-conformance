1 REM FBCS CTL-0026
2 REM CLAIM E-10002
3 REM TYPE SELF
100 REM return without a gosub in the same internal procedure -> 10002 (l.3714, l.3735)
105 REM 10002 raised in internal-proc-def S propagates to MAIN's handler with EXTYPE = 100000 + 10002 (12.1.4 l.8905-8907)
109 DECLARE SUB S
110 WHEN EXCEPTION IN
120   CALL S
130   PRINT "*** TEST FAILED: NOEXC ***"
140 USE
150   IF EXTYPE = 110002 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
160 END WHEN
170 GOTO 900
800 SUB S
810 RETURN
820 END SUB
900 END
