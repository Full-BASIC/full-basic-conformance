1 REM FBCS CTL-0032
2 REM CLAIM A-8.3.3-EX
3 REM TYPE INPUT
100 REM Loop example 8.3.3: DO / INPUT X / IF ... EXIT DO / LOOP (l.3809-3813)
110 LET N = 0
120 DO
130   INPUT X
140   LET N = N + 1
150   IF 0 < X AND X <= 7 AND X = INT(X) THEN EXIT DO
160   PRINT "INPUT AN INTEGER BETWEEN 1 AND 7"
170 LOOP
180 IF N = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; N
190 END
