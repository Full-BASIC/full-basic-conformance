1 REM FBCS CTL-0040
2 REM CLAIM A-8.3.4-07
3 REM TYPE SELF
100 REM EXIT DO resumes after the LOOP of the smallest containing do-loop (l.3877)
110 LET OUTER = 0
120 LET INNER = 0
130 DO
140   LET OUTER = OUTER + 1
150   LET INNER = 0
160   DO
170     LET INNER = INNER + 1
180     IF INNER = 2 THEN EXIT DO
190   LOOP
200   IF OUTER = 2 THEN EXIT DO
210 LOOP
220 IF OUTER = 2 AND INNER = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; OUTER; INNER
230 END
