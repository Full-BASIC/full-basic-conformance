1 REM FBCS CTL-0035
2 REM CLAIM A-8.3.4-02
3 REM TYPE SELF
100 REM exit-condition at do-line and loop-line (l.3833-3843)
110 LET A = 0
120 LET B = 0
130 LET C = 0
140 LET D = 0
150 LET E = 0
160 DO WHILE 1 = 2
170   LET A = 1
180 LOOP
190 DO UNTIL 1 = 1
200   LET B = 1
210 LOOP
220 DO
230   LET C = C + 1
240 LOOP WHILE C < 3
250 DO
260   LET D = D + 1
270 LOOP UNTIL D >= 3
280 DO
290   LET E = E + 1
300   IF E = 2 THEN EXIT DO
310 LOOP
320 IF A = 0 AND B = 0 AND C = 3 AND D = 3 AND E = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
330 END
