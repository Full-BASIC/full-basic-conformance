1 REM FBCS CTL-0024
2 REM CLAIM E-10001
3 REM TYPE SELF
100 REM on-goto/on-gosub without ELSE, index out of range -> 10001 (l.3729, l.13003)
110 LET R1 = 0
120 LET R2 = 0
130 LET R3 = 0
140 WHEN EXCEPTION IN
150   ON 0 GOTO 900, 910
160   PRINT "*** TEST FAILED: NOEXC1 ***"
170 USE
180   IF EXTYPE = 10001 THEN LET R1 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE1 ***"; EXTYPE
190 END WHEN
200 WHEN EXCEPTION IN
210   ON 5 GOTO 900, 910
220   PRINT "*** TEST FAILED: NOEXC2 ***"
230 USE
240   IF EXTYPE = 10001 THEN LET R2 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE2 ***"; EXTYPE
250 END WHEN
260 WHEN EXCEPTION IN
270   ON 0 GOSUB 900, 910
280   PRINT "*** TEST FAILED: NOEXC3 ***"
290 USE
300   IF EXTYPE = 10001 THEN LET R3 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE3 ***"; EXTYPE
310 END WHEN
320 IF R1 = 1 AND R2 = 1 AND R3 = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
330 GOTO 950
900 PRINT "T900"
910 PRINT "T910"
950 END
