1 REM FBCS CTL-0007
2 REM CLAIM A-8.1.3-EX
3 REM TYPE SELF
100 REM Examples of 8.1.3 evaluated with concrete values (l.3521-3530)
110 DIM AR(1 TO 10), BR(1 TO 10)
120 LET K = 1
130 DO WHILE K <= 10
140   LET AR(K) = K * 2
150   LET BR(K) = K * 3
160   LET K = K + 1
170 LOOP
180 LET OK = 1
190 REM ex1: NOT X < Y OR A$ = B$ AND B$ = C$  (NOT binds to X < Y only)
200 LET X = 3
210 LET Y = 2
220 LET A$ = "P"
230 LET B$ = "Q"
240 LET C$ = "Q"
250 IF NOT (NOT X < Y OR A$ = B$ AND B$ = C$) THEN LET OK = 0
260 LET X = 1
270 LET Y = 2
280 LET A$ = "A"
290 LET B$ = "A"
300 LET C$ = "A"
310 IF NOT (NOT X < Y OR A$ = B$ AND B$ = C$) THEN LET OK = 0
320 LET B$ = "B"
330 IF NOT X < Y OR A$ = B$ AND B$ = C$ THEN LET OK = 0
340 REM ex2: A <= X AND X <= B
350 LET LO = 1
360 LET HI = 10
370 LET X = 5
380 IF NOT (LO <= X AND X <= HI) THEN LET OK = 0
390 LET X = 0
400 IF LO <= X AND X <= HI THEN LET OK = 0
410 LET X = 11
420 IF LO <= X AND X <= HI THEN LET OK = 0
430 REM ex3: 1 <= I AND I <= 10 AND AR(I) = X
440 LET I = 5
450 LET X = 10
460 IF NOT (1 <= I AND I <= 10 AND AR(I) = X) THEN LET OK = 0
470 LET X = 11
480 IF 1 <= I AND I <= 10 AND AR(I) = X THEN LET OK = 0
490 LET I = 11
500 IF 1 <= I AND I <= 10 AND AR(I) = X THEN LET OK = 0
510 REM ex4: I < N AND (J > M OR AR(I) < BR(J))
520 LET I = 3
530 LET N = 5
540 LET J = 4
550 LET M = 2
560 IF NOT (I < N AND (J > M OR AR(I) < BR(J))) THEN LET OK = 0
570 LET J = 1
580 IF I < N AND (J > M OR AR(I) < BR(J)) THEN LET OK = 0
590 LET I = 6
600 IF I < N AND (J > M OR AR(I) < BR(J)) THEN LET OK = 0
610 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
620 END
