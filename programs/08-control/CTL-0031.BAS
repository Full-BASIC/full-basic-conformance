1 REM FBCS CTL-0031
2 REM CLAIM A-8.3.3-EX
3 REM TYPE INPUT
100 REM Loop example 8.3.3: DO / INPUT A$(I) / LOOP UNTIL A$(I) = "NO" (l.3803-3807)
110 DIM A$(1 TO 5)
120 LET I = 2
130 DO
140   PRINT "MORE ENTRIES (ENTER 'NO' IF NONE)"
150   INPUT A$(I)
160   LET I = I + 1
170 LOOP UNTIL A$(I - 1) = "NO"
180 IF A$(2) = "ABC" AND A$(3) = "NO" AND I = 4 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
