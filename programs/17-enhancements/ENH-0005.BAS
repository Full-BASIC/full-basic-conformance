1 REM FBCS ENH-0005
2 REM CLAIM A-ENH-5
3 REM TYPE SELF
100 OPEN #1: NAME "ENH0005.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
110 WRITE #1, RECORD 1: 42
120 REPLACE #1, RECORD 1: 99
130 READ #1, RECORD 1: X
140 DIM A(2), B(2), C(2)
150 LET A(1) = 1
160 LET A(2) = 2
170 MAT WRITE #1, RECORD 2: A
180 LET B(1) = 7
190 LET B(2) = 8
200 MAT REPLACE #1, RECORD 2: B
210 MAT READ #1, RECORD 2: C
220 CLOSE #1
230 IF X = 99 AND C(1) = 7 AND C(2) = 8 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: X="; X; " C1="; C(1); &
&" C2="; C(2)
240 END
