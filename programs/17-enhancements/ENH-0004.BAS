1 REM FBCS ENH-0004
2 REM CLAIM A-ENH-4
3 REM TYPE SELF
100 OPEN #1: NAME "ENH0004A.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
110 WRITE #1, RECORD 1: "UNO"
120 WRITE #1, RECORD 2: "DOS"
130 WRITE #1, RECORD 3: "TRES"
140 SET #1: POINTER RECORD 2
150 READ #1: A$
160 SET #1: POINTER RECORD 3
170 READ #1: B$
180 CLOSE #1
190 OPEN #2: NAME "ENH0004B.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
200 WRITE #2, KEY "a": "ALFA"
210 WRITE #2, KEY "b": "BETA"
220 SET #2: POINTER KEY "b"
230 READ #2: C$
240 CLOSE #2
250 IF A$ = "DOS" AND B$ = "TRES" AND C$ = "BETA" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$; &
&"/"; C$
260 END
