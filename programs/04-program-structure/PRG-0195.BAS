1 REM FBCS PRG-0195
2 REM CLAIM A-4.2.2-TR157
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1317-1320 and 11.3.2 l.7457-7458: the main and a unit repeat the line of a TEMPLATE, each WITH n uses its own.
10 DECLARE EXTERNAL SUB E
20 OPEN #1: NAME "PRG0195M.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 TEMPLATE: NUMERIC*8
40 WRITE #1, WITH 30: 7
50 SET #1: POINTER BEGIN
60 READ #1, WITH 30: X
70 PRINT X
80 CALL E
90 END
6 EXTERNAL SUB E
20 OPEN #1: NAME "PRG0195E.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 TEMPLATE: STRING*4
40 WRITE #1, WITH 30: "ABCD"
50 SET #1: POINTER BEGIN
60 READ #1, WITH 30: S$
70 PRINT S$
90 END SUB
