1 REM FBCS PRG-0196
2 REM CLAIM A-4.2.2-TR157
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1317-1320 and 11.3.2 l.7457-7458: three units with the TEMPLATE written after the WITH n that uses it.
10 DECLARE EXTERNAL SUB E, F, G
20 CALL E
30 CALL F
40 CALL G
50 END
6 EXTERNAL SUB E
20 OPEN #1: NAME "PRG0196E.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 WRITE #1, WITH 60: "x"
40 SET #1: POINTER BEGIN
50 READ #1, WITH 60: S$
55 PRINT S$; LEN(S$)
57 EXIT SUB
60 TEMPLATE: STRING*1
90 END SUB
7 EXTERNAL SUB F
20 OPEN #1: NAME "PRG0196F.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 WRITE #1, WITH 60: "xyz"
40 SET #1: POINTER BEGIN
50 READ #1, WITH 60: S$
55 PRINT S$; LEN(S$)
57 EXIT SUB
60 TEMPLATE: STRING*3
90 END SUB
8 EXTERNAL SUB G
20 OPEN #1: NAME "PRG0196G.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 WRITE #1, WITH 60: "pq"
40 SET #1: POINTER BEGIN
50 READ #1, WITH 60: S$
55 PRINT S$; LEN(S$)
57 EXIT SUB
60 TEMPLATE: STRING*2
90 END SUB
