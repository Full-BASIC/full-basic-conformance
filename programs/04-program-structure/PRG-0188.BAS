1 REM FBCS PRG-0188
2 REM CLAIM A-4.2.2-TR156
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1312-1320: WHEN EXCEPTION handlers and RETRY resolve the repeated lines of their own unit.
10 DECLARE EXTERNAL SUB E
20 WHEN EXCEPTION USE H
30   CAUSE EXCEPTION 1
40   PRINT "NO"
50 END WHEN
55 CALL E
60 PRINT "M60"
70 STOP
80 HANDLER H
90   PRINT "MH"
99 END HANDLER
100 END
6 EXTERNAL SUB E
10 LET C = 0
20 WHEN EXCEPTION IN
30   CAUSE EXCEPTION 1
40   PRINT "NO"
50 USE
60   LET C = C + 1
70   IF C < 3 THEN RETRY
80   PRINT "E80"
90 END WHEN
100 PRINT "E100"
190 END SUB
