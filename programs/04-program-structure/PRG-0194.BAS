1 REM FBCS PRG-0194
2 REM CLAIM A-4.2.2-TR157
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1317-1320 and 11.3.2 l.7457-7458: WITH n takes the TEMPLATE of its own unit (two units, the main has none).
10 DECLARE EXTERNAL SUB E, F
20 CALL E
30 CALL F
40 END
6 EXTERNAL SUB E
20 OPEN #1: NAME "PRG0194E.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 TEMPLATE: STRING*2
40 WRITE #1, WITH 30: "AB"
50 SET #1: POINTER BEGIN
60 READ #1, WITH 30: S$
70 PRINT S$; LEN(S$)
90 END SUB
7 EXTERNAL SUB F
20 OPEN #1: NAME "PRG0194F.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
30 TEMPLATE: STRING*5
40 WRITE #1, WITH 30: "ABCDE"
50 SET #1: POINTER BEGIN
60 READ #1, WITH 30: S$
70 PRINT S$; LEN(S$)
90 END SUB
