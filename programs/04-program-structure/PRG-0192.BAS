1 REM FBCS PRG-0192
2 REM CLAIM A-4.2.2-TR157
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1317-1320 and 10.1.4 l.4990-5052: RESTORE n written before the DATA of its own unit (use before definition).
10 DECLARE EXTERNAL SUB E, F
20 RESTORE 70
30 READ A
40 CALL E
50 CALL F
55 PRINT "M"; A
60 GOTO 80
70 DATA 1, 2
80 END
6 EXTERNAL SUB E
20 RESTORE 70
30 READ A, B
40 PRINT "E"; A; B
50 EXIT SUB
70 DATA 10, 20
90 END SUB
7 EXTERNAL SUB F
20 RESTORE 70
30 READ A
40 PRINT "F"; A
50 EXIT SUB
70 DATA 100, 200
90 END SUB
