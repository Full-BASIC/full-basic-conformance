1 REM FBCS PRG-0185
2 REM CLAIM A-4.2.2-TR156
3 REM TYPE OUTPUT
4 REM 4.2.2 l.1312-1320: ON GOTO and ON GOSUB reach the repeated numbers of their own unit.
10 DECLARE EXTERNAL SUB E
20 LET K = 2
30 ON K GOTO 40, 50
40 PRINT "NO"
50 PRINT "M50"
52 ON K GOSUB 56, 60
54 CALL E
55 STOP
56 PRINT "M56"
58 RETURN
60 PRINT "M60"
62 RETURN
70 END
6 EXTERNAL SUB E
20 LET K = 2
30 ON K GOTO 40, 50
40 PRINT "NO"
50 PRINT "E50"
52 ON K GOSUB 56, 60
54 EXIT SUB
56 PRINT "E56"
58 RETURN
60 PRINT "E60"
62 RETURN
190 END SUB
