1 REM FBCS PRT-0408
2 REM CLAIM A-10.3.5-CL40
3 REM TYPE SELF
5 REM 4.1 l.1360-1368 + 10.3.5 l.5532: a TAB index below one handled by a user handler ends the statement.
100 PRINT "PRT-0408 HANDLED 4005 TRANSFERS CONTROL TO THE HANDLER (4.1, 10.3.5)"
110 LET OK = 0
120 WHEN EXCEPTION IN
130   PRINT "A"; TAB(0); "B"
140   LET OK = 9
150 USE
160   IF EXTYPE = 4005 THEN LET OK = 1
170 END WHEN
180 LET N = 0
190 LET R = 0
200 WHEN EXCEPTION IN
210   PRINT "C"; TAB(N); "D"
220   LET R = R + 1
230 USE
240   IF EXTYPE = 4005 THEN LET N = 3
250   RETRY
260 END WHEN
270 PRINT
280 IF OK = 1 AND R = 1 AND N = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
290 END
