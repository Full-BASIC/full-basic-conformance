1 REM FBCS PRT-0171
2 REM CLAIM E-1054
3 REM TYPE INPUT
100 REM INPUT AND LINE INPUT INTO A SUBSTRING THAT OVERFLOWS RAISE 1054, NOT 1106 (10.2.5 l.5259-5261)
110 DECLARE STRING A$ * 3
120 LET A$ = "ABC"
130 LET OK = 0
140 WHEN EXCEPTION IN
150   INPUT A$(2:1)
160 USE
170   IF EXTYPE = 1054 AND A$ = "ABC" THEN LET OK = OK + 1
180 END WHEN
190 WHEN EXCEPTION IN
200   LINE INPUT A$(2:1)
210 USE
220   IF EXTYPE = 1054 AND A$ = "ABC" THEN LET OK = OK + 1
230 END WHEN
240 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 END
