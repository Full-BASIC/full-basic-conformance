1 REM FBCS PRT-0010
2 REM CLAIM A-10.1.3-EX
3 REM TYPE SELF
100 REM EXAMPLES OF 10.1.3 (l.4981-4995)
110 DIM X(3)
120 DATA 3.14159, "PI", 5E-30, ","
125 DATA 7, "END"
130 DATA COMMAS CANNOT OCCUR IN UNQUOTED STRINGS
140 READ X(1), S1$, X(2), S2$
150 READ IF MISSING THEN 300: A$, B$
160 RESTORE
170 RESTORE 120
180 READ X(3), S3$
190 IF X(1) = 3.14159 AND S1$ = "PI" AND X(2) = 5E-30 AND S2$ = "," THEN 200 ELSE 400
200 IF A$ = "7" AND B$ = "END" THEN 210 ELSE 400
210 IF X(3) = 3.14159 AND S3$ = "PI" THEN 220 ELSE 400
220 PRINT "*** TEST PASSED ***"
230 GOTO 410
300 PRINT "*** TEST FAILED: MISSING"
310 GOTO 410
400 PRINT "*** TEST FAILED ***"
410 END
