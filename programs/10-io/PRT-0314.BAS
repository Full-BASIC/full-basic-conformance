1 REM FBCS PRT-0314
2 REM CLAIM A-12.1.4-TR128
3 REM TYPE OUTPUT
4 REM STD 12.1.4 l.8805-8807, 10.1.4 l.5043-5052: RESTORE n in the handler of an EXTERNAL unit names a DATA line of that unit.
100 DECLARE EXTERNAL SUB E
110 DECLARE EXTERNAL FUNCTION F
120 CALL E
130 CALL E
140 PRINT F
150 END
200 EXTERNAL SUB E
210   READ A
220   WHEN EXCEPTION USE H
230     CAUSE EXCEPTION 1
240   END WHEN
250   READ B
260   PRINT A; B
270   HANDLER H
280     RESTORE 290
285   END HANDLER
290   DATA 3
300 END SUB
400 EXTERNAL FUNCTION F
410   READ A
420   WHEN EXCEPTION USE H
430     CAUSE EXCEPTION 1
440   END WHEN
450   READ B
460   LET F = A * 10 + B
470   HANDLER H
480     RESTORE 490
485   END HANDLER
490   DATA 4
500 END FUNCTION
