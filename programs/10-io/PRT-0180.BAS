1 REM FBCS PRT-0180
2 REM CLAIM E-1054
3 REM TYPE INPUT
100 REM INPUT AND LINE INPUT INTO A BY-REFERENCE STRING PARAMETER THAT OVERFLOWS RAISE 1054, NOT 1106 (10.2.5 l.5259-5261)
109 DECLARE SUB S1, S2, S3, S4
110 DECLARE STRING A$ * 2
120 DECLARE STRING C$(3) * 2
130 LET A$ = "Z"
140 LET C$(1) = "Y"
150 LET OK = 0
160 CALL S1(A$)
170 CALL S2(A$)
180 CALL S3(C$)
190 REM NONFATAL: WITHOUT A HANDLER THE REPLY IS REQUESTED AGAIN AND THE SECOND ONE IS ASSIGNED
200 CALL S4(A$)
210 IF OK = 3 AND A$ = "ok" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 STOP
300 SUB S1(B$)
310 WHEN EXCEPTION IN
320   INPUT B$
330 USE
340   IF EXTYPE = 1054 AND B$ = "Z" THEN LET OK = OK + 1
350 END WHEN
360 END SUB
400 SUB S2(B$)
410 WHEN EXCEPTION IN
420   LINE INPUT B$
430 USE
440   IF EXTYPE = 1054 AND B$ = "Z" THEN LET OK = OK + 1
450 END WHEN
460 END SUB
500 SUB S3(Q$())
510 WHEN EXCEPTION IN
520   INPUT Q$(1)
530 USE
540   IF EXTYPE = 1054 AND Q$(1) = "Y" THEN LET OK = OK + 1
550 END WHEN
560 END SUB
600 SUB S4(B$)
610 INPUT B$
620 END SUB
630 END
