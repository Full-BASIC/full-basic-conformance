1 REM FBCS PRT-0251
2 REM CLAIM E-8002
3 REM TYPE WARN
4 REM EXPECT 8002 110
100 REM MAT INPUT: TOO FEW DATA IN A REPLY WITHOUT FINAL COMMA: 8002 AND THE REPLY IS RESUPPLIED (10.5.5 L.6117)
105 DIM A(3)
110 MAT INPUT A
120 IF A(1) = 4 AND A(2) = 5 AND A(3) = 6 THEN PRINT "REPLY RESUPPLIED" ELSE PRINT SQR(-1)
130 END
