1 REM FBCS PRT-0015
2 REM CLAIM A-10.1.4-03
3 REM TYPE SELF
100 REM IF MISSING EXIT FOR MUST HAVE ITS NORMAL EFFECT (l.5021-5024)
110 DIM A(5)
120 DATA 7, 8
130 LET I = 0
140 FOR J = 1 TO 5
150   READ IF MISSING THEN EXIT FOR: X
160   LET I = I + 1
170   LET A(I) = X
180 NEXT J
190 IF I = 2 AND A(1) = 7 AND A(2) = 8 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
