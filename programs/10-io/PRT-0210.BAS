1 REM FBCS PRT-0210
2 REM CLAIM E-1006
3 REM TYPE SELF
100 REM AN OVERFLOW EVALUATING A NUMERIC DATUM IN MAT READ IS 1006, AS IN READ (10.5.5 L.6106-6107)
105 REM NOT THE 1002 OF NUMERIC-EXPRESSION OVERFLOW; THE FIRST DATUM IS FINE, THE SECOND OVERFLOWS
110 DIM A(2), B(2,2)
120 LET OK = 0
130 WHEN EXCEPTION IN
140   MAT READ A
150   PRINT "*** TEST FAILED: NO EXCEPTION ***"
160 USE
170   IF EXTYPE = 1006 THEN LET OK = OK + 1
180 END WHEN
190 RESTORE
200 WHEN EXCEPTION IN
210   MAT READ B
220   PRINT "*** TEST FAILED: NO EXCEPTION 2D ***"
230 USE
240   IF EXTYPE = 1006 THEN LET OK = OK + 1
250 END WHEN
260 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK ="; OK
270 DATA 1, 1E+400, 3, 4
280 END
