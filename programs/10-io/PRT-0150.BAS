1 REM FBCS PRT-0150
2 REM CLAIM A-10.5.4.1-06
3 REM TYPE SELF
100 REM MAT READ REPORTS NONFATAL 1506 FOR AN UNDERFLOWING DATA DATUM (l.5962-5963, l.5071-5072)
105 REM A USER HANDLER HANDLES IT, SO THE DEFAULT RECOVERY IS NOT APPLIED (4.1 L.1360-1368): THE ELEMENTS BEFORE
106 REM THE ONE THAT FAILS ARE ASSIGNED (10.1.4 L.5008-5015), THAT ONE AND THE FOLLOWING ONES KEEP THEIR VALUE
110 DIM A(3)
115 LET A(1) = 9
116 LET A(2) = 9
117 LET A(3) = 9
120 DATA 1, 1E-400, 3
130 WHEN EXCEPTION IN
140   MAT READ A
150 USE
160 IF EXTYPE = 1506 AND A(1) = 1 AND A(2) = 9 AND A(3) = 9 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END WHEN
180 END
