1 REM FBCS PRT-0190
2 REM CLAIM E-1054
3 REM TYPE INPUT
100 REM INPUT, LINE INPUT, MAT INPUT AND MAT LINE INPUT INTO A STRING-ARRAY WITH A LENGTH-MAX RAISE 1054
102 REM AND NOT 1106 (10.2.5 L.5259-5261)
105 REM WITHOUT A HANDLER THE REPLY IS REQUESTED AGAIN AND THE SECOND ONE IS ASSIGNED
110 DECLARE STRING A$(3) * 2
120 DECLARE STRING B$(2,2) * 2
130 DECLARE STRING C$(2,2,2) * 2
140 DECLARE STRING D$(3) * 2
150 DECLARE STRING E$(3) * 2
160 LET A$(2) = "Z"
170 LET B$(2,1) = "Y"
180 LET C$(2,1,2) = "X"
190 LET OK = 0
200 WHEN EXCEPTION IN
210   INPUT A$(2)
220 USE
230   IF EXTYPE = 1054 AND A$(2) = "Z" THEN LET OK = OK + 1
240 END WHEN
250 WHEN EXCEPTION IN
260   INPUT B$(2,1)
270 USE
280   IF EXTYPE = 1054 AND B$(2,1) = "Y" THEN LET OK = OK + 1
290 END WHEN
300 WHEN EXCEPTION IN
310   INPUT C$(2,1,2)
320 USE
330   IF EXTYPE = 1054 AND C$(2,1,2) = "X" THEN LET OK = OK + 1
340 END WHEN
350 WHEN EXCEPTION IN
360   LINE INPUT A$(2)
370 USE
380   IF EXTYPE = 1054 AND A$(2) = "Z" THEN LET OK = OK + 1
390 END WHEN
400 WHEN EXCEPTION IN
410   LINE INPUT C$(2,1,2)
420 USE
430   IF EXTYPE = 1054 AND C$(2,1,2) = "X" THEN LET OK = OK + 1
440 END WHEN
450 WHEN EXCEPTION IN
460   MAT INPUT D$
470 USE
480   IF EXTYPE = 1054 THEN LET OK = OK + 1
490 END WHEN
550 INPUT A$(1)
552 WHEN EXCEPTION IN
554   MAT LINE INPUT E$
556 USE
558   IF EXTYPE = 1054 THEN LET OK = OK + 1
559 END WHEN
560 IF OK = 7 AND A$(1) = "ok" AND LEN(D$(1)) <= 2 AND LEN(E$(1)) <= 2 THEN
562   PRINT "*** TEST PASSED ***"
564 ELSE
566   PRINT "*** TEST FAILED ***"
568 END IF
570 END

