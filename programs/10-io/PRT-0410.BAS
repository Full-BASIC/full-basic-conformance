1 REM FBCS PRT-0410
2 REM CLAIM A-10.1.6-CL40
3 REM TYPE SELF
100 REM A USER HANDLER THAT HANDLES 1506 RAISED BY READ ENDS THE STATEMENT: THE VARIABLE KEEPS ITS VALUE
105 REM (4.1 L.1360-1368, 10.1.6 L.5071-5072)
110 DATA 1E-400
120 LET X = 5
130 WHEN EXCEPTION IN
140   READ X
150 USE
160   LET H = EXTYPE
170 END WHEN
180 IF H = 1506 AND X = 5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; H; X
190 END
