1 REM FBCS PRT-0412
2 REM CLAIM A-10.3.5-EXC
3 REM TYPE SELF
4 REM 10.3.5 l.5536: SET MARGIN below the current zone width raises 4006, also on channel zero (SET #0).
100 LET E = 0
110 WHEN EXCEPTION IN
120   SET #0: MARGIN 0
130 USE
140   LET E = EXTYPE
150 END WHEN
160 IF E = 4006 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END
