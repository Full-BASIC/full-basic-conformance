1 REM FBCS PRT-0220
2 REM CLAIM A-10.5.4.2-09
3 REM TYPE INPUT
100 REM 1054 IN MAT INPUT, HANDLED BY A WHEN BLOCK: THE ELEMENTS ASSIGNED BEFORE THE ERROR STAY ASSIGNED
102 REM (10.2.4.2 L.5180-5184 VIA 10.5.4.2 L.5980, 10.5.5 L.6130-6132). CASES: 1-D, 2-D, 3-D,
104 REM TWO ARRAYS (THE FAILING ONE IS THE SECOND, THEN THE FIRST) AND A VARIABLE-LENGTH VECTOR V(?);
106 REM ELEMENTS AFTER THE FAILING ONE KEEP THEIR OLD VALUE
110 DECLARE STRING D$(3)*2, E$(2,2)*2, F$(2,2,2)*2, A$(2)*2, B$(2)*2, V$(4)*2
120 MAT D$ = NUL$
130 MAT E$ = NUL$
140 MAT F$ = NUL$
150 MAT A$ = NUL$
160 MAT B$ = NUL$
170 MAT V$ = NUL$
180 LET BAD = 0
190 LET CASE = 1
200 WHEN EXCEPTION IN
210   MAT INPUT D$
220 USE
230   IF NOT (EXTYPE = 1054 AND D$(1) = "d" AND D$(2) = "" AND D$(3) = "") THEN
240     LET BAD = BAD + 1
250     PRINT "FAILED CASE"; CASE
260   END IF
270 END WHEN
280 LET CASE = 2
290 WHEN EXCEPTION IN
300   MAT INPUT E$
310 USE
320   IF NOT (EXTYPE = 1054 AND E$(1,1) = "ab" AND E$(1,2) = "cd" AND E$(2,1) = "" AND E$(2,2) = "") THEN
330     LET BAD = BAD + 1
340     PRINT "FAILED CASE"; CASE
350   END IF
360 END WHEN
370 LET CASE = 3
380 WHEN EXCEPTION IN
390   MAT INPUT F$
400 USE
410   IF NOT (EXTYPE = 1054 AND F$(1,1,1) = "ab" AND F$(1,1,2) = "cd" AND F$(1,2,1) = "ef") THEN
420     LET BAD = BAD + 1
430     PRINT "FAILED CASE"; CASE
440   END IF
445   IF F$(1,2,2) <> "" OR F$(2,2,2) <> "" THEN
446     LET BAD = BAD + 1
447   END IF
450 END WHEN
460 LET CASE = 4
470 WHEN EXCEPTION IN
480   MAT INPUT A$, B$
490 USE
500   IF NOT (EXTYPE = 1054 AND A$(1) = "ab" AND A$(2) = "cd" AND B$(1) = "ef" AND B$(2) = "") THEN
510     LET BAD = BAD + 1
520     PRINT "FAILED CASE"; CASE
530   END IF
540 END WHEN
545 MAT A$ = NUL$
547 MAT B$ = NUL$
550 LET CASE = 5
560 WHEN EXCEPTION IN
570   MAT INPUT A$, B$
580 USE
590   IF NOT (EXTYPE = 1054 AND A$(1) = "ab" AND A$(2) = "" AND B$(1) = "" AND B$(2) = "") THEN
600     LET BAD = BAD + 1
610     PRINT "FAILED CASE"; CASE
620   END IF
630 END WHEN
640 LET CASE = 6
650 WHEN EXCEPTION IN
660   MAT INPUT V$(?)
670 USE
680   IF NOT (EXTYPE = 1054 AND V$(1) = "ab" AND V$(2) = "" AND V$(3) = "") THEN
690     LET BAD = BAD + 1
700     PRINT "FAILED CASE"; CASE
710   END IF
720 END WHEN
730 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
740 END
