1 REM FBCS PRT-0304
2 REM CLAIM A-11.3.4.6-TR96
3 REM TYPE OUTPUT
100 REM PRINT #0 IS PRINT WITHOUT A CHANNEL, SO THE TAB-CALL ACTS ON THE CONSOLE LINE (11.3.4.6 L.7643-7648, 10.3.4.3)
110 PRINT #0: TAB(3); "X"
120 PRINT #0: "AB"; TAB(6); "C"
130 PRINT #0: "ABCDE"; TAB(2); "D"
140 PRINT TAB(3); "X"
150 PRINT "AB"; TAB(6); "C"
160 PRINT "ABCDE"; TAB(2); "D"
170 END
