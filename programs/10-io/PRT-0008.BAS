1 REM FBCS PRT-0008
2 REM CLAIM A-10.4.2-03
3 REM TYPE SELF
100 PRINT "PRT-0008 IMAGE LINE AFTER ITS PRINT USING IN EXTERNAL SUBPROGRAMS (10.4.2, 10.4.3)"
110 DECLARE EXTERNAL SUB S
120 DECLARE EXTERNAL FUNCTION F
130 CALL S
140 LET R = F(4)
150 OPEN #2: NAME "PRT0008A.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 LINE INPUT #2: A$
170 CLOSE #2
180 OPEN #3: NAME "PRT0008B.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
190 LINE INPUT #3: B$
200 CLOSE #3
210 IF POS(A$, "7") > 0 AND POS(B$, "4") > 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
220 END
300 EXTERNAL SUB S
305 OPEN #1: NAME "PRT0008A.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
310 PRINT #1, USING 330: 7
320 REM THE IMAGE LINE FOLLOWS THE STATEMENT THAT NAMES IT, AS IN THE EXAMPLE OF 10.4.3
330 IMAGE: ###
335 CLOSE #1
340 END SUB
400 EXTERNAL FUNCTION F(X)
405 OPEN #1: NAME "PRT0008B.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
410 PRINT #1, USING 430: X
420 LET F = X
430 IMAGE: ###
435 CLOSE #1
440 END FUNCTION
