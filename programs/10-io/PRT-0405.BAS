1 REM FBCS PRT-0405
2 REM CLAIM A-10.4.5-CL10
3 REM TYPE SELF
4 REM STD 10.4.5 l.5836-5842: rest of the output goes on the line after the plain value
100 PRINT "PRT-0405 8203 RECOVERY: CONTINUATION ON THE FOLLOWING LINE (10.4.5)"
110 OPEN #1: NAME "PRT0405.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1, USING "(##)X": "ABCDE"
130 PRINT #1, USING "A##B##C": "TOOLONG", "OK"
140 CLOSE #1
150 OPEN #2: NAME "PRT0405.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 LINE INPUT #2: A$
161 LINE INPUT #2: B$
162 LINE INPUT #2: C$
163 LINE INPUT #2: D$
164 LINE INPUT #2: E$
165 LINE INPUT #2: F$
170 CLOSE #2
180 IF A$ <> "(**" THEN 900
190 IF B$ <> "ABCDE" THEN 900
200 IF C$ <> "   )X" THEN 900
210 IF D$ <> "A**" THEN 900
220 IF E$ <> "TOOLONG" THEN 900
230 IF F$ <> "   BOKC" THEN 900
240 PRINT "*** TEST PASSED ***"
250 GOTO 999
900 PRINT "*** TEST FAILED: RECORDS ARE ["; A$; "] ["; B$; "] ["; C$; "] ["; D$; "] ["; E$; "] ["; F$; "]"
999 END
