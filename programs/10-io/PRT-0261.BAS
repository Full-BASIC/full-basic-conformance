1 REM FBCS PRT-0261
2 REM CLAIM A-11.4.4.1-TR84
3 REM TYPE INPUT
100 REM ELAPSED ON AN ARRAY ELEMENT (A NUMERIC-VARIABLE, 10.2.2 PRODUCTION 7) IN INPUT #0, LINE INPUT #0, MAT
102 REM INPUT #0 AND MAT LINE INPUT #0 WORKS AS IN THE STATEMENTS WITHOUT A CHANNEL (11.4.4.1 L.8110-8114,
104 REM 11.4.4.6 L.8205-8209, 10.2.4.1 L.5166-5176): THE ELEMENT GETS A POSITIVE TIME, ALSO FOR A SUBSCRIPT
106 REM THAT IS A VARIABLE, FOR A TWO-DIMENSIONAL ELEMENT AND FOR AN ELEMENT OF A FORMAL ARRAY. THE REPLIES
108 REM ARE IN PRT-0261.IN; THE OUTPUT IS IN PRT-0261.OUT.
109 DECLARE SUB S
110 OPTION BASE 1
120 DIM E(3), F(2,2), V(2), G(2)
130 DECLARE STRING W$(2)
135 MAT E = ZER
136 MAT G = ZER
137 MAT F = ZER
140 INPUT #0, ELAPSED E(2): N
150 PRINT N; SGN(E(1)); SGN(E(2)); SGN(E(3))
160 LET I = 3
170 LINE INPUT #0, ELAPSED E(I): A$
180 PRINT A$; SGN(E(1)); SGN(E(2)); SGN(E(3))
190 MAT INPUT #0, ELAPSED F(2,1): V
200 PRINT V(1); V(2); SGN(F(1,1)); SGN(F(2,1)); SGN(F(2,2))
210 MAT LINE INPUT #0, ELAPSED E(1): W$
220 PRINT W$(1); W$(2); SGN(E(1))
230 CALL S(G)
240 PRINT SGN(G(1)); SGN(G(2))
250 SUB S(Q())
260   INPUT #0, ELAPSED Q(2): X
270 END SUB
280 END
