1 REM FBCS PRT-0148
2 REM CLAIM A-10.5.4.2-08
3 REM TYPE INPUT
100 REM ELEMENTS VALIDATED BEFORE AN 8002 (TOO FEW DATA) IN MAT INPUT STAY ASSIGNED (l.5970-5972, l.6118-6120)
110 DIM A(3)
120 WHEN EXCEPTION IN
130   MAT INPUT A
140 USE
150   IF EXTYPE = 8002 AND A(1) = 1 AND A(2) = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; EXTYPE; A(1); A(2)
160 END WHEN
170 END
