1 REM FBCS PRT-0241
2 REM CLAIM A-10.5.4.2-10
3 REM TYPE INPUT
100 REM WHEN THE INPUT RUNS OUT (END OF FILE, 8011) IN THE MIDDLE OF MAT INPUT AND THE EXCEPTION IS HANDLED BY A WHEN
102 REM BLOCK, THE DATA ALREADY SUPPLIED STAY ASSIGNED, AS WITH INPUT (10.2.4.2 L.5180-5184, 10.5.4.2 L.5970-5972;
104 REM TWO ARRAYS: THE FIRST ONE IS COMPLETE AND THE SECOND ONE HAS ONLY ITS FIRST ELEMENT; THE REST KEEP THEIR VALUE
110 DIM B(2), C(2)
120 LET BAD = 0
130 MAT B = ZER
140 MAT C = ZER
150 WHEN EXCEPTION IN
160   MAT INPUT B, C
170 USE
180   IF NOT (B(1) = 4 AND B(2) = 5 AND C(1) = 6 AND C(2) = 0) THEN LET BAD = BAD + 1
190 END WHEN
200 IF BAD = 0 THEN
210   PRINT "*** TEST PASSED ***"
220 ELSE
230   PRINT "*** TEST FAILED ***"
240 END IF
250 END
