1 REM FBCS PRT-0221
2 REM CLAIM A-10.5.4.4-05
3 REM TYPE INPUT
100 REM 1054 IN MAT LINE INPUT, HANDLED BY A WHEN BLOCK: THE LINES ACCEPTED BEFORE THE ERROR STAY ASSIGNED
102 REM (10.2.4.2 L.5180-5184 AND L.5218-5228, 10.5.4.4 L.6031, 10.5.5 L.6130-6132). CASES: 1-D, 2-D, 3-D
104 REM AND TWO ARRAYS (THE FAILING LINE BELONGS TO THE SECOND ARRAY); LATER ELEMENTS KEEP THEIR OLD VALUE
110 DECLARE STRING D$(3)*2, E$(2,2)*2, F$(2,2,2)*2, A$(2)*2, B$(2)*2
120 LET BAD = 0
130 MAT D$ = NUL$
140 MAT E$ = NUL$
150 MAT F$ = NUL$
160 MAT A$ = NUL$
170 MAT B$ = NUL$
180 LET CASE = 1
190 WHEN EXCEPTION IN
200   MAT LINE INPUT D$
210 USE
220   IF NOT (EXTYPE = 1054 AND D$(1) = "ab" AND D$(2) = "cd" AND D$(3) = "") THEN
230     LET BAD = BAD + 1
240     PRINT "FAILED CASE"; CASE
250   END IF
260 END WHEN
270 LET CASE = 2
280 WHEN EXCEPTION IN
290   MAT LINE INPUT E$
300 USE
310   IF NOT (EXTYPE = 1054 AND E$(1,1) = "ab" AND E$(1,2) = "cd" AND E$(2,1) = "" AND E$(2,2) = "") THEN
320     LET BAD = BAD + 1
330     PRINT "FAILED CASE"; CASE
340   END IF
350 END WHEN
360 LET CASE = 3
370 WHEN EXCEPTION IN
380   MAT LINE INPUT F$
390 USE
400   IF NOT (EXTYPE = 1054 AND F$(1,1,1) = "ab" AND F$(1,1,2) = "cd" AND F$(1,2,1) = "ef" AND F$(1,2,2) = "") THEN
410     LET BAD = BAD + 1
420     PRINT "FAILED CASE"; CASE
430   END IF
440 END WHEN
450 LET CASE = 4
460 WHEN EXCEPTION IN
470   MAT LINE INPUT A$, B$
480 USE
490   IF NOT (EXTYPE = 1054 AND A$(1) = "ab" AND A$(2) = "cd" AND B$(1) = "ef" AND B$(2) = "") THEN
500     LET BAD = BAD + 1
510     PRINT "FAILED CASE"; CASE
520   END IF
530 END WHEN
9000 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
9010 END
