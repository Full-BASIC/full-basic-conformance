1 REM FBCS PRT-0014
2 REM CLAIM A-10.1.4-03
3 REM TYPE SELF
100 REM IF MISSING EXIT DO MUST HAVE ITS NORMAL EFFECT (l.5021-5024); LINE 170 IS A SAFETY BOUND
110 DIM A(20)
120 DATA 1, 2, 3
130 LET I = 0
140 DO
150   READ IF MISSING THEN EXIT DO: X
160   LET I = I + 1
170   IF I > 10 THEN EXIT DO
180   LET A(I) = X
190 LOOP
200 IF I = 3 AND A(1) = 1 AND A(2) = 2 AND A(3) = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
