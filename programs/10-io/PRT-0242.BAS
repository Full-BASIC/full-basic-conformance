1 REM FBCS PRT-0242
2 REM CLAIM A-10.5.4.4-06
3 REM TYPE INPUT
100 REM WHEN THE INPUT RUNS OUT (END OF FILE, 8011) IN THE MIDDLE OF MAT LINE INPUT AND THE EXCEPTION IS HANDLED BY A
102 REM WHEN BLOCK, THE LINES ALREADY SUPPLIED STAY ASSIGNED, AS WITH LINE INPUT (10.2.4.2 L.5218-5228, 10.5.4.4 L.6031;
104 REM THE ELEMENT NOT REACHED KEEPS ITS VALUE
110 DIM P$(3)
120 LET BAD = 0
130 MAT P$ = NUL$
140 WHEN EXCEPTION IN
150   MAT LINE INPUT P$
160 USE
170   IF NOT (P$(1) = "X" AND P$(2) = "Y" AND P$(3) = "") THEN LET BAD = BAD + 1
180 END WHEN
190 IF BAD = 0 THEN
200   PRINT "*** TEST PASSED ***"
210 ELSE
220   PRINT "*** TEST FAILED ***"
230 END IF
240 END
