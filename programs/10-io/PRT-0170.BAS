1 REM FBCS PRT-0170
2 REM CLAIM E-1053
3 REM TYPE SELF
100 REM READ INTO A SUBSTRING THAT OVERFLOWS RAISES 1053, NOT 1106 (10.1.5 l.5066-5067)
110 DECLARE STRING A$ * 3
130 DECLARE STRING B$(2) * 3
140 LET A$ = "ABC"
150 LET B$(1) = "ABC"
160 LET OK = 0
170 WHEN EXCEPTION IN
180   READ A$(2:1)
190 USE
200   IF EXTYPE = 1053 AND A$ = "ABC" THEN LET OK = OK + 1
210 END WHEN
220 WHEN EXCEPTION IN
230   READ B$(1)(2:1)
240 USE
250   IF EXTYPE = 1053 AND B$(1) = "ABC" THEN LET OK = OK + 1
260 END WHEN
270 LET A$ = "AB"
280 READ A$(2:1)
290 IF OK = 2 AND A$ = "AXB" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
300 DATA X, X, X
310 END
