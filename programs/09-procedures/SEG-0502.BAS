1 REM FBCS SEG-0502
2 REM CLAIM A-12.1.4-TR128
3 REM TYPE OUTPUT
4 REM STD 12.1.4 l.8805-8807, 9.1.2 l.4228-4231: a function-let in the handler of an EXTERNAL FUNCTION gives its value.
100 DECLARE EXTERNAL FUNCTION F
110 DECLARE EXTERNAL FUNCTION G$
120 PRINT F(7)
130 PRINT G$("q")
140 END
200 EXTERNAL FUNCTION F(N)
210   LET F = 1
220   WHEN EXCEPTION USE H
230     CAUSE EXCEPTION 5
240   END WHEN
250   HANDLER H
260     LET F = N * 2
270   END HANDLER
280 END FUNCTION
300 EXTERNAL FUNCTION G$(S$)
310   LET G$ = "1"
320   WHEN EXCEPTION USE H
330     CAUSE EXCEPTION 5
340   END WHEN
350   HANDLER H
360     LET G$ = S$ & "!"
370   END HANDLER
380 END FUNCTION
