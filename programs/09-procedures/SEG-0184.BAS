1 REM FBCS SEG-0184
2 REM CLAIM A-9.2.4.1-11
3 REM TYPE SELF
99 DECLARE SUB S
100 PRINT &
&"SEG-0184 REFERENCE PARAMETER ACCEPTS A STRING WITHIN THE LENGTH OF ITS ARGUMENT AND MAXLEN IS THAT OF THE ARGUMENT (9.2.4.1)"
110 DECLARE STRING A$ * 2
120 LET M = 0
130 CALL S(A$, M)
140 IF A$ = "ab" AND M = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
150 GOTO 200
160 SUB S(B$, N)
170 LET B$ = "ab"
180 LET N = MAXLEN(B$)
190 END SUB
200 END
