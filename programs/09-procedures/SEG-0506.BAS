1 REM FBCS SEG-0506
2 REM CLAIM A-12.1.4-TR130
3 REM TYPE OUTPUT
4 REM STD 12.1.2 l.8708-8710, 6.2.4 l.2437-2441: the handler of an internal SUB sees its parameter and that of the unit.
100 DECLARE EXTERNAL SUB E
105 LET Y = 4
110 CALL E(Y)
115 PRINT Y
120 END
200 EXTERNAL SUB E(N)
210   SUB S(K)
220     WHEN EXCEPTION USE H
230       CAUSE EXCEPTION 5
240     END WHEN
250     HANDLER H
260       PRINT K; N
270       LET N = N + K
280     END HANDLER
290   END SUB
300   CALL S(10)
310   PRINT N
320 END SUB
