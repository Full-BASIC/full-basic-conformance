1 REM FBCS SEG-0673
2 REM CLAIM A-9.2.2-TR171
3 REM TYPE OUTPUT
4 REM 9.2.2 l.4554-4562: channel-expressions are accepted for channel-number parameters.
10 DECLARE EXTERNAL SUB W
20 SUB V(#3)
30 PRINT #3: "V"
40 END SUB
50 OPEN #1: NAME "FH", ACCESS OUTPUT
55 OPEN #2: NAME "FI", ACCESS OUTPUT
60 LET K = 1
70 CALL W(#1)
75 CALL W(#K)
80 CALL V(#K + 1)
85 CALL V(#1)
90 CLOSE #1
92 CLOSE #2
94 OPEN #1: NAME "FH", ACCESS INPUT
96 OPEN #2: NAME "FI", ACCESS INPUT
98 LINE INPUT #1: A$, B$, C$
99 LINE INPUT #2: E$
100 PRINT A$; B$; C$; E$
110 END
200 EXTERNAL SUB W(#2)
210 PRINT #2: "HI"
220 END SUB
