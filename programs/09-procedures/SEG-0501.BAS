4 REM STD 12.1.4 l.8805-8807, 9.2.4.2 l.4718-4723: the handler of an EXTERNAL SUB sees and assigns its parameters.
100 DECLARE EXTERNAL SUB E
110 LET X = 1
120 LET A$ = "a"
130 DIM V(2)
140 LET V(2) = 6
150 CALL E(X, A$, V)
160 PRINT X; A$; V(2)
170 CALL E(X, A$, V)
180 PRINT X; A$; V(2)
190 END
200 EXTERNAL SUB E(N, S$, W())
210   WHEN EXCEPTION USE H
220     CAUSE EXCEPTION 5
230   END WHEN
240   HANDLER H
250     LET N = N + 2
260     LET S$ = S$ & "x"
270     LET W(2) = W(2) + 1
280   END HANDLER
290 END SUB
