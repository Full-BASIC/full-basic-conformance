1 REM FBCS SEG-0334
2 REM CLAIM A-9.2.4.1-17
3 REM TYPE SELF
100 PRINT "SEG-0334 ASSIGNMENT TO A BY-VALUE PARAMETER INSIDE A GOSUB SUBROUTINE (8.2.4, 9.1.4.1, 9.2.4.1)"
110 DECLARE EXTERNAL SUB E
120 DECLARE EXTERNAL FUNCTION G
130 GOTO 500
200 SUB S(X, A$)
210   GOSUB 250
220   IF X <> 8 THEN PRINT "*** TEST FAILED: INTERNAL SUB ***"; X
230   IF A$ <> "A!" THEN PRINT "*** TEST FAILED: INTERNAL SUB STRING ***"; A$
240   EXIT SUB
250   LET X = 7
260   LET A$ = A$ & "!"
270   GOSUB 290
280   RETURN
290   LET X = X + 1
295   RETURN
299 END SUB
300 FUNCTION F(X)
310   GOSUB 350
320   LET F = X * 2
330   EXIT FUNCTION
350   LET X = X + 1
360   RETURN
370 END FUNCTION
500 CALL S(1, "A")
510 CALL E(1)
520 LET R = F(1)
530 IF R <> 4 THEN PRINT "*** TEST FAILED: INTERNAL FUNCTION ***"; R
540 LET R = G(1)
550 IF R <> 7 THEN PRINT "*** TEST FAILED: EXTERNAL FUNCTION ***"; R
560 PRINT "*** TEST PASSED ***"
570 END
600 EXTERNAL SUB E(X)
610   GOSUB 650
620   IF X <> 7 THEN PRINT "*** TEST FAILED: EXTERNAL SUB ***"; X
630   EXIT SUB
650   LET X = 7
660   RETURN
670 END SUB
700 EXTERNAL FUNCTION G(X)
710   GOSUB 750
720   LET G = X
730   EXIT FUNCTION
750   LET X = 7
760   RETURN
770 END FUNCTION
