1 REM FBCS SEG-0512
2 REM CLAIM A-9.2.4-TR132
3 REM TYPE OUTPUT
4 REM STD 9.2.4.1 l.4647-4651, 12.1.4 l.8805-8807: a string LOCAL of an EXTERNAL SUB passed to an internal SUB whose
5 REM handler assigns the formal.
10 DECLARE EXTERNAL SUB E
20 CALL E
30 END
100 EXTERNAL SUB E
110 SUB S(K$)
120   WHEN EXCEPTION USE H
130     CAUSE EXCEPTION 5
140   END WHEN
150   HANDLER H
160     LET K$ = "NEW"
170   END HANDLER
180 END SUB
190 LET X$ = "OLD"
200 CALL S(X$)
210 PRINT X$
220 END SUB
