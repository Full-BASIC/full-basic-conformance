1 REM FBCS SEG-0658
2 REM CLAIM A-4.4.2-TR169
3 REM TYPE SELF
4 REM 5.3.2 l.1786-1789: a flag read in an IF before it is set, with an external function of the same name elsewhere.
10 DECLARE EXTERNAL SUB E
20 DECLARE EXTERNAL FUNCTION READY
30 CALL E
40 IF READY <> 7 THEN PRINT "*** TEST FAILED *** main call"
50 PRINT "*** TEST PASSED ***"
90 END
100 EXTERNAL SUB E
110 IF READY <> 0 THEN PRINT "*** TEST FAILED *** unassigned"
120 LET READY = 1
130 IF READY <> 1 THEN PRINT "*** TEST FAILED *** assigned"
140 END SUB
200 EXTERNAL FUNCTION READY
210 LET READY = 7
220 END FUNCTION
