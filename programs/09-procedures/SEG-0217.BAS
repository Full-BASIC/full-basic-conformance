1 REM FBCS SEG-0217
2 REM CLAIM A-9.1.3-01
3 REM TYPE SELF
100 DECLARE EXTERNAL FUNCTION ANSWER
110 IF ANSWER("YES") = 1 AND ANSWER("no") = 2 AND ANSWER("x") = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
120 END
130 EXTERNAL FUNCTION ANSWER(A$)
140 SELECT CASE UCASE$(A$)
150 CASE "YES"
160   LET ANSWER = 1
170 CASE "NO"
180   LET ANSWER = 2
190 CASE ELSE
200   LET ANSWER = 3
210 END SELECT
220 END FUNCTION
