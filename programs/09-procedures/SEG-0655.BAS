1 REM FBCS SEG-0655
2 REM CLAIM A-4.4.2-TR169
3 REM TYPE OUTPUT
4 REM 4.4.2 l.1460-1466: an element of an array parameter named as an undeclared external FUNCTION is an element.
10 DECLARE EXTERNAL SUB E
20 DECLARE EXTERNAL FUNCTION Q
30 DIM A(2)
40 MAT A = CON
50 CALL E(A)
60 PRINT Q(1)
90 END
100 EXTERNAL SUB E(Q())
110 PRINT Q(1) + Q(2)
120 END SUB
200 EXTERNAL FUNCTION Q(X)
210 LET Q = X + 100
220 END FUNCTION
