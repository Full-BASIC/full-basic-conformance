1 REM FBCS SEG-0505
2 REM CLAIM A-12.1.4-TR130
3 REM TYPE OUTPUT
4 REM STD 9.1.2 l.4228-4231, 12.1.4 l.8805-8807: the only function-let of an EXTERNAL FUNCTION may be in its handler.
100 DECLARE EXTERNAL FUNCTION F
110 PRINT F(0)
120 END
200 EXTERNAL FUNCTION F(X)
210   WHEN EXCEPTION USE H
220     LET Y = 1 / X
230   END WHEN
240   HANDLER H
250     LET F = -1
260   END HANDLER
270 END FUNCTION
