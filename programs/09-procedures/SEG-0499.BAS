1 REM FBCS SEG-0499
2 REM CLAIM A-9.2.4.2-TR116
3 REM TYPE OUTPUT
4 REM STD 9.2.4.2 l.4726-4738, 9.2.4.1 l.4647-4653: a parameter of an EXTERNAL SUB is read and assigned by its internal SUB.
100 DECLARE EXTERNAL SUB E
110 LET A = 1
120 LET S$ = "X"
130 CALL E(7, A, S$)
140 PRINT A
150 PRINT S$
160 END
200 EXTERNAL SUB E(N, M, T$)
210 SUB R
220   PRINT N
230   LET M = N + 1
240   LET T$ = T$ & "Y"
250   PRINT T$
260 END SUB
270 CALL R
280 PRINT M
290 END SUB
