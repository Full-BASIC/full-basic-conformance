1 REM FBCS SEG-0550
2 REM CLAIM A-9.1.2-TR143
3 REM TYPE OUTPUT
4 REM 9.1.2 l.4201-4205, 12.1.4 l.8805-8807: the detached-handlers of the main program and of an internal SUB use an
5 REM external FUNCTION that the main program declares.
10 DECLARE EXTERNAL FUNCTION G
20 WHEN EXCEPTION USE H
30   CAUSE EXCEPTION 1
40 END WHEN
50 SUB S
60   WHEN EXCEPTION USE K
70     CAUSE EXCEPTION 1
80   END WHEN
90   HANDLER K
100     PRINT G(10)
110   END HANDLER
120 END SUB
130 CALL S
140 HANDLER H
150   PRINT G(1)
160 END HANDLER
170 END
200 EXTERNAL FUNCTION G(X)
210 LET G = X + 1
220 END FUNCTION
