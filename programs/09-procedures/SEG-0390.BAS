1 REM FBCS SEG-0390
2 REM CLAIM A-9.3.4-04
3 REM TYPE SELF
100 REM A STRING ARRAY IS PASSED BY VALUE TO A FORMAL STRING-ARRAY OF THE PROGRAM-NAME-LINE
101 REM (9.3.4 l.4888-4896, 4.2.2 l.1197-1199, 9.1.2 l.4252); THE FORMAL TAKES THE BOUNDS OF THE ACTUAL
102 REM AND THE DEFAULT MAXIMUM STRING LENGTH (9.1.4.1 l.4314-4319)
110 DECLARE STRING B$(0 TO 2) * 2
115 LET B$(0) = "X"
120 LET B$(2) = "Y"
130 OPEN #1: NAME "TGT.BAS", ACCESS OUTPUT
140 PRINT #1: "5 PROGRAM T(V$())"
150 PRINT #1: "10 LET V$(1) = ""ABCDEFG"""
160 PRINT #1: "20 LET OK = 1"
170 PRINT #1: "21 IF NOT (LBOUND(V$) = 0) THEN LET OK = 0"
180 PRINT #1: "22 IF NOT (UBOUND(V$) = 2) THEN LET OK = 0"
190 PRINT #1: "23 IF NOT (V$(0) = ""X"") THEN LET OK = 0"
200 PRINT #1: "24 IF NOT (V$(2) = ""Y"") THEN LET OK = 0"
210 PRINT #1: "25 IF NOT (LEN(V$(1)) = 7) THEN LET OK = 0"
220 PRINT #1: "26 IF OK = 1 THEN PRINT ""*** TEST PASSED ***"" ELSE PRINT ""*** TEST FAILED ***"""
230 PRINT #1: "27 END"
240 CLOSE #1
250 CHAIN "TGT.BAS" WITH (B$)
260 PRINT "*** TEST FAILED: CHAIN RETURNED ***"
270 END
