1 REM FBCS SEG-0370
2 REM CLAIM E-1053
3 REM TYPE SELF
100 REM READ INTO A BY-REFERENCE STRING PARAMETER THAT OVERFLOWS RAISES 1053, NOT 1106 (10.1.5 l.5066-5067, 9.2.4.1 l.4679-4682)
105 REM A LET INTO THE SAME PARAMETER STILL RAISES 1106 (6.5.5); A DATUM THAT FITS IS ASSIGNED
109 DECLARE SUB S1, S2, S3
110 DECLARE STRING A$ * 2
120 DECLARE STRING C$(3) * 2
130 LET A$ = "Z"
140 LET C$(1) = "Y"
150 LET C$(2) = "X"
160 LET OK = 0
170 CALL S1(A$)
180 CALL S1(C$(2))
190 CALL S2(C$)
200 CALL S3(A$)
210 CALL S1(A$)
220 IF OK = 4 AND A$ = "ab" AND C$(2) = "X" AND C$(1) = "Y" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 STOP
300 SUB S1(B$)
310 WHEN EXCEPTION IN
320   READ B$
330 USE
340   IF EXTYPE = 1053 THEN LET OK = OK + 1
350 END WHEN
360 END SUB
400 SUB S2(Q$())
410 WHEN EXCEPTION IN
420   READ Q$(1)
430 USE
440   IF EXTYPE = 1053 AND Q$(1) = "Y" THEN LET OK = OK + 1
450 END WHEN
460 END SUB
500 SUB S3(B$)
510 WHEN EXCEPTION IN
520   LET B$ = "abc"
530 USE
540   IF EXTYPE = 1106 AND B$ = "Z" THEN LET OK = OK + 1
550 END WHEN
560 END SUB
900 DATA abc, abc, abc, ab
910 END
