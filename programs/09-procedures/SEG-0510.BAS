1 REM FBCS SEG-0510
2 REM CLAIM A-12.1.4-TR131
3 REM TYPE OUTPUT
4 REM STD 9.2.2 l.4539-4540, 9.2.4 l.4622-4627: EXIT SUB in the detached handler of an internal SUB, also
5 REM inside an EXTERNAL SUB, ends that SUB and not the unit.
10 DECLARE EXTERNAL SUB E
20 CALL E
30 PRINT "END"
40 END
100 EXTERNAL SUB E
110 SUB S
120   WHEN EXCEPTION USE H
130     CAUSE EXCEPTION 2
140   END WHEN
150   PRINT "NO"
160   HANDLER H
170     PRINT "H"
180     EXIT SUB
190   END HANDLER
200 END SUB
210 CALL S
220 PRINT "E"
230 END SUB
