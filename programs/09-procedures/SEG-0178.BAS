1 REM FBCS SEG-0178
2 REM CLAIM A-9.2.4.1-15
3 REM TYPE SELF
99 DECLARE SUB S
100 PRINT "SEG-0178 ASK INTO A PARAMETER GIVES WHAT IT GIVES A VARIABLE (9.2.4.1, 10.1)"
110 ASK MARGIN Q
120 ASK ZONEWIDTH P
130 LET A = -1
140 LET B = -1
150 CALL S(A, B)
160 IF A = Q AND B = P AND Q <> -1 AND P <> -1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 GOTO 230
180 SUB S(Y, Z)
190 ASK MARGIN Y
200 ASK ZONEWIDTH Z
210 END SUB
230 END
