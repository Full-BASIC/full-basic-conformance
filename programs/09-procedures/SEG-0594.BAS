1 REM FBCS SEG-0594
2 REM CLAIM A-9.2.4.2-TR150
3 REM TYPE OUTPUT
4 REM 9.2.4.2 l.4718-4733: recursion, one local array per invocation.
10 DECLARE EXTERNAL SUB E
20 DIM M(2)
30 LET M(1) = 7
40 CALL E(M, 2)
50 PRINT M(1)
60 END
70 EXTERNAL SUB E(V(), N)
80 DIM W(2)
90 LET W(1) = N * 10
100 IF N > 0 THEN CALL E(W, N - 1)
110 PRINT V(1); W(1)
120 END SUB
