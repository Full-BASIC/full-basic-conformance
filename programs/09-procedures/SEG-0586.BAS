1 REM FBCS SEG-0586
2 REM CLAIM A-9.2.4.2-TR147B
3 REM TYPE OUTPUT
4 REM 9.2.4.2 l.4726-4733, 9.2.4 l.4632-4634: recursion with an output parameter in an internal SUB of an external SUB.
10 DECLARE EXTERNAL SUB E
20 CALL E
30 END
40 EXTERNAL SUB E
50 SUB S(N, R)
60   IF N = 0 THEN
70     LET R = 100
80   ELSE
90     CALL S(N - 1, Q)
100     LET R = Q + 1
110   END IF
120 END SUB
130 LET K = 3
140 CALL S(K, X)
150 PRINT K; X
160 END SUB
