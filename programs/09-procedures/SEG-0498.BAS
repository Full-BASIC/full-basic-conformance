1 REM FBCS SEG-0498
2 REM CLAIM A-9.2.4.2-113
3 REM TYPE SELF
4 REM READ in an external SUB types its target by the local name, not by a global
5 REM STD 9.2.4.2 l.4728-4735, 10.1.4, 10.2.4.2
100 PRINT "SEG-0498 TYPE OF THE TARGET VARIABLE OF READ IN AN EXTERNAL SUB WITH MIXED LOCALS (9.2.4.2, 10.1.4)"
110 DECLARE EXTERNAL SUB S, T
120 LET N = 1
130 LET M = 2
140 LET N$ = "x"
150 LET M$ = "y"
160 CALL S(R$, K)
170 CALL T(R2$, K2)
180 IF R$ <> "zz" OR K <> 3 THEN PRINT "*** TEST FAILED: STRING LOCAL ***"; R$; K
190 IF R2$ <> "p" OR K2 <> 7 THEN PRINT "*** TEST FAILED: NUMERIC LOCAL ***"; R2$; K2
200 IF N <> 1 OR M <> 2 OR N$ <> "x" OR M$ <> "y" THEN PRINT "*** TEST FAILED: GLOBALS ***"
210 PRINT "*** TEST PASSED ***"
220 END
300 EXTERNAL SUB S(R$, K)
310   LET A = 3
320   READ B$
330   LET R$ = B$
340   LET K = A
350   DATA zz
360 END SUB
400 EXTERNAL SUB T(R$, K)
410   LET A$ = "p"
420   READ B
430   LET R$ = A$
440   LET K = B
450   DATA 7
460 END SUB
