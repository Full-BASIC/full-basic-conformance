1 REM FBCS SEG-0361
2 REM CLAIM E-1053
3 REM TYPE SELF
100 REM READ INTO A SUBSTRING OF A BY-REFERENCE STRING PARAMETER RAISES 1053; A LET STILL 1106
105 REM A FATAL EXCEPTION PROPAGATED OUT OF A PROCEDURE ADDS 100000 TO EXTYPE (12.1.4)
109 DECLARE SUB S1, S2
110 DECLARE STRING A$ * 3
120 LET A$ = "ABC"
130 LET OK = 0
140 WHEN EXCEPTION IN
150   CALL S1(A$)
160 USE
170   IF EXTYPE = 101053 AND A$ = "ABC" THEN LET OK = OK + 1
180 END WHEN
190 WHEN EXCEPTION IN
200   CALL S2(A$)
210 USE
220   IF EXTYPE = 101106 AND A$ = "ABC" THEN LET OK = OK + 1
230 END WHEN
240 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 DATA X
260 SUB S1(B$)
270 READ B$(2:1)
280 END SUB
290 SUB S2(B$)
300 LET B$(2:1) = "X"
310 END SUB
320 END
