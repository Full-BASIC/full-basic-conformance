1 REM FBCS SEG-0160
2 REM CLAIM A-9.2.4.1-01
3 REM TYPE SELF
99 DECLARE SUB S
100 PRINT "SEG-0160 TWO-DIMENSIONAL ARRAY ELEMENT PASSED BY REFERENCE (9.2.4.1)"
110 DIM A(2,2)
120 MAT A = ZER
130 CALL S(A(2,1))
140 IF A(2,1) = 5 AND A(1,2) = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
150 SUB S(Y)
160 LET Y = 5
170 END SUB
180 END
