1 REM FBCS EXC-0054
2 REM CLAIM A-12.2.4-09
3 REM TYPE SELF
100 OPEN #3: NAME "t5.txt", ACCESS OUTPUT
110 DEBUG ON
120 TRACE ON TO #3
130 DIM B(2)
140 LET I = 2
150 LET B(I) = 98+1
160 TRACE OFF
170 CLOSE #3
180 OPEN #3: NAME "t5.txt", ACCESS INPUT
190 LET NAMEOK = 0
200 LET VALOK = 0
210 LET SUBOK = 0
220 FOR K = 1 TO 10
230   LINE INPUT #3, IF MISSING THEN EXIT FOR: L$
240   IF POS(L$, "150") > 0 THEN
250     IF POS(L$, "B") > 0 THEN LET NAMEOK = 1
260     IF POS(L$, "99") > 0 THEN LET VALOK = 1
270     IF POS(L$, "(2)") > 0 THEN LET SUBOK = 1
280   END IF
290 NEXT K
300 IF NAMEOK=1 AND VALOK=1 AND SUBOK=1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; NAMEOK; VALOK; SUBOK
310 END
