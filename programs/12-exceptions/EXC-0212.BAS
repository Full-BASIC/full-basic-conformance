1 REM FBCS EXC-0212
2 REM CLAIM A-12.1.4-TR131
3 REM TYPE OUTPUT
4 REM STD 12.1.4 l.8809-8815: same, with an internal SUB handled by a detached handler.
10 SUB S
20   WHEN EXCEPTION USE H
30     CAUSE EXCEPTION 2
40   END WHEN
50   HANDLER H
60     PRINT "S"; EXTYPE
70   END HANDLER
80 END SUB
90 WHEN EXCEPTION IN
100   CAUSE EXCEPTION 1
110 USE
120   CALL S
130   PRINT "MAIN"; EXTYPE; EXLINE
140 END WHEN
150 END
