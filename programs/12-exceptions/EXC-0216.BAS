1 REM FBCS EXC-0216
2 REM CLAIM A-12.2.4-TR134
3 REM TYPE SELF
4 REM 12.2.4 l.9138-9143 (point 2), D-12.2-2: the same for a parameter of an EXTERNAL SUB (the unit opens
5 REM its own trace channel).
10 DECLARE EXTERNAL SUB E
20 LET B = 4
30 CALL E(B)
40 END
100 EXTERNAL SUB E(K)
110 OPEN #3: NAME "EXC0216.TXT", ACCESS OUTPUT
120 DEBUG ON
130 TRACE ON TO #3
140 LET K = K + 1
150 TRACE OFF
160 CLOSE #3
300 OPEN #3: NAME "EXC0216.TXT", ACCESS INPUT
310 LET FOUND = 0
320 FOR K = 1 TO 30
330   LINE INPUT #3, IF MISSING THEN EXIT FOR: L$
340   IF POS(L$, "K=5") > 0 THEN LET FOUND = 1
350 NEXT K
360 CLOSE #3
370 IF FOUND = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
400 END SUB
