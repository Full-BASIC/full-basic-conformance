1 REM FBCS EXC-0258
2 REM CLAIM A-12.1.4-CL13
3 REM TYPE SELF
10 REM A handler that ends at END WHEN leaves no GOSUB frame hanging (STD 12.1.4 l.8836-8841,
20 REM 8.2.5): the RETURN executed afterwards, outside every subroutine, is exception 10002.
100 WHEN EXCEPTION IN
110   GOSUB 300
120 USE
130   LET H = 1
140 END WHEN
150 WHEN EXCEPTION IN
160   RETURN
170 USE
180   IF EXTYPE = 10002 AND H = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE; H
190 END WHEN
200 STOP
300 LET A = 1/0
310 RETURN
320 END
