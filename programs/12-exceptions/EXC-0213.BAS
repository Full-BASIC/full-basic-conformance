1 REM FBCS EXC-0213
2 REM CLAIM A-12.1.4-TR131
3 REM TYPE OUTPUT
4 REM STD 12.1.4 l.8809-8815: a SUB that leaves by EXIT SUB from its own handler gives the calling handler
5 REM its EXTYPE back.
10 DECLARE EXTERNAL SUB E
20 WHEN EXCEPTION IN
30   CAUSE EXCEPTION 1
40 USE
50   CALL E
60   PRINT "MAIN"; EXTYPE
70 END WHEN
80 END
100 EXTERNAL SUB E
110 WHEN EXCEPTION USE H
120   CAUSE EXCEPTION 2
130 END WHEN
140 HANDLER H
150   PRINT "SUB"; EXTYPE
160   EXIT SUB
170 END HANDLER
180 END SUB
