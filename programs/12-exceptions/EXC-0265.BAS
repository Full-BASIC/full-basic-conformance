1 REM FBCS EXC-0265
2 REM CLAIM D-12.2-2
3 REM TYPE SELF
100 REM The assignment report names the variable as it is written in the statement.
110 OPEN #3: NAME "t265.txt", ACCESS OUTPUT
120 DEBUG ON
130 TRACE ON TO #3
140 LET w = 20
150 TRACE OFF
160 CLOSE #3
170 OPEN #3: NAME "t265.txt", ACCESS INPUT
180 LET OK = 0
190 FOR K = 1 TO 6
200   LINE INPUT #3, IF MISSING THEN EXIT FOR: L$
210   IF L$ = "[TRACE] 140 w=20" THEN LET OK = 1
220 NEXT K
230 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; OK
240 END
