1 REM FBCS EXC-0259
2 REM CLAIM A-12.1.4-CL13
3 REM TYPE SELF
10 REM EXIT HANDLER in a handler of a GOSUB subroutine propagates to the when-block that surrounds
20 REM the GOSUB (STD 12.1.4 l.8842-8851), without adding 100000.
100 WHEN EXCEPTION IN
110   GOSUB 300
120 USE
130   IF EXTYPE = 3001 AND EXLINE = 310 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE; EXLINE
140 END WHEN
150 STOP
300 WHEN EXCEPTION IN
310   LET A = 1/0
320 USE
330   EXIT HANDLER
340 END WHEN
350 RETURN
360 END
