1 REM FBCS EXC-0260
2 REM CLAIM A-12.1.4-08
3 REM TYPE SELF
4 REM 12.1.4 l.8869-8871, 5.2.4 l.1698-1702: EXTYPE is INT(X+.5) of the index, for any value.
10 OPTION ARITHMETIC DECIMAL
20 LET OK = 1
100 WHEN EXCEPTION IN
110   CAUSE EXCEPTION 1E12
120 USE
130   IF EXTYPE <> 1000000000000 THEN LET OK = 0
140 END WHEN
200 WHEN EXCEPTION IN
210   CAUSE EXCEPTION -1E12
220 USE
230   IF EXTYPE <> -1000000000000 THEN LET OK = 0
240 END WHEN
300 WHEN EXCEPTION IN
310   CAUSE EXCEPTION 4294967296.5
320 USE
330   IF EXTYPE <> 4294967297 THEN LET OK = 0
340 END WHEN
400 WHEN EXCEPTION IN
410   CAUSE EXCEPTION -2.5
420 USE
430   IF EXTYPE <> -2 THEN LET OK = 0
440 END WHEN
500 WHEN EXCEPTION IN
510   CAUSE EXCEPTION 1E99
520 USE
530   IF EXTYPE <> 1E99 THEN LET OK = 0
540 END WHEN
600 WHEN EXCEPTION IN
610   CALL S(1E12)
620 USE
630   IF EXTYPE <> 1000000100000 THEN LET OK = 0
640 END WHEN
700 WHEN EXCEPTION IN
710   CALL S(-1E12)
720 USE
730   IF EXTYPE <> -1000000100000 THEN LET OK = 0
740 END WHEN
800 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
810 STOP
900 SUB S(X)
910   CAUSE EXCEPTION X
920 END SUB
930 END
