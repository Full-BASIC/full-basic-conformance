1 REM FBCS EXC-0248
2 REM CLAIM A-12.1.4-CL13
3 REM TYPE SELF
10 REM A GOSUB inside an internal SUB, whose handler is around the CALL: the SUB is a
20 REM procedure-part, so one 100000 only (not two). EXLINE = line of the CALL.
100 WHEN EXCEPTION IN
110   CALL S
120 USE
130   IF EXTYPE = 103001 AND EXLINE = 110 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE; EXLINE
140 END WHEN
150 STOP
200 SUB S
210   GOSUB 400
220   EXIT SUB
400   LET A = 1/0
410   RETURN
420 END SUB
430 END
