1 REM FBCS EXC-0070
2 REM CLAIM A-2.4-03
3 REM TYPE SELF
100 PRINT "EXC-0070 FATAL EXCEPTION IN A SUBPROGRAM PROPAGATES TO THE INVOKING LINE (2.4, 12.1.4)"
105 DECLARE EXTERNAL SUB BOOM
110 WHEN EXCEPTION IN
120   CALL BOOM
130   PRINT "*** TEST FAILED: NO EXCEPTION ***"
140 USE
150   IF EXLINE = 120 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXLINE"; EXLINE
160 END WHEN
170 END
200 EXTERNAL SUB BOOM
210 LET Z = 0
220 LET Y = 1 / Z
230 END SUB
