1 REM FBCS EXC-0254
2 REM CLAIM A-12.1.4-CL13
3 REM TYPE SELF
10 REM Control: a negative (local) EXTYPE propagated becomes -100000 plus the value (l.8913-8917).
100 WHEN EXCEPTION IN
110   CALL S
120 USE
130   IF EXTYPE = -100005 AND EXLINE = 110 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE; EXLINE
140 END WHEN
150 STOP
200 SUB S
210   CAUSE EXCEPTION -5
220 END SUB
230 END
