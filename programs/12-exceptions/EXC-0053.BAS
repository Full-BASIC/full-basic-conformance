1 REM FBCS EXC-0053
2 REM CLAIM A-12.2.4-08
3 REM TYPE SELF
100 OPEN #3: NAME "t4.txt", ACCESS OUTPUT
110 DEBUG ON
120 TRACE ON TO #3
130 LET A = 1
140 TRACE OFF
150 TRACE ON
160 LET B = 2
170 TRACE OFF
180 CLOSE #3
190 OPEN #3: NAME "t4.txt", ACCESS INPUT
200 LET FA = 0
210 LET FB = 0
220 FOR K = 1 TO 10
230   LINE INPUT #3, IF MISSING THEN EXIT FOR: L$
240   IF POS(L$, "LET A") > 0 THEN LET FA = 1
250   IF POS(L$, "LET B") > 0 THEN LET FB = 1
260 NEXT K
270 IF FA = 1 AND FB = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; FA; FB
280 END
