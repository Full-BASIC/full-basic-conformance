1 REM FBCS EXC-0040
2 REM CLAIM A-12.1.4-13
3 REM TYPE SELF
100 DECLARE EXTERNAL SUB DOWN_NEG
110 LET L = 0
120 LET P = 0
130 WHEN EXCEPTION IN
140   CAUSE EXCEPTION -42
150 USE
160   IF EXTYPE = -42 THEN LET L = 1
170 END WHEN
180 WHEN EXCEPTION IN
190   CALL DOWN_NEG
200 USE
210   IF EXTYPE = -100042 THEN LET P = 1
220 END WHEN
230 IF L = 1 AND P = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; L; P
240 END
250 EXTERNAL SUB DOWN_NEG
260   CAUSE EXCEPTION -42
270 END SUB
