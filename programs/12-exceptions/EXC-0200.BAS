1 REM FBCS EXC-0200
2 REM CLAIM A-12.1.2-TR98
3 REM TYPE SELF
4 REM STD 12.1.4 l.8860-8863: the handler still serves a real exception after a jump to its handler-line.
100 LET F = 0
110 GOTO 190
120 WHEN EXCEPTION USE H
130   CAUSE EXCEPTION 1001
140 END WHEN
150 LET F = F + 1
160 GOTO 300
190 HANDLER H
200   LET F = F + 10
210   CONTINUE
220 END HANDLER
230 GOTO 120
300 IF F = 11 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
310 END
