1 REM FBCS EXC-0078
2 REM CLAIM A-12.1.6-01
3 REM TYPE WARN
4 REM EXPECT 7002 150
10 REM The nonfatal 7002 of CLOSE #0 inside the external sub
20 REM is reported at the original line (150) and the program goes on (exit 0).
30 DECLARE EXTERNAL SUB S
40 WHEN EXCEPTION IN
50   CALL S
60 USE
70   PRINT "H"; EXTYPE; EXLINE
80 END WHEN
90 PRINT "AFTER"
100 END
110 EXTERNAL SUB S
150 CLOSE #0
160 PRINT "SIGUE"
170 END SUB
