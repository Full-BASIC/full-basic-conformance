1 REM FBCS EXC-0218
2 REM CLAIM A-12.2.4-TR136
3 REM TYPE SELF
4 REM 12.2.4 l.9128-9143, D-12.2-2: the trace of an EXTERNAL SUB reports the assignment to an element of its
5 REM formal-array with the name of the formal-array, the subscript and the value.
10 DECLARE EXTERNAL SUB E
20 DIM W(3)
30 CALL E(W)
300 OPEN #3: NAME "EXC0218.TXT", ACCESS INPUT
310 LET FOUND = 0
320 FOR K = 1 TO 40
330   LINE INPUT #3, IF MISSING THEN EXIT FOR: L$
340   IF POS(L$, "V(3)=9") > 0 THEN LET FOUND = 1
350 NEXT K
360 CLOSE #3
370 IF FOUND = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
400 END
500 EXTERNAL SUB E(V())
510 OPEN #3: NAME "EXC0218.TXT", ACCESS OUTPUT
520 DEBUG ON
530 TRACE ON TO #3
540 LET V(3) = 9
550 TRACE OFF
560 CLOSE #3
570 END SUB
