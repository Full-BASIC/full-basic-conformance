1 REM FBCS ARR-0305
2 REM CLAIM A-7.1.2-TR109
3 REM TYPE SELF
4 REM STD 7.1.2 l.2997-2999, 9.2.4.2 l.4733-4738: a DIM inside an internal PICTURE is seen from the main and from later routines.
100 REM DIM INSIDE AN INTERNAL PICTURE, USED AFTER IT IN THE MAIN AND IN A LATER SUB
110 LET OK = 1
120 PICTURE P
130   DIM B(2)
140   LET B(1) = 3
150 END PICTURE
160 SUB S
170   LET B(2) = B(1) + 1
180 END SUB
190 DRAW P
200 CALL S
210 IF B(1) <> 3 OR B(2) <> 4 OR UBOUND(B) <> 2 THEN LET OK = 0
220 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END
