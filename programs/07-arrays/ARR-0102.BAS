1 REM FBCS ARR-0102
2 REM CLAIM A-7.1.4-02
3 REM TYPE SELF
100 PRINT "ARR-0102 MAXSIZE AFTER MAT READ (7.1.4)"
110 DIM A(10)
120 DATA 1, 2, 3
130 MAT READ A(3)
140 IF SIZE(A) <> 3 THEN PRINT "*** TEST FAILED: SIZE"; SIZE(A)
150 IF MAXSIZE(A) = 10 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: MAXSIZE"; MAXSIZE(A)
160 END
