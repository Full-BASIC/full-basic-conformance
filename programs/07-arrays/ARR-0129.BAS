1 REM FBCS ARR-0129
2 REM CLAIM A-7.1.4-09
3 REM TYPE SELF
100 REM OPTION BASE IS LOCAL TO ITS PROGRAM UNIT (7.1.4 l.3052-3054)
110 DECLARE EXTERNAL SUB S
120 OPTION BASE 0
130 DIM A(3)
140 CALL S
150 IF LBOUND(A) = 0 AND UBOUND(A) = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; LBOUND(A); UBOUND(A)
160 END
170 EXTERNAL SUB S
180   DIM C(3)
190   IF LBOUND(C) <> 1 OR UBOUND(C) <> 3 THEN PRINT "*** TEST FAILED: SUB BASE ***"; LBOUND(C)
200 END SUB
