1 REM FBCS ARR-0204
2 REM CLAIM A-7.1.4-18
3 REM TYPE SELF
100 REM AN OPTION BASE IN AN EXTERNAL UNIT DOES NOT REACH THE MAIN PROGRAM (7.1.4 l.3051-3054; 5.6 l.2212-2233)
110 DECLARE EXTERNAL SUB S
120 DECLARE EXTERNAL FUNCTION F
130 DECLARE EXTERNAL PICTURE P
140 DIM A(3)
150 CALL S
160 LET X = F
170 DRAW P
180 DIM B(3)
190 IF LBOUND(A) <> 1 THEN PRINT "*** TEST FAILED: MAIN A ***"; LBOUND(A)
200 IF LBOUND(B) <> 1 THEN PRINT "*** TEST FAILED: MAIN B ***"; LBOUND(B)
210 PRINT "*** TEST PASSED ***"
220 END
300 EXTERNAL SUB S
310   OPTION BASE 0
320   DIM C(3)
330   IF LBOUND(C) <> 0 THEN PRINT "*** TEST FAILED: SUB ***"; LBOUND(C)
340 END SUB
400 EXTERNAL FUNCTION F
410   OPTION BASE 0
420   DIM C(3)
430   IF LBOUND(C) <> 0 THEN PRINT "*** TEST FAILED: FUNCTION ***"; LBOUND(C)
440   LET F = 1
450 END FUNCTION
500 EXTERNAL PICTURE P
510   OPTION BASE 0
520   DIM C(3)
530   IF LBOUND(C) <> 0 THEN PRINT "*** TEST FAILED: PICTURE ***"; LBOUND(C)
540 END PICTURE
