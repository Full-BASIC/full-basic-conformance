1 REM FBCS ARR-0316
2 REM CLAIM A-12.1.4-TR130
3 REM TYPE OUTPUT
4 REM STD 7.1.2 l.2996-2999, 12.1.2 prod. 15: a DIM in the handler of an EXTERNAL SUB declares an array of the unit.
100 DECLARE EXTERNAL SUB E
110 CALL E
120 END
200 EXTERNAL SUB E
210   HANDLER H
220     DIM B(3)
230   END HANDLER
240   WHEN EXCEPTION USE H
250     CAUSE EXCEPTION 5
260   END WHEN
270   LET B(2) = 4
280   PRINT B(2)
290 END SUB
