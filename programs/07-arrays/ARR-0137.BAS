1 REM FBCS ARR-0137
2 REM CLAIM D-7.1-1
3 REM TYPE SELF
100 REM DEFAULT MAX LENGTH OF A STRING ARRAY ELEMENT WITHOUT LENGTH-MAX (7.1.4 l.3066, App C 7.1)
110 DIM B$(2)
120 LET S$ = ""
130 FOR I = 1 TO 200
140   LET S$ = S$ & "x"
150 NEXT I
160 LET B$(1) = S$
170 IF LEN(B$(1)) = 200 AND MAXLEN(B$) = 1000000000 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; LEN(B$(1)); &
&MAXLEN(B$)
180 END
