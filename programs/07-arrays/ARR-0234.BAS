1 REM FBCS ARR-0234
2 REM CLAIM A-7.3.2-TR89
3 REM TYPE SELF
4 REM Control for ARR-0231 to ARR-0233: only the number of dimensions is a load-time rule; sizes are checked at run time.
100 REM THE SIZE MISMATCH OF TWO CONCATENATED STRING-ARRAYS OF THE SAME DIMENSIONALITY IS STILL A RUN-TIME 6101 (7.3.4)
110 DIM A$(2), B$(3), C$(2)
120 LET OK = 0
130 WHEN EXCEPTION IN
140   MAT C$ = A$ & B$
150 USE
160   IF EXTYPE = 6101 THEN LET OK = 1
170 END WHEN
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
