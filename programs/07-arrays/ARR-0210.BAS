1 REM FBCS ARR-0210
2 REM CLAIM D-5.2-1
3 REM TYPE SELF
100 REM MAT PRINT AND MAT PRINT USING OF ELEMENTS NEVER ASSIGNED PRINT THE VALUE 0, THE STATEMENT
105 REM COMPLETES AND EXECUTION CONTINUES (5.2.4, 5.2.6, 10.5.4.5; 3101 IS NONFATAL, 4.1 L.1360-1368)
107 REM NO USER HANDLER HANDLES THE EXCEPTION, SO THE DEFAULT RECOVERY APPLIES. THE PRINTED VALUES
108 REM ARE READ BACK FROM A FILE, SO THE TEST DOES NOT DEPEND ON THE TEXT OF ANY REPORT (SEE ARR-0213, ARR-0214)
110 DIM M(2), N(2,2)
120 LET N(1,2) = 7
130 OPEN #1: NAME "ARR0210.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
140 MAT PRINT #1: M
150 MAT PRINT #1: N
160 MAT PRINT #1: M
170 MAT PRINT #1, USING "##": M
180 CLOSE #1
190 OPEN #2: NAME "ARR0210.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
200 LET T$ = ""
210 WHEN EXCEPTION IN
220   DO
230     LINE INPUT #2: A$
240     FOR I = 1 TO LEN(A$)
250       IF A$(I:I) > " " THEN LET T$ = T$ & A$(I:I)
260     NEXT I
270   LOOP
280 USE
290 REM END OF FILE REACHED
300 END WHEN
310 CLOSE #2
320 REM LAYOUT (BLANKS, LINE BREAKS) IS IGNORED: M, N BY ROWS (0 7, 0 0), M, M WITH USING GIVE ZEROS AND THE ONE 7
330 IF T$ = "0007000000" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; T$
340 END
