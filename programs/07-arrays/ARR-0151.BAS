1 REM FBCS ARR-0151
2 REM CLAIM A-7.2.4.1-01
3 REM TYPE SELF
100 REM MAT A = EXPRESSION EVALUATES THE EXPRESSION AND STORES IT (7.2.4.1 l.3202)
110 DIM A(2,2), B(2,2), C(2,2)
120 MAT B = ZER(2,2)
130 LET B(1,1)=1
140 LET B(1,2)=2
150 LET B(2,1)=3
160 LET B(2,2)=4
170 MAT C = ZER(2,2)
180 LET C(1,1)=5
190 LET C(1,2)=6
200 LET C(2,1)=7
210 LET C(2,2)=8
220 MAT A = B + C
230 IF A(1,1) = 6 AND A(1,2) = 8 AND A(2,1) = 10 AND A(2,2) = 12 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"; A(1,1); A(2,2)
240 END
