1 REM FBCS ARR-0191
2 REM CLAIM A-7.3.4-08
3 REM TYPE SELF
100 REM A SUBSTRING QUALIFIER ON AN ARRAY OPERAND EXTRACTS THAT SUBSTRING FROM EVERY ELEMENT (7.3.4 l.3422-3424)
110 DIM A$(3), C$(3)
120 LET A$(1) = "abcdef"
130 LET A$(2) = "ghijkl"
140 LET A$(3) = "mnopqr"
150 MAT C$ = A$(2:4)
160 IF C$(1) = "bcd" AND C$(2) = "hij" AND C$(3) = "nop" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; C$(1); &
&C$(2); C$(3)
170 END
