3 REM TYPE OUTPUT
4 REM STD 7.1.4 l.3056-3058, 5.6.4 l.2294-2295: DIM/DECLARE in an uncalled internal routine of an EXTERNAL unit.
100 DECLARE EXTERNAL SUB E
110 CALL E(1)
120 CALL E(2)
130 END
200 EXTERNAL SUB E(N)
210 SUB S
220   DIM B(3)
230 END SUB
240 SUB T
250   DECLARE NUMERIC C(2)
260 END SUB
