1 REM FBCS ARR-0296
2 REM CLAIM A-7.1.2-TR103
3 REM TYPE SELF
4 REM STD 7.1.2 l.2997-2999, 9.2.4.2 l.4733-4738: a DIM inside an internal routine is seen from the main.
100 REM DIM INSIDE INTERNAL ROUTINES, USED AFTER THEM IN THE MAIN AND IN A LATER ROUTINE
110 LET OK = 1
120 SUB S
130   DIM B(3)
140   LET B(2) = 4
150 END SUB
160 FUNCTION F(X)
170   DIM C(4), D$(2)
180   LET C(1) = X
190   LET D$(1) = "hi"
200   LET F = X
210 END FUNCTION
220 SUB T
230   LET B(3) = B(2) + C(1)
240 END SUB
250 CALL S
260 LET Y = F(2)
270 CALL T
280 IF B(2) <> 4 OR UBOUND(B) <> 3 THEN LET OK = 0
290 IF C(1) <> 2 OR UBOUND(C) <> 4 THEN LET OK = 0
300 IF D$(1) <> "hi" OR UBOUND(D$) <> 2 THEN LET OK = 0
310 IF B(3) <> 6 THEN LET OK = 0
320 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
330 END
