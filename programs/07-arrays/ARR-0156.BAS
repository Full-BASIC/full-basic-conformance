1 REM FBCS ARR-0156
2 REM CLAIM A-7.2.4.2-03
3 REM TYPE SELF
100 REM A VECTOR OF M ELEMENTS TIMES AN M BY N MATRIX GIVES A VECTOR OF N (7.2.4.2 l.3236-3238)
110 DIM X(3), M(3,2), Y(2)
120 LET X(1)=1
130 LET X(2)=2
140 LET X(3)=3
150 MAT M = ZER(3,2)
160 LET M(1,1)=1
170 LET M(1,2)=0
180 LET M(2,1)=0
190 LET M(2,2)=1
200 LET M(3,1)=1
210 LET M(3,2)=1
220 MAT Y = X * M
230 IF SIZE(Y) = 2 AND Y(1) = 4 AND Y(2) = 5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; SIZE(Y); Y(1); Y(2)
240 END
