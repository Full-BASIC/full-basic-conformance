1 REM FBCS ARR-0363
2 REM CLAIM A-7.1.2-TR139
3 REM TYPE OUTPUT
4 REM STD 9.2.4.2 l.4726-4739, 7.1.4 l.3056-3058: a DIM in an IF in a FOR of an internal FUNCTION belongs to the unit.
10 FUNCTION F
20 FOR I = 1 TO 2
30 IF I = 1 THEN
40 DIM Z(2)
50 END IF
60 LET Z(I) = I + 5
70 NEXT I
80 LET F = 1
90 END FUNCTION
100 LET X = F
110 PRINT Z(1); Z(2)
120 END
