1 REM FBCS ARR-0141
2 REM CLAIM A-7.2.2-01
3 REM TYPE SELF
100 REM A REDIM LIST OF CON/IDN/ZER HOLDS ONE, TWO OR THREE BOUNDS (7.2.2 l.3164)
110 DIM A(4), B(3,3), C(2,2,2)
120 MAT A = CON(4)
130 MAT B = ZER(3,3)
140 MAT C = CON(2,2,2)
150 IF SIZE(A) = 4 AND SIZE(B,1) = 3 AND SIZE(B,2) = 3 AND SIZE(C,3) = 2 AND A(1) = 1 AND B(2,2) = 0 AND C(1,2,2) = 1 THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
160 END
