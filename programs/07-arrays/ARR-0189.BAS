1 REM FBCS ARR-0189
2 REM CLAIM A-7.3.4-06
3 REM TYPE SELF
100 REM CONCATENATING TWO STRING ARRAYS JOINS CORRESPONDING ELEMENTS, EQUAL SIZE IN EVERY DIMENSION (7.3.4 l.3417-3419)
110 DIM A$(2), B$(2), C$(2)
120 LET A$(1) = "AB"
130 LET A$(2) = "CD"
140 LET B$(1) = "x"
150 LET B$(2) = "y"
160 MAT C$ = A$ & B$
170 IF C$(1) = "ABx" AND C$(2) = "CDy" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; C$(1); C$(2)
180 END
