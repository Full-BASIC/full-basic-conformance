1 REM FBCS ARR-0168
2 REM CLAIM A-7.2.4.3-08
3 REM TYPE SELF
100 REM A SCALAR MULTIPLIER REPLACES EVERY NONZERO ELEMENT OF CON, IDN OR ZER (7.2.4.3 l.3279-3282)
110 DIM A(2,2)
120 MAT A = 5 * CON(2,2)
130 LET OK = 1
140 IF A(1,1) <> 5 OR A(2,2) <> 5 THEN LET OK = 0
150 MAT A = 7 * IDN(2,2)
160 IF A(1,1) <> 7 OR A(2,2) <> 7 OR A(1,2) <> 0 THEN LET OK = 0
170 MAT A = 9 * ZER(2,2)
180 IF A(1,1) <> 0 OR A(2,2) <> 0 THEN LET OK = 0
190 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
