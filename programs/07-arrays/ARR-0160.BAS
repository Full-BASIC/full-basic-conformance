1 REM FBCS ARR-0160
2 REM CLAIM A-7.2.4.2-07
3 REM TYPE SELF
100 REM AN UNDERFLOW IN A MAT EXPRESSION GIVES ZERO AND DOES NOT STOP THE PROGRAM (7.2.4.2 l.3248-3250)
110 DIM A(2), B(2)
120 LET B(1) = 1E-300
130 LET B(2) = 2E-300
140 MAT A = 1E-300 * B
150 IF A(1) = 0 AND A(2) = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; A(1); A(2)
160 END
