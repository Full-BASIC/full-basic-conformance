1 REM FBCS ARR-0303
2 REM CLAIM A-7.2.2-TR106
3 REM TYPE OUTPUT
4 REM STD 7.2.2 l.3166-3168, 7.2.4.3 l.3266-3275: IDN, IDN(n) and IDN(n,n) on a two-dimensional array are valid.
100 PRINT "ARR-0303 IDN ON A MATRIX"
110 DIM M(3,3)
120 MAT M = IDN
130 MAT M = IDN(2)
140 MAT M = IDN(2,2)
150 PRINT UBOUND(M,1); UBOUND(M,2); M(1,1); M(1,2); M(2,2)
160 END
