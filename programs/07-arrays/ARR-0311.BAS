1 REM FBCS ARR-0311
2 REM CLAIM A-9.2.4.2-TR116
3 REM TYPE OUTPUT
4 REM STD 9.2.4.1 l.4664-4671, 9.2.4.2 l.4733-4738: an array parameter of an EXTERNAL unit is used by its internal SUB.
100 DECLARE EXTERNAL SUB E
110 DIM A(2)
120 LET A(1) = 4
130 CALL E(A)
140 PRINT A(1); A(2)
150 END
200 EXTERNAL SUB E(V())
210 SUB S
220   PRINT UBOUND(V)
230   LET V(2) = V(1) + 1
240 END SUB
250 CALL S
260 END SUB
