1 REM FBCS ARR-0193
2 REM CLAIM A-7.3.4-10
3 REM TYPE SELF
100 REM NUL$ MAKES AN ARRAY OF EMPTY STRINGS WITH THE SAME REDIM RULES AS NUMERIC VALUES (7.3.4 l.3440-3447)
110 DIM F$(5), G$(2,3)
120 LET OK = 1
130 MAT F$ = NUL$(3)
140 IF SIZE(F$) <> 3 OR LEN(F$(1)) <> 0 THEN LET OK = 0
150 MAT F$ = NUL$
160 IF SIZE(F$) <> 3 THEN LET OK = 0
170 MAT G$ = NUL$(2,2)
180 IF SIZE(G$,1) <> 2 OR SIZE(G$,2) <> 2 OR LEN(G$(1,1)) <> 0 THEN LET OK = 0
190 WHEN EXCEPTION IN
200   MAT F$ = NUL$(5 TO 2)
210   LET OK = 0
220 USE
230   IF EXTYPE <> 6005 THEN LET OK = 0
240 END WHEN
250 WHEN EXCEPTION IN
260   MAT F$ = NUL$(9)
270   LET OK = 0
280 USE
290   IF EXTYPE <> 5001 THEN LET OK = 0
300 END WHEN
310 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
320 END
