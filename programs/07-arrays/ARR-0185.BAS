1 REM FBCS ARR-0185
2 REM CLAIM A-7.3.4-02
3 REM TYPE SELF
100 REM A STRING TARGET IS RESIZED TO THE SHAPE OF THE VALUE AND KEEPS ITS DIMENSION COUNT (7.3.4 l.3392-3394)
110 DIM D$(4,4), E$(2,3)
120 MAT E$ = NUL$(2,3)
130 MAT D$ = E$
140 IF SIZE(D$,1) = 2 AND SIZE(D$,2) = 3 AND SIZE(D$) = 6 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; &
&SIZE(D$,1); SIZE(D$,2)
150 END
