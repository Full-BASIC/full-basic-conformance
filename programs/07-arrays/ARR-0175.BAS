1 REM FBCS ARR-0175
2 REM CLAIM E-6005
3 REM TYPE SELF
100 REM REDIM FIRST INDEX GREATER THAN SECOND, OR SINGLE INDEX BELOW THE DEFAULT LOWER BOUND, RAISES 6005 (7.2.5 l.3309, l.3312)
110 DIM D(9)
120 LET OK = 1
130 WHEN EXCEPTION IN
140   MAT D = ZER(5 TO 2)
150   LET OK = 0
160 USE
170   IF EXTYPE <> 6005 THEN LET OK = 0
180 END WHEN
190 WHEN EXCEPTION IN
200   MAT D = ZER(0)
