1 REM FBCS ARR-0135
2 REM CLAIM A-7.1.4-16
3 REM TYPE SELF
100 REM UBOUND(A,N) ROUNDS N TO THE NEAREST INTEGER (7.1.4 l.3084)
110 DIM B(2 TO 4, 5 TO 9)
120 LET OK = 1
130 IF UBOUND(B,1) <> 4 OR UBOUND(B,2) <> 9 THEN LET OK = 0
140 WHEN EXCEPTION IN
150   LET X = UBOUND(B,2.4)
160   IF X <> 9 THEN LET OK = 0
170 USE
180   LET OK = 0
190 END WHEN
200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
