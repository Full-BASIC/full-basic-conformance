1 REM FBCS ARR-0312
2 REM CLAIM A-9.2.4.2-TR117
3 REM TYPE OUTPUT
4 REM STD 9.2.4.2 l.4726-4738, 7.1.4 l.3056-3058: the array of an internal SUB of an EXTERNAL unit exists in every invocation.
100 DECLARE EXTERNAL SUB E
110 CALL E(1)
120 CALL E(2)
130 END
200 EXTERNAL SUB E(N)
210 SUB S
220   DIM B(2)
230 END SUB
240 CALL S
250 LET B(1) = N
260 PRINT B(1); UBOUND(B)
270 END SUB
