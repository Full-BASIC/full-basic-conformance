1 REM FBCS ARR-0171
2 REM CLAIM A-7.2.4.4-03
3 REM TYPE SELF
100 REM DET RETURNS THE DETERMINANT OF A SQUARE MATRIX (7.2.4.4 l.3293)
110 DIM A(2,2)
120 MAT A = ZER(2,2)
130 LET A(1,1)=1
140 LET A(1,2)=2
150 LET A(2,1)=3
160 LET A(2,2)=4
170 IF ABS(DET(A)+2) < 1E-12 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; DET(A)
180 END
