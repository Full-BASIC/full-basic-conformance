1 REM FBCS ARR-0170
2 REM CLAIM A-7.2.4.4-02
3 REM TYPE SELF
100 REM INV RETURNS THE INVERSE OF A SQUARE MATRIX (7.2.4.4 l.3290)
110 DIM A(2,2), B(2,2)
120 MAT A = ZER(2,2)
130 LET A(1,1)=1
140 LET A(1,2)=2
150 LET A(2,1)=3
160 LET A(2,2)=4
170 MAT B = INV(A)
180 IF ABS(B(1,1)+2) < 1E-12 AND ABS(B(1,2)-1) < 1E-12 AND ABS(B(2,1)-1.5) < 1E-12 AND ABS(B(2,2)+0.5) < 1E-12 THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; B(1,1); B(2,2)
190 END
