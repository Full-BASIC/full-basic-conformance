1 REM FBCS ARR-0230
2 REM CLAIM A-10.5.4.1-08
3 REM TYPE SELF
100 REM MAT READ WITH INSUFFICIENT DATA WORKS LIKE READ (10.5.4.1 L.5958-5960, 10.1.4 L.5008-5025): THE VALUES ARE
102 REM ASSIGNED ONE BY ONE AND THE POINTER ADVANCES BEYOND EACH DATUM (L.5935-5943), SO THE DATA THAT ARE PRESENT
104 REM ARE ASSIGNED AND CONSUMED WHEN THE EXCEPTION (8001) OR THE MISSING-RECOVERY COMES. CASES: IF MISSING,
106 REM 8001 IN A WHEN BLOCK, TWO ARRAYS, A REDIM, A STRING ARRAY; AFTER EACH ONE THE POINTER IS AT THE END
110 DIM B(5), C(2), D(3), E(6), F(5), S$(4)
120 LET BAD = 0
130 DATA 1, 2, 3
200 REM CASE 1: IF MISSING
210 MAT B = ZER
220 RESTORE
230 MAT READ IF MISSING THEN 260: B
240 LET BAD = BAD + 1
250 PRINT "FAILED CASE 1: NO MISSING"
260 IF NOT (B(1) = 1 AND B(2) = 2 AND B(3) = 3 AND B(4) = 0 AND B(5) = 0) THEN
270   LET BAD = BAD + 1
280   PRINT "FAILED CASE 1: VALUES"
290 END IF
300 READ IF MISSING THEN 330: X
310 LET BAD = BAD + 1
320 PRINT "FAILED CASE 1: POINTER"
330 REM CASE 2: 8001 HANDLED BY A WHEN BLOCK
340 MAT F = ZER
350 RESTORE
360 LET HIT = 0
370 WHEN EXCEPTION IN
380   MAT READ F
390 USE
400   LET HIT = EXTYPE
410 END WHEN
420 IF NOT (HIT = 8001 AND F(1) = 1 AND F(2) = 2 AND F(3) = 3 AND F(4) = 0 AND F(5) = 0) THEN
430   LET BAD = BAD + 1
440   PRINT "FAILED CASE 2: VALUES"
450 END IF
460 READ IF MISSING THEN 490: X
470 LET BAD = BAD + 1
480 PRINT "FAILED CASE 2: POINTER"
490 REM CASE 3: TWO ARRAYS, THE SECOND ONE RUNS OUT
500 MAT C = ZER
510 MAT D = ZER
520 RESTORE
530 MAT READ IF MISSING THEN 560: C, D
540 LET BAD = BAD + 1
550 PRINT "FAILED CASE 3: NO MISSING"
560 IF NOT (C(1) = 1 AND C(2) = 2 AND D(1) = 3 AND D(2) = 0 AND D(3) = 0) THEN
570   LET BAD = BAD + 1
580   PRINT "FAILED CASE 3: VALUES"
590 END IF
600 REM CASE 4: A REDIM, THEN IF MISSING
610 MAT E = ZER
620 RESTORE
630 MAT READ IF MISSING THEN 660: E(5)
640 LET BAD = BAD + 1
650 PRINT "FAILED CASE 4: NO MISSING"
660 IF NOT (UBOUND(E) = 5 AND E(1) = 1 AND E(2) = 2 AND E(3) = 3) THEN
670   LET BAD = BAD + 1
680   PRINT "FAILED CASE 4: VALUES"
690 END IF
700 REM CASE 5: A STRING ARRAY
710 MAT S$ = NUL$
720 RESTORE
730 MAT READ IF MISSING THEN 760: S$
740 LET BAD = BAD + 1
750 PRINT "FAILED CASE 5: NO MISSING"
760 IF NOT (S$(1) = "1" AND S$(2) = "2" AND S$(3) = "3" AND S$(4) = "") THEN
770   LET BAD = BAD + 1
780   PRINT "FAILED CASE 5: VALUES"
790 END IF
9000 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
9010 END
