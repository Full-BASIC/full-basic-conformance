1 REM FBCS ARR-0173
2 REM CLAIM E-6001
3 REM TYPE SELF
100 REM SIZES NOT FITTING MATRIX ALGEBRA IN A MAT EXPRESSION RAISE 6001 (7.2.5 l.3302)
110 DIM A(2,3), B(2,2), C(2,2)
120 MAT A = ZER(2,3)
130 MAT B = ZER(2,2)
140 WHEN EXCEPTION IN
150   MAT C = A * B
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = 6001 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 END
