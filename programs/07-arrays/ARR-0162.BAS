1 REM FBCS ARR-0162
2 REM CLAIM A-7.2.4.3-03
3 REM TYPE SELF
100 REM AGREED INTERPRETATION OF 7.2.4: A SINGLE INDEX IS THE UPPER BOUND
110 REM WITH THE DEFAULT LOWER BOUND; index TO index GIVES BOTH BOUNDS OF THE ARRAY-VALUE
120 REM (7.2.4.3 l.3258-3265) BUT THE DESTINATION KEEPS ITS LOWER BOUND (7.2.4.1 l.3210-3214)
130 DIM Z(8)
140 MAT Z = CON(3)
150 MAT Z = ZER(2 TO 5)
160 IF LBOUND(Z) = 1 AND UBOUND(Z) = 4 AND SIZE(Z) = 4 AND Z(1) = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"; LBOUND(Z); UBOUND(Z); SIZE(Z)
170 END
