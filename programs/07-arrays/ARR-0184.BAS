1 REM FBCS ARR-0184
2 REM CLAIM A-7.3.4-01
3 REM TYPE SELF
100 REM MAT A$ = EXPRESSION EVALUATES THE STRING ARRAY EXPRESSION AND STORES IT (7.3.4 l.3389)
110 DIM A$(2), B$(2)
120 LET B$(1) = "one"
130 LET B$(2) = "two"
140 MAT A$ = B$
150 IF A$(1) = "one" AND A$(2) = "two" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; A$(1); A$(2)
160 END
