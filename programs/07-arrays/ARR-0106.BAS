1 REM FBCS ARR-0106
2 REM CLAIM A-7.1.4-06
3 REM TYPE SELF
100 PRINT "ARR-0106 MAXSIZE OF AN UNCHANGED ARRAY (7.1.4)"
110 DIM A(10), B(4, 5), C(0 TO 2)
120 IF MAXSIZE(A) <> 10 THEN PRINT "*** TEST FAILED: A"; MAXSIZE(A)
130 IF MAXSIZE(B) <> 20 THEN PRINT "*** TEST FAILED: B"; MAXSIZE(B)
140 IF MAXSIZE(C) = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: C"; MAXSIZE(C)
150 END
