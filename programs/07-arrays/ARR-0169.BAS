1 REM FBCS ARR-0169
2 REM CLAIM A-7.2.4.4-01
3 REM TYPE SELF
100 REM TRN RETURNS THE TRANSPOSE: M BY N GIVES N BY M (7.2.4.4 l.3286-3288)
110 DIM A(2,3), T(3,2)
120 MAT A = ZER(2,3)
130 LET A(1,1)=1
140 LET A(1,2)=2
150 LET A(1,3)=3
160 LET A(2,1)=4
170 LET A(2,2)=5
180 LET A(2,3)=6
190 MAT T = TRN(A)
200 IF SIZE(T,1) = 3 AND SIZE(T,2) = 2 AND T(1,1) = 1 AND T(2,1) = 2 AND T(3,1) = 3 AND T(1,2) = 4 AND T(3,2) = 6 THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; SIZE(T,1); SIZE(T,2); T(3,2)
210 END
