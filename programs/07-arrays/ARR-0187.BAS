1 REM FBCS ARR-0187
2 REM CLAIM A-7.3.4-04
3 REM TYPE SELF
100 REM A SUBSTRING QUALIFIER ON THE TARGET REPLACES ONLY THE SELECTED PART OF EACH ELEMENT (7.3.4 l.3409-3412)
110 DIM A$(2), B$(2)
120 LET A$(1) = "ABCDE"
130 LET A$(2) = "VWXYZ"
140 LET B$(1) = "xy"
150 LET B$(2) = "pq"
160 MAT A$(2:3) = "-" & B$
170 IF A$(1) = "A-xyDE" AND A$(2) = "V-pqYZ" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; A$(1); A$(2)
180 END
