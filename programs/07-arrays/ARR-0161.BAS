1 REM FBCS ARR-0161
2 REM CLAIM A-7.2.4.3-01
3 REM TYPE SELF
100 REM CON, IDN OR ZER WITHOUT REDIM HAVE THE SIZE OF THE TARGET (7.2.4.3 l.3254-3257)
110 DIM A(4,4), B(2,3), Z(3,3)
120 MAT A = CON
130 MAT B = ZER
140 MAT Z = IDN
150 IF SIZE(A,1) = 4 AND SIZE(A,2) = 4 AND A(2,2) = 1 AND SIZE(B,1) = 2 AND SIZE(B,2) = 3 AND B(1,1) = 0 AND SIZE(Z,1) = 3 AND &
&Z(1,1) = 1 AND Z(1,2) = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
160 END
