1 REM FBCS ARR-0159
2 REM CLAIM A-7.2.4.2-06
3 REM TYPE SELF
100 REM IN MAT A = W*B THE SCALAR W IS EVALUATED FIRST AND MULTIPLIES EVERY ELEMENT OF B (7.2.4.2 l.3244-3246)
110 DIM B(2,2), A(2,2)
120 MAT B = ZER(2,2)
130 LET B(1,1)=1
140 LET B(1,2)=2
150 LET B(2,1)=3
160 LET B(2,2)=4
170 MAT A = 3 * B
180 LET W = 5
190 MAT A = (W) * B
200 IF A(1,1) = 5 AND A(1,2) = 10 AND A(2,1) = 15 AND A(2,2) = 20 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"; A(1,1); A(2,2)
210 END
