1 REM FBCS ARR-0190
2 REM CLAIM A-7.3.4-07
3 REM TYPE SELF
100 REM CONCATENATING A SCALAR WITH AN ARRAY PREFIXES OR SUFFIXES EVERY ELEMENT (7.3.4 l.3419-3421)
110 DIM A$(2), C$(2)
120 LET A$(1) = "AB"
130 LET A$(2) = "CD"
140 MAT C$ = "N-" & A$
150 MAT C$ = A$ & "-S"
160 IF C$(1) = "AB-S" AND C$(2) = "CD-S" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; C$(1); C$(2)
170 END
