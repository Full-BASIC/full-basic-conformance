1 REM FBCS ARR-0220
2 REM CLAIM A-10.5.4.1-07
3 REM TYPE SELF
100 REM MAT READ ASSIGNS THE DATA ONE BY ONE, IN ROW MAJOR ORDER, LIKE READ (10.1.4 L.5008-5015, 10.5.4.1 L.5938-5943):
102 REM A STRING DATUM LONGER THAN THE LENGTH-MAX (1053, L.6103-6104) OR A NONNUMERIC DATUM FOR A NUMERIC ARRAY (8101)
104 REM STOPS THE STATEMENT AT THAT ELEMENT AND THE ELEMENTS BEFORE IT STAY ASSIGNED; CASES: 1-D, 2-D, 3-D,
106 REM TWO ARRAYS, A NUMERIC ARRAY, AND WITH IF MISSING
110 DECLARE STRING D$(3)*2, E$(2,2)*2, F$(2,2,2)*2, A$(2)*2, B$(2)*2, G$(3)*2
120 LET BAD = 0
130 DIM N(3), M(3)
140 MAT D$ = NUL$
150 MAT E$ = NUL$
160 MAT F$ = NUL$
170 MAT A$ = NUL$
180 MAT B$ = NUL$
190 MAT G$ = NUL$
200 RESTORE 8100
210 LET CASE = 1
220 WHEN EXCEPTION IN
230   MAT READ D$
240 USE
250   IF NOT (EXTYPE = 1053 AND D$(1) = "ab" AND D$(2) = "" AND D$(3) = "") THEN
260     LET BAD = BAD + 1
270     PRINT "FAILED CASE"; CASE
280   END IF
290 END WHEN
300 RESTORE 8200
310 LET CASE = 2
320 WHEN EXCEPTION IN
330   MAT READ E$
340 USE
350   IF NOT (EXTYPE = 1053 AND E$(1,1) = "ab" AND E$(1,2) = "cd" AND E$(2,1) = "ef" AND E$(2,2) = "") THEN
360     LET BAD = BAD + 1
370     PRINT "FAILED CASE"; CASE
380   END IF
390 END WHEN
400 RESTORE 8300
410 LET CASE = 3
420 WHEN EXCEPTION IN
430   MAT READ F$
440 USE
450   IF NOT (EXTYPE = 1053 AND F$(1,1,1) = "ab" AND F$(1,1,2) = "cd" AND F$(1,2,1) = "ef" AND F$(1,2,2) = "") THEN
460     LET BAD = BAD + 1
470     PRINT "FAILED CASE"; CASE
480   END IF
490 END WHEN
500 RESTORE 8400
510 LET CASE = 4
520 WHEN EXCEPTION IN
530   MAT READ A$, B$
540 USE
550   IF NOT (EXTYPE = 1053 AND A$(1) = "ab" AND A$(2) = "cd" AND B$(1) = "ef" AND B$(2) = "") THEN
560     LET BAD = BAD + 1
570     PRINT "FAILED CASE"; CASE
580   END IF
590 END WHEN
600 RESTORE 8500
610 LET CASE = 5
620 WHEN EXCEPTION IN
630   MAT READ N
640 USE
650   IF NOT (EXTYPE = 8101 AND N(1) = 5 AND N(2) = 0 AND N(3) = 0) THEN
660     LET BAD = BAD + 1
670     PRINT "FAILED CASE"; CASE
680   END IF
690 END WHEN
700 RESTORE 8600
710 LET CASE = 6
720 WHEN EXCEPTION IN
730   MAT READ IF MISSING THEN 9000: M
740 USE
750   IF NOT (EXTYPE = 8101 AND M(1) = 5 AND M(2) = 0 AND M(3) = 0) THEN
760     LET BAD = BAD + 1
770     PRINT "FAILED CASE"; CASE
780   END IF
790 END WHEN
800 RESTORE 8700
810 LET CASE = 7
820 WHEN EXCEPTION IN
830   MAT READ IF MISSING THEN 9000: G$
840 USE
850   IF NOT (EXTYPE = 1053 AND G$(1) = "ab" AND G$(2) = "" AND G$(3) = "") THEN
860     LET BAD = BAD + 1
870     PRINT "FAILED CASE"; CASE
880   END IF
890 END WHEN
8100 DATA "ab", "cde", "fg"
8200 DATA "ab", "cd", "ef", "ghi"
8300 DATA "ab", "cd", "ef", "ghi", "x", "x", "x", "x"
8400 DATA "ab", "cd", "ef", "ghi"
8500 DATA 5, "x", 3
8600 DATA 5, "x", 3
8700 DATA "ab", "cde", "fg"
9000 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
9010 END
