1 REM FBCS ARR-0245
2 REM CLAIM A-7.2.2-TR94
3 REM TYPE OUTPUT
4 REM STD 7.2.2 l.3166-3168, 7.3.2 l.3373-3375, 10.5.2 l.5911: redims with the same number of dimensions as the array are valid.
100 PRINT "ARR-0245 REDIMS WITH MATCHING DIMENSIONALITY"
110 DIM A(3,3), V(5), S$(2,3)
120 MAT A = ZER(2,2)
130 MAT A = 2 * CON(3,2)
140 MAT V = ZER(3)
150 MAT S$ = NUL$(2,2)
160 PRINT UBOUND(A,1); UBOUND(A,2); A(3,2); UBOUND(V); UBOUND(S$,1); UBOUND(S$,2)
170 END
