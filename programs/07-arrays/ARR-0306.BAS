1 REM FBCS ARR-0306
2 REM CLAIM A-7.1.2-TR109
3 REM TYPE SELF
4 REM STD 7.1.2 l.2997-2999, 9.1.4.3 l.4389-4394: a DIM in an internal routine of an EXTERNAL unit is seen from the unit body.
100 DECLARE EXTERNAL SUB E
110 DECLARE EXTERNAL FUNCTION F$
120 DECLARE EXTERNAL PICTURE Q
130 LET OK = 1
140 CALL E
150 IF F$(1) <> "xy" THEN LET OK = 0
160 DRAW Q
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
200 EXTERNAL SUB E
210 SUB S
220   DIM B(3)
230   LET B(2) = 4
240 END SUB
250 SUB T
260   LET B(3) = B(2) + 1
270 END SUB
280 CALL S
290 CALL T
300 IF B(3) <> 5 OR UBOUND(B) <> 3 THEN PRINT "*** TEST FAILED ***"
310 END SUB
400 EXTERNAL FUNCTION F$(N)
410 SUB S
420   DIM W$(2)
430   LET W$(1) = "x"
440 END SUB
450 CALL S
460 LET F$ = W$(1) & "y"
470 END FUNCTION
500 EXTERNAL PICTURE Q
510 PICTURE P
520   DIM C(2)
530   LET C(1) = 6
540 END PICTURE
550 DRAW P
560 IF C(1) <> 6 OR UBOUND(C) <> 2 THEN PRINT "*** TEST FAILED ***"
570 END PICTURE
