1 REM FBCS ECMA-0104
2 REM CLAIM A-ECMA-41
3 REM TYPE SELF
4 REM ECMA 15.2.3 ex. 6 and 7: fixed-defined functions with fixed parameters, accepted under ARITHMETIC FIXED (15.2.2)
100 OPTION ARITHMETIC FIXED*8.2
110 DECLARE EXTERNAL FUNCTION ANSWER*1
120 DEF AVERAGE*10.3 (X*10.3, Y*10.3) = (X+Y)/2
130 IF AVERAGE(1, 2) = 1.5 AND AVERAGE(1, 2.0004) = 1.5 AND ANSWER("Y") = 7 THEN
140    PRINT "*** TEST PASSED ***"
150 ELSE
160    PRINT "*** TEST FAILED:"; AVERAGE(1, 2); AVERAGE(1, 2.0004); ANSWER("Y")
170 END IF
180 END
190 EXTERNAL FUNCTION ANSWER*1 (A$)
200 OPTION ARITHMETIC FIXED*8.2
210 IF A$ = "Y" THEN LET ANSWER = 7.4 ELSE LET ANSWER = 0
220 END FUNCTION
