1 REM FBCS ECMA-0071
2 REM CLAIM A-ECMA-30
3 REM TYPE SELF
4 REM ECMA 11.1.3 ex. 18 (ANSI l.6564-6565): in RECSIZE RS$ NUMCHARS, NUMCHARS is the numeric variable of RECSIZE
100 OPEN #3: NAME "ECMA0071.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 40
110 ASK #3: ACCESS AC$, DATUM DI$, NAME NM$, ORGANIZATION ORG$, POINTER P$, RECSIZE RS$ NUMCHARS, RECTYPE RT$
120 CLOSE #3
130 IF NM$ = "ECMA0071.DAT" AND RS$ = "VARIABLE" AND NUMCHARS = 40 AND RT$ = "INTERNAL" THEN
140    PRINT "*** TEST PASSED ***"
150 ELSE
160    PRINT "*** TEST FAILED: ["; NM$; "] ["; RS$; "]"; NUMCHARS; "["; RT$; "]"
170 END IF
180 END
