1 REM FBCS ECMA-0030
2 REM CLAIM A-ECMA-20
3 REM TYPE INPUT
100 DIM A$(5)
110 LET I = 1
120 DO
130 LET IT = I+1
140 PRINT "MORE ENTRIES (ENTER ""NO"" IF NONE)"
150 INPUT A$(I)
160 LET I = I + 1
170 LOOP UNTIL A$(I-1) = "NO"
180 IF A$(1) = "ONE" AND A$(2) = "NO" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
