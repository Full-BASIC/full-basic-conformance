1 REM FBCS ECMA-0103
2 REM CLAIM A-ECMA-41
3 REM TYPE SELF
4 REM ECMA 15.2.3 ex. 3 and 5: fixed formal arrays and a fixed function, accepted under ARITHMETIC FIXED (15.2.2)
100 OPTION ARITHMETIC FIXED*8.2
110 DECLARE NUMERIC V(3)*5.2, W(2, 2)*4.4
120 FUNCTION SUMVECTOR*5.2 (V()*5.2)
130    LET SUMVECTOR = V(1) + V(2) + V(3)
140 END FUNCTION
150 MAT V = CON
160 LET V(3) = 1.239
180 CALL T(V, W)
185 LET R = SUMVECTOR(V)
190 IF R = 3.24 AND W(1, 1) = 1.0001 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED:"; R; W(1, 1)
200 SUB T(A()*5.2, B(, )*4.4)
210    LET B(1, 1) = 1.00009
230 END SUB
240 END
