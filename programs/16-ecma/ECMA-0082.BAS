1 REM FBCS ECMA-0082
2 REM CLAIM A-ECMA-33
3 REM TYPE SELF
100 OPEN #3: NAME "ECMA0082.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
110 TEMPLATE: 3 OF STRING*10
120 WRITE #3, WITH 110: "alpha", "beta", "gamma"
130 CLOSE #3
140 OPEN #3: NAME "ECMA0082.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
150 READ #3, WITH 110: T1$, SKIP REST
160 READ #3, SAME, WITH 110: W$, SKIP REST
170 CLOSE #3
180 IF LEN(W$) = 10 AND W$(1:5) = "alpha" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
