1 REM FBCS ECMA-0079
2 REM CLAIM A-ECMA-33
3 REM TYPE SELF
100 OPEN #3: NAME "ECMA0079.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
110 PRINT #3: "1, 2, 3, four"
120 CLOSE #3
130 OPEN #3: NAME "ECMA0079.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
140 INPUT #3: A, B, C, A$
150 CLOSE #3
160 IF A=1 AND B=2 AND C=3 AND A$="four" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
170 END
