1 REM FBCS ECMA-0249
2 REM CLAIM A-ECMA-34
3 REM TYPE SELF
4 REM ECMA 11.5.3 ex. 3: MAT REWRITE of several arrays with WITH; each array takes its own ? OF element (ANSI 11.3.4.12)
100 LET N = 2
110 OPEN #3: NAME "ECMA0249.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
111 TEMPLATE: ? OF NUMERIC*8, ? OF NUMERIC*8, ? OF NUMERIC*8
120 TEMPLATE: 6 OF NUMERIC*8
130 DIM X(2), Y(2), Z(2)
140 WRITE #3, RECORD 1, WITH 120: 0, 0, 0, 0, 0, 0
150 MAT X = CON
160 MAT Y = (2) * CON
170 MAT Z = (3) * CON
180 MAT REWRITE #3, RECORD N-1, WITH 111: X, Y, Z
190 MAT X = ZER
200 MAT Y = ZER
210 MAT Z = ZER
220 MAT READ #3, RECORD 1, WITH 120: X, Y, Z
230 CLOSE #3
240 IF X(2) = 1 AND Y(1) = 2 AND Z(2) = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED:"; X(2); Y(1); Z(2)
250 END
