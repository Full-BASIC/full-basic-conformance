1 REM FBCS ECMA-0081
2 REM CLAIM A-ECMA-33
3 REM TYPE SELF
100 LET G = 4
110 OPEN #G: NAME "ECMA0081.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #G: "line one"
130 PRINT #G: "line two"
140 PRINT #G: "line three"
150 CLOSE #G
160 OPEN #5: NAME "ECMA0081B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
170 PRINT #5: "r1"
180 PRINT #5: "r2"
190 PRINT #5: "r3"
200 CLOSE #5
210 OPEN #G: NAME "ECMA0081.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
220 LINE INPUT #G, NEXT: A$, B$, C$
230 CLOSE #G
240 LET N = 2
250 DIM AS$(1), BS$(5)
260 OPEN #5: NAME "ECMA0081B.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
270 MAT LINE INPUT #5, IF MISSING THEN 300: AS$, BS$(N)
280 CLOSE #5
290 IF A$="line one" AND B$="line two" AND C$="line three" AND AS$(1)="r1" AND BS$(1)="r2" AND BS$(2)="r3" THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
300 GOTO 400
310 LET MISSING = 1
320 GOTO 290
400 END
