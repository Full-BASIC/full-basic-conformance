1 REM FBCS ECMA-0102
2 REM CLAIM A-ECMA-40
3 REM TYPE SELF
4 REM ECMA 15.1.3 ex. 3 is the numeric-type of a DECLARE statement (15.1.2 prod. 3-4); the full form is accepted
100 OPTION ARITHMETIC FIXED*8.2
110 DECLARE NUMERIC*5.2 A, B, C*5.5, D(1 TO 8)*6.6
120 DECLARE NUMERIC E(1 TO 10, 1961 TO 1981)
130 LET A = 1.234
140 LET C = 1.234567
150 LET D(8) = 2.1234567
160 LET E(10, 1981) = 3.456
170 IF A = 1.23 AND C = 1.23457 AND D(8) = 2.123457 AND E(10, 1981) = 3.46 AND UBOUND(E, 2) = 1981 THEN
180    PRINT "*** TEST PASSED ***"
190 ELSE
200    PRINT "*** TEST FAILED:"; A; C; D(8); E(10, 1981)
210 END IF
220 END
