1 REM FBCS ECMA-0043
2 REM CLAIM A-ECMA-22
3 REM TYPE SELF
100 DECLARE EXTERNAL FUNCTION ANSWER
110 IF ANSWER("YES") = 1 AND ANSWER("NO") = 2 AND ANSWER("MAYBE") = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"
120 END
200 EXTERNAL FUNCTION ANSWER(A$)
210 SELECT CASE UCASE$(A$)
220 CASE "YES"
230 LET ANSWER = 1
240 CASE "NO"
250 LET ANSWER = 2
260 CASE ELSE
270 LET ANSWER = 3
280 END SELECT
290 END FUNCTION
