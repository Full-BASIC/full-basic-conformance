1 REM FBCS ECMA-0095
2 REM CLAIM A-ECMA-37
3 REM TYPE GRAPHIC
100 ASK DEVICE SIZE width, height, unit$
110 SET WINDOW 0, PI*2, -1, 1
120 SET VIEWPORT .5*width, width, .5*height, height
130 SET DEVICE WINDOW 0, .8, 0, 1
140 SET DEVICE VIEWPORT .3, .5, .1, 1
150 SET CLIP "OFF"
160 GRAPH LINES: 0,0; 1,1
170 END
