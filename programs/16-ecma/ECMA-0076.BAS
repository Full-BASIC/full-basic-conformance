1 REM FBCS ECMA-0076
2 REM CLAIM A-ECMA-32
3 REM TYPE SELF
100 OPEN #3: NAME "ECMA0076A.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
110 LET A = 1
120 LET B = 2
130 LET C$ = "c"
140 LET D$ = "d"
145 WRITE #3, RECORD 47: 0
150 WRITE #3, RECORD 47, IF THERE THEN 300: A+B, C$ & D$
155 LET DONE = 1
160 LET X = 1
170 LET Y = 3
180 LET Z = 4
190 LET W = 5
200 OPEN #4: NAME "ECMA0076B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
210 TEMPLATE: 3 OF NUMERIC*8
220 WRITE #X+Y, WITH 210: X, Y, Z + W
230 CLOSE #3
240 CLOSE #4
250 IF DONE = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 GOTO 400
300 LET DONE = 1
310 GOTO 250
400 END
