1 REM FBCS ECMA-0077
2 REM CLAIM A-ECMA-32
3 REM TYPE SELF
100 OPEN #3: NAME "ECMA0077.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
110 TEMPLATE: 2 OF NUMERIC*8, 2 OF NUMERIC*8
120 DIM A(2), C(2)
130 MAT A = CON(2)
140 MAT C = ZER(2)
150 MAT WRITE #3, KEY "Whoever", IF THERE THEN 300, WITH 110: A, C
155 LET DONE = 1
160 CLOSE #3
170 IF DONE = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 GOTO 400
300 LET DONE = 1
310 GOTO 170
400 END
