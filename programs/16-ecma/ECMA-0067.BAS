1 REM FBCS ECMA-0067
2 REM CLAIM A-ECMA-30
3 REM TYPE SELF
100 REM OPEN WITH A CHANNEL EXPRESSION AND NAME/ORGANIZATION EXPRESSIONS (11.1.3 EXAMPLES, L.6551-6554)
110 REM AFTER A SUCCESSFUL OPEN THE CHANNEL IS ACTIVE AND ASK REPORTS THE FILE ATTRIBUTES (L.6603-6605, L.6940-6947, TABLE 5)
120 LET N = 3
130 LET A$ = "ECMA0067.DAT"
140 OPEN #N: NAME A$, ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 32
150 ASK #N: NAME NM1$, ACCESS AC1$, ORGANIZATION OR1$, RECTYPE RT1$, RECSIZE RS1$ SZ1
160 CLOSE #N
170 LET F$ = "2"
180 LET ORG$ = "STREAM"
190 OPEN #N+1: NAME "MY" & F$, ORGANIZATION ORG$, ACCESS OUTIN, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 32
200 ASK #4: NAME NM2$, ORGANIZATION OR2$
210 CLOSE #N+1
220 IF NM1$ = A$ AND AC1$ = "OUTIN" AND OR1$ = "STREAM" AND RT1$ = "INTERNAL" AND RS1$ = "VARIABLE" AND SZ1 = 32 &
&AND NM2$ = "MY2" AND OR2$ = "STREAM" THEN
230    PRINT "*** TEST PASSED ***"
240 ELSE
250    PRINT "*** TEST FAILED: ["; NM1$; "] ["; AC1$; "] ["; OR1$; "] ["; RT1$; "] ["; RS1$; "]"; SZ1
251    PRINT "*** TEST FAILED: ["; NM2$; "] ["; OR2$; "]"
260 END IF
270 END
