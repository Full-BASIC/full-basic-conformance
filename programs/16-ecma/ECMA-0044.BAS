1 REM FBCS ECMA-0044
2 REM CLAIM A-ECMA-22
3 REM TYPE SELF
100 DECLARE EXTERNAL FUNCTION AVERAGE, REVERSE$
105 DECLARE FUNCTION TWICE, TAG$
106 LET N = 0
107 IF AVERAGE(2, 4) = 3 AND REVERSE$("abc") = "abc" THEN LET N = N + 1
108 IF TWICE(5) = 10 AND TAG$("x") = "<x>" THEN LET N = N + 1
110 IF N = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
120 FUNCTION TWICE(N)
130 LET TWICE = 2*N
140 END FUNCTION
150 FUNCTION TAG$(S$)
160 LET TAG$ = "<" & S$ & ">"
170 END FUNCTION
180 END
200 EXTERNAL FUNCTION AVERAGE(X, Y)
210 LET AVERAGE = (X+Y)/2
220 END FUNCTION
230 EXTERNAL FUNCTION REVERSE$(S$)
240 LET REVERSE$ = S$
250 END FUNCTION
