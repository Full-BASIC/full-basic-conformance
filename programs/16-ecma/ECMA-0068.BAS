1 REM FBCS ECMA-0068
2 REM CLAIM A-ECMA-30
3 REM TYPE SELF
100 REM CLOSE MAKES THE CHANNEL INACTIVE, SO ASK GIVES NULL STRINGS AND ZERO (L.6902-6904, L.6943-6947)
110 REM CLOSE OF A CHANNEL WITHOUT A FILE HAS NO EFFECT (L.6904-6905); A CLOSED TRUE FILE KEEPS ITS DATA (L.6644-6649)
120 LET N = 3
130 OPEN #N: NAME "ECMA0068.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
140 WRITE #N: 7, "X"
150 ASK #N: NAME NM1$, ACCESS AC1$
160 CLOSE #N
170 ASK #N: NAME NM2$, ACCESS AC2$, RECSIZE RS2$ SZ2
180 CLOSE #N
190 OPEN #N: NAME "ECMA0068.DAT", ACCESS INPUT, ORGANIZATION STREAM, RECTYPE INTERNAL
200 READ #N: V, S$
210 CLOSE #N
220 IF NM1$ = "ECMA0068.DAT" AND AC1$ = "OUTIN" AND NM2$ = "" AND AC2$ = "" AND RS2$ = "" AND SZ2 = 0 AND V = 7 AND S$ = "X" THEN
230    PRINT "*** TEST PASSED ***"
240 ELSE
250    PRINT "*** TEST FAILED: ["; NM1$; "] ["; AC1$; "] ["; NM2$; "] ["; AC2$; "] ["; RS2$; "]"; SZ2; V; "["; S$; "]"
260 END IF
270 END
