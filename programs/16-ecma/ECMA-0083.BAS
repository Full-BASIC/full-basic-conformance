1 REM FBCS ECMA-0083
2 REM CLAIM A-ECMA-33
3 REM TYPE SELF
100 LET N = 3
110 LET W = 1
120 LET Q = 2
130 OPEN #N: NAME "ECMA0083.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
140 TEMPLATE: 3 OF NUMERIC*8
150 TEMPLATE: 1 OF NUMERIC*8, 2 OF NUMERIC*8
160 WRITE #N, RECORD 3, WITH 140: 7, 8, 9
170 CLOSE #N
180 OPEN #N: NAME "ECMA0083.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE NATIVE
190 DIM NN(1), W2(2)
200 MAT READ #N, RECORD W+2, IF MISSING THEN 300, WITH 150: NN, W2
210 CLOSE #N
220 IF NN(1) = 7 AND W2(1) = 8 AND W2(2) = 9 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 GOTO 400
300 LET MISSING = 1
310 GOTO 220
400 END
