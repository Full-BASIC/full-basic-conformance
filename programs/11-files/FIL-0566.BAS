1 REM FBCS FIL-0566
2 REM CLAIM A-11.2.5-CL07
3 REM TYPE INPUT
4 REM STD 11.2.5 l.7303-7304: a record-setter with channel zero is a nonfatal exception 7002; with an active
5 REM handler of the program the exception goes to the handler, otherwise it is reported and execution continues.
100 REM INPUT AND LINE INPUT WITH A RECORD-SETTER ON CHANNEL ZERO, UNDER A HANDLER
110 LET A = 0
120 LET S$ = "-"
130 LET E1 = 0
140 LET E2 = 0
150 WHEN EXCEPTION IN
160   INPUT #0, BEGIN: A
170   LET E1 = -1
180 USE
190   LET E1 = EXTYPE
200 END WHEN
210 WHEN EXCEPTION IN
220   LINE INPUT #0, NEXT: S$
230   LET E2 = -1
240 USE
250   LET E2 = EXTYPE
260 END WHEN
300 REM THE HANDLER RECEIVED 7002 AND NO REPLY WAS READ, SO THE NEXT PLAIN INPUT READS THE FIRST LINE
310 INPUT B
320 LINE INPUT C$
330 REM WITHOUT A HANDLER THE WARNING IS GIVEN AND THE REPLY IS READ, THE RECORD-SETTER BEING IGNORED
340 INPUT #0, END: D
350 LINE INPUT #0, SAME: D$
360 PRINT
370 IF E1 = 7002 AND E2 = 7002 THEN 380 ELSE 900
380 IF A = 0 AND S$ = "-" THEN 390 ELSE 900
390 IF B = 42 AND C$ = "ab" THEN 400 ELSE 900
400 IF D = 7 AND D$ = "cd" THEN 410 ELSE 900
410 PRINT "*** TEST PASSED ***"
420 GOTO 910
900 PRINT "*** TEST FAILED ***"
910 END
