1 REM FBCS FIL-0271
2 REM CLAIM A-11.3.4-TR72
3 REM TYPE SELF
4 REM STD 11.3.4 l.7538-7541 and 11.3.4.8 l.7671-7675: if an exception (here 8301, a
5 REM third-phase exception) prevents the creation of any file-element, the pointer is
6 REM left as the second phase set it. In a KEYED file that is the first greater key
7 REM (STD 11.2.4.1 l.7256-7260) or end of file; in a RELATIVE file, the record area.
10 LET OK = 1
20 DIM M(9)
30 MAT M = ZER
40 OPEN #1: NAME "FIL0271K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 10
50 WRITE #1, KEY "A": 1
60 WRITE #1, KEY "C": 2
70 WRITE #1, KEY "E": 3
100 FOR I = 1 TO 3
110 READ P$, E$, N
120 FOR J = 1 TO 2
130 SET #1: KEY "E"
140 LET X = 0
150 WHEN EXCEPTION IN
160   IF J = 1 THEN WRITE #1, KEY P$: "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
170   IF J = 2 THEN MAT WRITE #1, KEY P$: M
180 USE
190   LET X = EXTYPE
200 END WHEN
210 ASK #1: KEY K$
250 IF X <> 8301 OR K$ <> E$ THEN LET OK = 0
260 IF X <> 8301 OR K$ <> E$ THEN PRINT "FALLO-KEYED"; J; P$; X; " "; K$
270 NEXT J
280 NEXT I
290 CLOSE #1
300 OPEN #2: NAME "FIL0271R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 10
310 WRITE #2, RECORD 1: 1
320 FOR J = 1 TO 2
330 SET #2: RECORD 1
340 LET X = 0
350 WHEN EXCEPTION IN
360   IF J = 1 THEN WRITE #2, RECORD 3: "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
370   IF J = 2 THEN MAT WRITE #2, RECORD 3: M
380 USE
390   LET X = EXTYPE
400 END WHEN
410 ASK #2: RECORD R
420 IF X <> 8301 OR R <> 3 THEN LET OK = 0
430 IF X <> 8301 OR R <> 3 THEN PRINT "FALLO-RELATIVE"; J; X; R
440 NEXT J
450 CLOSE #2
460 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
470 STOP
900 DATA "0", "A", 1
910 DATA "B", "C", 2
920 DATA "F", "", -1
990 END
