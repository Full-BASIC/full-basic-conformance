1 REM FBCS FIL-0134
2 REM CLAIM A-11.4.3-EX
3 REM TYPE SELF
100 PRINT "FIL-0134 ALL FORMS OF THE EXAMPLES OF 11.4.3 ARE ACCEPTED (11.4.3)"
110 LET W = 1
120 LET N = 3
130 LET Q = 6
140 DIM A(5)
145 DIM A$(2)
150 DIM B$(3)
160 DIM C$(8)
170 DIM W2(4)
180 OPEN #3: NAME "FIL0134A.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
190 OPEN #4: NAME "FIL0134B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
200 OPEN #Q: NAME "FIL0134C.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 OPEN #7: NAME "FIL0134D.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
220 PRINT #3: "1,2,3,SA"
230 PRINT #3: "9"
240 FOR I = 1 TO 12
250   PRINT #4: "L" & STR$(I)
260 NEXT I
270 PRINT #Q: "Q1"
280 PRINT #Q: "Q2"
290 PRINT #Q: "Q3"
300 TEMPLATE: 4 OF NUMERIC*3.2
310 WRITE #7, RECORD W+2, WITH 300: 7, 8, 9, 10
318 SET #3: POINTER BEGIN
320 INPUT #3: A1, B1, C1, A1$
330 DO
340   MAT INPUT #3, BEGIN, IF MISSING THEN EXIT DO: A(3), B$(1)
350   EXIT DO
360 LOOP
368 SET #Q: POINTER BEGIN
370 LINE INPUT #Q, NEXT: L1$, L2$, L3$
378 SET #4: POINTER BEGIN
380 MAT LINE INPUT #4, IF MISSING THEN 510: A$(1), B$(N), C$(8)
390 READ #3, SAME: W3$, SKIP REST
400 TEMPLATE: 4 OF NUMERIC*3.2
410 MAT READ #7, RECORD W+2, IF MISSING THEN 500, WITH 400: W2
420 CLOSE #3
430 CLOSE #4
440 CLOSE #Q
450 CLOSE #7
460 IF A1 = 1 AND B1 = 2 AND C1 = 3 AND A1$ = "SA" AND L1$ = "Q1" AND L3$ = "Q3" AND W2(1) = 7 THEN PRINT "*** TEST PASSED ***" &
&ELSE PRINT "*** TEST FAILED ***"
470 GOTO 999
500 PRINT "*** TEST FAILED: 111"
510 PRINT "*** TEST FAILED: 1234"
999 END
