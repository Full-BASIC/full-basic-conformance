1 REM FBCS FIL-0127
2 REM CLAIM A-11.3.4.11-01
3 REM TYPE SELF
100 PRINT "FIL-0127 NATIVE WRITE NEEDS A TEMPLATE AND NO OTHER RECORD TYPE MAY USE ONE (11.3.4.11)"
110 OPEN #1: NAME "FIL0127.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*3.2
130 LET OK1 = 0
140 WHEN EXCEPTION IN
150   WRITE #1: 42
160   PRINT "*** TEST FAILED: NATIVE WITHOUT TEMPLATE ***"
170 USE
180   IF EXTYPE = 7316 THEN LET OK1 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 CLOSE #1
210 OPEN #2: NAME "FIL0127B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
220 TEMPLATE: NUMERIC*3.2
230 LET OK2 = 0
240 WHEN EXCEPTION IN
250   WRITE #2, WITH 220: 1.5
260   PRINT "*** TEST FAILED: TEMPLATE ON DISPLAY ***"
270 USE
280   IF EXTYPE = 7315 THEN LET OK2 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
290 END WHEN
300 CLOSE #2
310 IF OK1 = 1 AND OK2 = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; OK1; " "; OK2
320 END
