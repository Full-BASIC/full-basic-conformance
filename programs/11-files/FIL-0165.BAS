1 REM FBCS FIL-0165
2 REM CLAIM D-11.2-1
3 REM TYPE INPUT
100 PRINT "FIL-0165 ON THE TERMINAL DEVICE CHANNEL ZERO DATA-FOUND IS TRUE WHEN INPUT IS AVAILABLE (11.2.4.2, App C)"
110 LET TOOK = 0
120 INPUT #0, IF MISSING THEN 900: A$
130 IF A$ = "DATA" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
140 GOTO 999
900 LET TOOK = 1
910 PRINT "*** TEST FAILED: RECOVERY TAKEN ***"
999 END
