1 REM FBCS FIL-0126
2 REM CLAIM A-11.3.4.8-01
3 REM TYPE SELF
100 PRINT "FIL-0126 WRITING TO A KEYED FILE ALWAYS REQUIRES AN EXACT KEY SEARCH (11.3.4.8)"
110 OPEN #1: NAME "FIL0126.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 WRITE #1, KEY "B": "EXACT"
130 LET OK = 0
140 WHEN EXCEPTION IN
150   WRITE #1: "NO-SETTER"
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = 7314 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 CLOSE #1
210 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 END
