1 REM FBCS FIL-0200
2 REM CLAIM A-11.3.4.1-06
3 REM TYPE SELF
4 REM STD 11.3.4.1 l.7574-7578 + 11.3.4.9 l.7685-7689: in a SEQUENTIAL DISPLAY file,
5 REM if the next operation of the channel after a partial record (PRINT # with a
6 REM trailing separator) is anything other than a PRINT # with an absent
7 REM record-setter (here WRITE #), an end-of-record completes the partial record
8 REM first, so WRITE # starts a new record: two records "A" and "B".
9 REM Controls: a following PRINT # continues the partial (one record "CD");
11 REM SET #n: POINTER NEXT completes it (11.2.4.1 l.7211-7215); a SET with only
12 REM ZONEWIDTH does NOT complete it, the new zone width applies when the partial
13 REM is continued (11.3.4.4 l.7626-7628): "G" + 7 blanks + "H".
20 LET OK = 1
30 OPEN #1: NAME "FIL0200A.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
40 PRINT #1: "A";
50 WRITE #1: "B"
60 CLOSE #1
70 OPEN #1: NAME "FIL0200A.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
80 LINE INPUT #1, IF MISSING THEN 500: L1$
90 LINE INPUT #1, IF MISSING THEN 500: L2$
100 LINE INPUT #1, IF MISSING THEN 120: L3$
110 LET OK = 0
115 PRINT "FALLO-EXTRA"; L3$
120 IF L1$ <> "A" OR L2$ <> "B" THEN LET OK = 0
130 IF L1$ <> "A" OR L2$ <> "B" THEN PRINT "FALLO-WRITE"; L1$; "|"; L2$
140 CLOSE #1
150 OPEN #2: NAME "FIL0200B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 PRINT #2: "C";
170 PRINT #2: "D"
180 CLOSE #2
190 OPEN #2: NAME "FIL0200B.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
200 LINE INPUT #2, IF MISSING THEN 500: M1$
210 IF M1$ <> "CD" THEN LET OK = 0
220 IF M1$ <> "CD" THEN PRINT "FALLO-PRINT"; M1$
230 CLOSE #2
240 OPEN #3: NAME "FIL0200C.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
250 PRINT #3: "E";
260 SET #3: POINTER NEXT
270 WRITE #3: "F"
280 CLOSE #3
290 OPEN #3: NAME "FIL0200C.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
300 LINE INPUT #3, IF MISSING THEN 500: N1$
310 LINE INPUT #3, IF MISSING THEN 500: N2$
320 IF N1$ <> "E" OR N2$ <> "F" THEN LET OK = 0
330 IF N1$ <> "E" OR N2$ <> "F" THEN PRINT "FALLO-NEXT"; N1$; "|"; N2$
340 CLOSE #3
350 OPEN #4: NAME "FIL0200D.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
360 PRINT #4: "G";
370 SET #4: ZONEWIDTH 8
380 PRINT #4:, "H"
390 CLOSE #4
400 OPEN #4: NAME "FIL0200D.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
410 LINE INPUT #4, IF MISSING THEN 500: O1$
420 IF O1$ <> "G       H" THEN LET OK = 0
430 IF O1$ <> "G       H" THEN PRINT "FALLO-ZW"; O1$
440 CLOSE #4
450 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
460 GOTO 510
500 PRINT "*** TEST FAILED ***"
510 END
