1 REM FBCS FIL-0061
2 REM CLAIM A-11.1.4.8-01
3 REM TYPE SELF
100 PRINT "FIL-0061 ERASE DELETES THE DATA OF A TRUE FILE WITHOUT CHANGING ITS ATTRIBUTES (11.1.4.8)"
110 OPEN #1: NAME "FIL0061.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "A"
130 PRINT #1: "B"
140 ERASE #1
150 ASK #1: ORGANIZATION O$, RECTYPE R$, ACCESS A$, POINTER P$
160 SET #1: POINTER BEGIN
170 LET OK = 0
180 WHEN EXCEPTION IN
190   LINE INPUT #1: X$
200   PRINT "*** TEST FAILED: NO EXCEPTION AFTER ERASE ***"
210 USE
220   IF EXTYPE = 7305 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 PRINT #1: "C"
250 SET #1: POINTER BEGIN
260 LINE INPUT #1: Y$
270 CLOSE #1
280 IF O$ = "SEQUENTIAL" AND R$ = "DISPLAY" AND A$ = "OUTIN" AND P$ = "END" AND OK = 1 AND Y$ = "C" THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; O$; " "; R$; " "; A$; " "; P$; " "; OK; " <"; Y$; ">"
290 END
