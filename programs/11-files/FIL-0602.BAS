1 REM FBCS FIL-0602
2 REM CLAIM D-11.2-3
3 REM TYPE SELF
4 REM STD 11.2.5 (7206), 11.1.4.3 l.6752-6766; D-11.2-3 limit of the record number of a RELATIVE file
100 PRINT "FIL-0602 A RECORD NUMBER ABOVE 4294967295 RAISES 7206 AND OVERLAPS NOTHING"
110 LET OK = 0
120 OPEN #1: NAME "FIL0602.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
130 ERASE #1
140 WRITE #1, RECORD 1: 11
150 WRITE #1, RECORD 4294967295: 55
160 WHEN EXCEPTION IN
170   WRITE #1, RECORD 4294967296: 77
180   PRINT "*** TEST FAILED: RECORD 4294967296 ACCEPTED ***"
190 USE
200   IF EXTYPE = 7206 THEN LET OK = OK + 1
210 END WHEN
220 WHEN EXCEPTION IN
230   WRITE #1: 66
240   PRINT "*** TEST FAILED: WRITE AFTER RECORD 4294967295 ACCEPTED ***"
250 USE
260   IF EXTYPE = 7206 THEN LET OK = OK + 1
270 END WHEN
280 READ #1, RECORD 1: A
290 READ #1, RECORD 4294967295: B
300 CLOSE #1
310 IF A = 11 AND B = 55 THEN LET OK = OK + 1
320 IF OK = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK = "; OK; A; B
330 END
