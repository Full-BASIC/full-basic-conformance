1 REM FBCS FIL-0050
2 REM CLAIM A-11.1.4.2-05
3 REM TYPE SELF
100 PRINT "FIL-0050 POINTER AFTER OPEN WITH OUTPUT IS AT END, WITH ANY OTHER ACCESS AT BEGIN (11.1.4.2)"
110 OPEN #1: NAME "FIL0050.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "A"
130 CLOSE #1
140 OPEN #2: NAME "FIL0050.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 ASK #2: POINTER P2$
160 CLOSE #2
170 OPEN #3: NAME "FIL0050.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
180 ASK #3: POINTER P3$
190 CLOSE #3
200 IF P2$ = "END" AND P3$ = "BEGIN" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OUT="; P2$; " IN="; P3$
210 END
