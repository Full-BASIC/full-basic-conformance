1 REM FBCS FIL-0060
2 REM CLAIM A-11.1.4.7-02
3 REM TYPE SELF
100 PRINT "FIL-0060 A FILE OPENED INSIDE AN EXTERNAL PROCEDURE IS CLOSED WHEN IT ENDS (11.1.4.7)"
110 DECLARE EXTERNAL SUB OPENS
120 CALL OPENS
130 ASK #1: NAME N$
140 IF N$ = "" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: STILL OPEN <"; N$; ">"
150 END
160 EXTERNAL SUB OPENS
170 OPEN #1: NAME "FIL0060.DAT", ACCESS OUTIN
180 PRINT #1: "X"
190 END SUB
