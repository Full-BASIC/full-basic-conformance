1 REM FBCS FIL-0064
2 REM CLAIM A-11.1.4.9-03
3 REM TYPE SELF
100 PRINT "FIL-0064 POINTER ASK VALUE IS BEGIN, MIDDLE OR END, AND END COVERS AN EMPTY FILE (11.1.4.9)"
110 OPEN #1: NAME "FIL0064.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 ASK #1: POINTER P0$
130 PRINT #1: "A"
140 PRINT #1: "B"
150 SET #1: POINTER BEGIN
160 ASK #1: POINTER P1$
170 LINE INPUT #1: X$
180 ASK #1: POINTER P2$
190 CLOSE #1
200 IF P0$ = "END" AND P1$ = "BEGIN" AND P2$ = "MIDDLE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; P0$; " "; &
&P1$; " "; P2$
210 END
