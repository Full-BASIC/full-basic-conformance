1 REM FBCS FIL-0054
2 REM CLAIM A-11.1.4.5-02
3 REM TYPE SELF
100 PRINT "FIL-0054 A RECORD LONGER THAN THE MAXIMUM RECORD SIZE RAISES AN EXCEPTION (11.1.4.5)"
110 OPEN #1: NAME "FIL0054.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE, RECSIZE VARIABLE LENGTH 3
120 TEMPLATE: STRING*10
130 LET OK = 0
140 WHEN EXCEPTION IN
150   WRITE #1, WITH 120: "ABCDEFGHIJ"
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = 8301 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 CLOSE #1
210 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 END
