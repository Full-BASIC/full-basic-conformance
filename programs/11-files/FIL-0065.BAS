1 REM FBCS FIL-0065
2 REM CLAIM A-11.2.3-EX
3 REM TYPE SELF
100 PRINT "FIL-0065 ALL SET FORMS OF THE EXAMPLES OF 11.2.3 ARE ACCEPTED (11.2.3)"
110 LET N = 3
111 LET T = 0
112 LET M99 = 0
120 OPEN #3: NAME "FIL0065R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
130 OPEN #4: NAME "FIL0065K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
140 SET #N: POINTER BEGIN
150 WRITE #3, RECORD N+1: "REC3"
160 SET #3: RECORD N+1, IF MISSING THEN 800
170 WRITE #4, KEY "Jones": "J"
180 DO
190   SET #4: KEY "Jones", IF THERE THEN 205
200   LET T = 1
205   EXIT DO
210 LOOP
220 READ #4: A$
225 SET #3: RECORD 99, IF MISSING THEN 810
230 CLOSE #3
240 CLOSE #4
250 IF A$ = "J" AND T = 0 AND M99 = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 GOTO 999
800 PRINT "*** TEST FAILED: MISSING TAKEN"
810 LET M99 = 1
820 GOTO 230
999 END
