1 REM FBCS FIL-0250
2 REM CLAIM E-1105
3 REM TYPE SELF
100 REM READ #, INPUT #, LINE INPUT # AND THEIR MAT FORMS INTO A STRING-ARRAY WITH A LENGTH-MAX RAISE
102 REM 1105, NOT 1106 (11.4.5.3 L.8440-8441)
110 DECLARE STRING A$(3) * 2
120 DECLARE STRING B$(2,2) * 2
130 DECLARE STRING C$(2,2,2) * 2
140 DECLARE STRING D$(3) * 2
150 LET A$(2) = "Z"
160 LET B$(2,1) = "Y"
170 LET C$(2,1,2) = "X"
180 OPEN #1: NAME "FIL0250.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
190 WRITE #1: "abc"
195 OPEN #3: NAME "FIL0250C.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
197 WRITE #3: "abc", "d", "e"
200 OPEN #2: NAME "FIL0250B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 PRINT #2: "abc"
220 LET OK = 0
230 SET #1: POINTER BEGIN
240 WHEN EXCEPTION IN
250   READ #1: A$(2)
260 USE
270   IF EXTYPE = 1105 AND A$(2) = "Z" THEN LET OK = OK + 1
280 END WHEN
290 SET #1: POINTER BEGIN
300 WHEN EXCEPTION IN
310   READ #1: B$(2,1)
320 USE
330   IF EXTYPE = 1105 AND B$(2,1) = "Y" THEN LET OK = OK + 1
340 END WHEN
350 SET #1: POINTER BEGIN
360 WHEN EXCEPTION IN
370   READ #1: C$(2,1,2)
380 USE
390   IF EXTYPE = 1105 AND C$(2,1,2) = "X" THEN LET OK = OK + 1
400 END WHEN
410 SET #3: POINTER BEGIN
420 WHEN EXCEPTION IN
430   MAT READ #3: D$
440 USE
450   IF EXTYPE = 1105 THEN LET OK = OK + 1
460 END WHEN
470 SET #2: POINTER BEGIN
480 WHEN EXCEPTION IN
490   INPUT #2: B$(2,1)
500 USE
510   IF EXTYPE = 1105 AND B$(2,1) = "Y" THEN LET OK = OK + 1
520 END WHEN
530 SET #2: POINTER BEGIN
540 WHEN EXCEPTION IN
550   LINE INPUT #2: C$(2,1,2)
560 USE
570   IF EXTYPE = 1105 AND C$(2,1,2) = "X" THEN LET OK = OK + 1
580 END WHEN
590 SET #2: POINTER BEGIN
600 WHEN EXCEPTION IN
610   LINE INPUT #2: A$(2)
620 USE
630   IF EXTYPE = 1105 AND A$(2) = "Z" THEN LET OK = OK + 1
640 END WHEN
650 SET #2: POINTER BEGIN
660 WHEN EXCEPTION IN
670   INPUT #2: A$(2)
680 USE
690   IF EXTYPE = 1105 AND A$(2) = "Z" THEN LET OK = OK + 1
700 END WHEN
710 CLOSE #1
720 CLOSE #2
725 CLOSE #3
730 IF OK = 8 AND LEN(D$(1)) <= 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
740 END
