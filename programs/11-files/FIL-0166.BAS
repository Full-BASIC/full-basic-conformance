1 REM FBCS FIL-0166
2 REM CLAIM D-11.3-1
3 REM TYPE SELF
100 PRINT "FIL-0166 THE END OF A STORED DISPLAY ELEMENT IS SIGNALLED BY A LINE TERMINATOR (11.3, App C)"
110 OPEN #1: NAME "FIL0166.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "ONE"
130 PRINT #1: "TWO"
140 CLOSE #1
150 OPEN #2: NAME "FIL0166.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 LINE INPUT #2: A$
170 LINE INPUT #2: B$
180 CLOSE #2
190 IF A$ = "ONE" AND B$ = "TWO" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; "> <"; B$; ">"
200 END
