1 REM FBCS FIL-0291
2 REM CLAIM A-11.3.5.3-TR81A
3 REM TYPE SELF
4 REM STD 11.1.4.5 l.6850-6854: an attempt to perform a record operation for a record
5 REM whose length exceeds the maximum set shall cause an exception; STD 11.3.5.3
6 REM l.7912-7913: exception 8301. STD 11.3.4 l.7532-7536 and 11.3.4.7 l.7659-7660: a
7 REM partial record is never created. So in a SEQUENTIAL INTERNAL file WRITE and MAT
8 REM WRITE of a record larger than RECSIZE give 8301, add nothing to the file, and the
9 REM file holds only the records written correctly (reading it gives no 8302).
10 LET OK = 1
20 DIM A$(2)
30 LET A$(1) = "A"
40 LET A$(2) = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
50 OPEN #1: NAME "FIL0291.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 10
60 FOR J = 1 TO 3
70 ON J GOSUB 1000, 1100, 1200
80 WRITE #1: "X"
90 NEXT J
100 SET #1: POINTER BEGIN
110 FOR J = 1 TO 3
120 READ #1: B$
130 IF B$ <> "X" THEN LET OK = 0
140 NEXT J
150 READ #1, IF MISSING THEN 170: C$
160 LET OK = 0
170 CLOSE #1
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 STOP
1000 WHEN EXCEPTION IN
1010   WRITE #1: "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
1020   LET OK = 0
1030 USE
1040   IF EXTYPE <> 8301 THEN LET OK = 0
1050 END WHEN
1060 RETURN
1100 WHEN EXCEPTION IN
1110   WRITE #1: "ABCDEF", "GHIJKL"
1120   LET OK = 0
1130 USE
1140   IF EXTYPE <> 8301 THEN LET OK = 0
1150 END WHEN
1160 RETURN
1200 WHEN EXCEPTION IN
1210   MAT WRITE #1: A$
1220   LET OK = 0
1230 USE
1240   IF EXTYPE <> 8301 THEN LET OK = 0
1250 END WHEN
1260 RETURN
1500 END
