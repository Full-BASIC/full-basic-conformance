1 REM FBCS FIL-0017
2 REM CLAIM A-11.2.4.2-03
3 REM TYPE SELF
100 PRINT "FIL-0017 IF THERE ON A SEQUENTIAL FILE, POINTER AT END OF FILE: NOT TAKEN (11.2.4.2)"
110 OPEN #1: NAME "FIL0017.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 WRITE #1, IF THERE THEN 900: "ALPHA"
130 WRITE #1, END, IF THERE THEN 900: "BETA"
140 WRITE #1, IF THERE THEN 900: "GAMMA"
150 CLOSE #1
160 OPEN #2: NAME "FIL0017.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
170 LINE INPUT #2: A$
180 LINE INPUT #2: B$
190 LINE INPUT #2: C$
200 CLOSE #2
210 IF A$ = "ALPHA" AND B$ = "BETA" AND C$ = "GAMMA" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$; &
&"/"; C$
220 GOTO 999
900 PRINT "*** TEST FAILED: IF THERE TAKEN AT END OF FILE"
999 END
