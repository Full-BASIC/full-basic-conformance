1 REM FBCS FIL-0159
2 REM CLAIM D-11.1-8
3 REM TYPE SELF
100 PRINT "FIL-0159 FILE CONTENTS ARE PRESERVED IN THE FILESYSTEM BETWEEN CLOSE AND REOPEN (11, App C)"
110 OPEN #1: NAME "FIL0159.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "KEPT"
130 CLOSE #1
140 OPEN #2: NAME "FIL0159.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 CLOSE #2
170 IF A$ = "KEPT" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
180 END
