1 REM FBCS FIL-0136
2 REM CLAIM A-11.4.4.2-01
3 REM TYPE SELF
100 PRINT "FIL-0136 MAT INPUT REDIM BELOW ONE KEEPS OLD VALUES AND RAISES (11.4.4.2)"
110 OPEN #1: NAME "FIL0136.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "1,2,3"
130 CLOSE #1
140 OPEN #2: NAME "FIL0136.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 DIM A(5)
160 DIM B(5)
170 LET A(1) = 9
180 LET B(1) = 8
190 LET OK = 0
200 WHEN EXCEPTION IN
210   MAT INPUT #2: A(0), B
220   PRINT "*** TEST FAILED: NO EXCEPTION ***"
230 USE
240   IF EXTYPE = 6005 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
250 END WHEN
260 CLOSE #2
270 IF OK = 1 AND A(1) = 9 AND B(1) = 8 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; OK; " "; A(1); " "; B(1)
280 END
