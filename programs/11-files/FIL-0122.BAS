1 REM FBCS FIL-0122
2 REM CLAIM A-11.3.4.3-02
3 REM TYPE SELF
100 PRINT "FIL-0122 MARGIN MAXNUM LETS A RECORD GROW WITHOUT LIMIT; MARGIN 0 IS 4006 (11.3.4.3, 11.3.5)"
110 OPEN #1: NAME "FIL0122.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 LET OK1 = 0
130 WHEN EXCEPTION IN
140   SET #1: MARGIN 0
150   PRINT "*** TEST FAILED: MARGIN 0 ACCEPTED ***"
160 USE
170   IF EXTYPE = 4006 THEN LET OK1 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
180 END WHEN
190 SET #1: MARGIN MAXNUM
200 PRINT #1: REPEAT$("Y", 500)
210 SET #1: POINTER BEGIN
220 LINE INPUT #1: L$
230 CLOSE #1
240 IF OK1 = 1 AND LEN(L$) = 500 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK1="; OK1; " LEN="; LEN(L$)
250 END
