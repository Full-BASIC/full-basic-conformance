1 REM FBCS FIL-0068
2 REM CLAIM A-11.2.4.1-02
3 REM TYPE SELF
100 PRINT "FIL-0068 NEXT ON A SEQUENTIAL FILE WITH A PARTIAL RECORD EMITS THE END-OF-RECORD (11.2.4.1)"
110 OPEN #1: NAME "FIL0068.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "A";
130 SET #1: POINTER NEXT
140 ASK #1: POINTER P$
150 PRINT #1: "B"
160 SET #1: POINTER BEGIN
170 LINE INPUT #1: L1$
180 LINE INPUT #1: L2$
190 CLOSE #1
200 IF P$ = "END" AND L1$ = "A" AND L2$ = "B" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: P="; P$; " <"; L1$; &
&"> <"; L2$; ">"
210 END
