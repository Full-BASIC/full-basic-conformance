1 REM FBCS FIL-0342
2 REM CLAIM A-11.5.4-TR87
3 REM TYPE SELF
4 REM STD 11.5.4 l.8527-8533: REWRITE gets its data like a data retrieval statement: phase 1
5 REM (attributes, 7322), phase 2 (data-not-found: IF MISSING or 7305) and only then, if the
6 REM record exists, phase 3 (the operands are evaluated). A failing operand or a function with
7 REM side effects is not evaluated when the statement ends in phase 1 or 2.
10 FUNCTION F$(X$)
20   LET C = C + 1
30   LET F$ = X$
40 END FUNCTION
50 LET OK = 1
60 LET C = 0
100 OPEN #1: NAME "FIL0342R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
110 WRITE #1, RECORD 1: "A"
120 WHEN EXCEPTION IN
130   REWRITE #1, RECORD 2: 1/0
140 USE
150   LET E1 = EXTYPE
160 END WHEN
170 WHEN EXCEPTION IN
180   REWRITE #1, RECORD 2: F$("P")
190 USE
200   LET E2 = EXTYPE
210 END WHEN
220 READ #1, RECORD 1: X$
230 IF E1 <> 7305 OR E2 <> 7305 OR C <> 0 OR X$ <> "A" THEN LET OK = 0
240 IF E1 <> 7305 OR E2 <> 7305 OR C <> 0 OR X$ <> "A" THEN PRINT "FALLO-RELATIVE-7305"; E1; E2; C; X$
250 CLOSE #1
300 OPEN #2: NAME "FIL0342K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
310 WRITE #2, KEY "A": "A"
320 WHEN EXCEPTION IN
330   REWRITE #2, KEY "B": 1/0
340 USE
350   LET E1 = EXTYPE
360 END WHEN
370 WHEN EXCEPTION IN
380   REWRITE #2, KEY "B": F$("P")
390 USE
400   LET E2 = EXTYPE
410 END WHEN
420 READ #2, KEY "A": X$
430 IF E1 <> 7305 OR E2 <> 7305 OR C <> 0 OR X$ <> "A" THEN LET OK = 0
440 IF E1 <> 7305 OR E2 <> 7305 OR C <> 0 OR X$ <> "A" THEN PRINT "FALLO-KEYED-7305"; E1; E2; C; X$
450 CLOSE #2
500 OPEN #3: NAME "FIL0342W.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
510 WRITE #3, RECORD 1: "A"
520 CLOSE #3
530 OPEN #3: NAME "FIL0342W.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE INTERNAL
540 WHEN EXCEPTION IN
550   REWRITE #3, RECORD 1: 1/0
560 USE
570   LET E1 = EXTYPE
580 END WHEN
590 WHEN EXCEPTION IN
600   REWRITE #3, RECORD 2, IF MISSING THEN 650: F$("P")
610 USE
620   LET E2 = EXTYPE
630 END WHEN
640 GOTO 670
650 LET E2 = 0
660 REM 7322 comes before the recovery of phase 2
670 IF E1 <> 7322 OR E2 <> 7322 OR C <> 0 THEN LET OK = 0
680 IF E1 <> 7322 OR E2 <> 7322 OR C <> 0 THEN PRINT "FALLO-7322"; E1; E2; C
690 CLOSE #3
700 REM Control: with the record present the operand is evaluated once (phase 3).
710 OPEN #4: NAME "FIL0342C.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
720 WRITE #4, RECORD 1: "A"
730 REWRITE #4, RECORD 1, IF MISSING THEN 760: F$("Z")
740 READ #4, RECORD 1: X$
750 GOTO 780
760 LET OK = 0
770 PRINT "FALLO-CONTROL-RECUPERACION-TOMADA"
780 IF X$ <> "Z" OR C <> 1 THEN LET OK = 0
790 IF X$ <> "Z" OR C <> 1 THEN PRINT "FALLO-CONTROL"; X$; C
800 CLOSE #4
900 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
910 END
