1 REM FBCS FIL-0302
2 REM CLAIM E-8301
3 REM TYPE SELF
100 REM REWRITING A RECORD WITH ONE LARGER THAN THE RECSIZE RAISES 8301 AND LEAVES THE RECORD AS IT WAS
101 REM (11.5.5.3 L.8620, 11.5.4.1 L.8553-8559)
110 LET OK = 0
120 OPEN #1: NAME "FIL-0302.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 10
130 WRITE #1, KEY "A": "A"
140 WHEN EXCEPTION IN
150   REWRITE #1, KEY "A": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
160 USE
170   IF EXTYPE = 8301 THEN LET OK = 1
180 END WHEN
190 READ #1, KEY "A": A$
200 CLOSE #1
210 IF OK = 1 AND A$ = "A" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; OK; A$
220 END
