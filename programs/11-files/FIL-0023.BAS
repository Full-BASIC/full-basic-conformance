1 REM FBCS FIL-0023
2 REM CLAIM A-11.2.4.2-04
3 REM TYPE SELF
100 PRINT "FIL-0023 AN UNTAKEN IF THERE BELONGS TO ITS OWN STATEMENT (11.2.4.2)"
110 LET OK = 1
120 FOR K = 1 TO 2
130   IF K = 1 THEN OPEN #1: NAME "FIL0023R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
140   IF K = 2 THEN OPEN #1: NAME "FIL0023K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
150   LET JUMPED = 0
160   LET RAISED = 0
170   REM THE FILE IS EMPTY: DATA-FOUND IS FALSE, SO THE FIRST WRITE IS DONE AND ITS IF THERE IS IGNORED
180   IF K = 1 THEN WRITE #1, RECORD 1, IF THERE THEN 300: "A"
190   IF K = 2 THEN WRITE #1, KEY "A", IF THERE THEN 300: "A"
200   REM THE RECORD NOW EXISTS AND THE SECOND WRITE HAS NO NOT-MISSING-RECOVERY: EXCEPTION 7308
210   WHEN EXCEPTION IN
220     IF K = 1 THEN WRITE #1, RECORD 1: "B"
230     IF K = 2 THEN WRITE #1, KEY "A": "B"
240   USE
250     IF EXTYPE = 7308 THEN LET RAISED = 1
260   END WHEN
270   GOTO 310
300   LET JUMPED = 1
310   CLOSE #1
320   IF JUMPED = 1 OR RAISED = 0 THEN LET OK = 0
330 NEXT K
340 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
999 END
