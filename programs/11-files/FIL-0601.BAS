1 REM FBCS FIL-0601
2 REM CLAIM D-11-1
3 REM TYPE SELF
4 REM STD 11 l.6212-6219 (STREAM+DISPLAY is implementation-defined), 11.4.4.8 l.8224-8235
100 PRINT "FIL-0601 STREAM+DISPLAY: LINE INPUT # RETURNS THE UNREAD REST OF THE CURRENT LINE"
110 OPTION BASE 1
120 DIM S$(2), X(5), Y(5)
130 OPEN #1: NAME "FIL0575.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE DISPLAY
140 ERASE #1
150 PRINT #1: "1, 2, 3"
160 PRINT #1: "4, 5"
170 PRINT #1: "6, 7, 8"
180 PRINT #1: "9, 10"
190 SET #1: POINTER BEGIN
200 LET OK = 0
210 INPUT #1: A
220 LINE INPUT #1: L$
230 IF A = 1 AND L$ = " 2, 3" THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: LINE INPUT ["; L$; "]"
240 INPUT #1: A, B
250 IF A = 4 AND B = 5 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: INPUT "; A; B
260 INPUT #1: A
270 MAT LINE INPUT #1: S$
280 IF S$(1) = " 7, 8" AND S$(2) = "9, 10" THEN LET OK = OK + 1
285 IF S$(1) <> " 7, 8" OR S$(2) <> "9, 10" THEN PRINT "*** TEST FAILED: MAT LINE INPUT ["; S$(1); "]["; S$(2); "]"
290 SET #1: POINTER BEGIN
300 INPUT #1: A
310 MAT INPUT #1: X(?)
320 IF UBOUND(X) = 2 AND X(1) = 2 AND X(2) = 3 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: MAT INPUT PENDING "; UBOUND(X)
330 MAT INPUT #1: Y(?)
340 IF UBOUND(Y) = 2 AND Y(1) = 4 AND Y(2) = 5 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: MAT INPUT NEXT LINE "; UBOUND(Y)
350 CLOSE #1
360 IF OK = 5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK = "; OK
370 END
