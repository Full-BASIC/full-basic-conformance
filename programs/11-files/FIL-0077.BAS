170 END WHEN
180 WHEN EXCEPTION IN
190   CLOSE #0
200   PRINT "*** TEST FAILED: CLOSE0 ***"
210 USE
220   IF EXTYPE = 7002 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: CLOSE0 EXTYPE"; EXTYPE
230 END WHEN
240 WHEN EXCEPTION IN
250   ERASE #0
260   PRINT "*** TEST FAILED: ERASE0 ***"
270 USE
280   IF EXTYPE = 7002 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: ERASE0 EXTYPE"; EXTYPE
290 END WHEN
300 WHEN EXCEPTION IN
