1 REM FBCS FIL-0143
2 REM CLAIM A-11.4.4.9-02
3 REM TYPE SELF
100 PRINT "FIL-0143 NUMERIC DATA FROM A DISPLAY RECORD IS READ LIKE A NUMERIC CONSTANT (11.4.4.9)"
110 OPEN #1: NAME "FIL0143.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "3.5"
130 CLOSE #1
140 OPEN #2: NAME "FIL0143.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 READ #2: N
160 CLOSE #2
170 IF N = 3.5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: N="; N
180 END
