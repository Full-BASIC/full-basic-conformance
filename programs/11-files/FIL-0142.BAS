1 REM FBCS FIL-0142
2 REM CLAIM A-11.4.4.9-01
3 REM TYPE SELF
100 PRINT "FIL-0142 STRING DATA FROM A DISPLAY RECORD IS READ AS AN INPUT REPLY (11.4.4.9)"
110 OPEN #1: NAME "FIL0142.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "  X  "
130 CLOSE #1
140 OPEN #2: NAME "FIL0142.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 READ #2: S$
160 CLOSE #2
170 IF S$ = "X" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; S$; ">"
180 END
