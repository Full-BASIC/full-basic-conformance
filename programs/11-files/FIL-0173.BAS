1 REM FBCS FIL-0173
2 REM CLAIM D-11.4-5
3 REM TYPE SELF
100 PRINT "FIL-0173 READING A NATIVE RECORD WITH AN INCOMPATIBLE TEMPLATE RAISES 8012 (11.4.5.3, App C)"
110 OPEN #1: NAME "FIL0173.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*2.0
130 WRITE #1, WITH 120: 42
140 CLOSE #1
150 OPEN #2: NAME "FIL0173.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 TEMPLATE: STRING*4
170 LET OK = 0
180 WHEN EXCEPTION IN
190   READ #2, WITH 160: S$
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE = 8012 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 CLOSE #2
250 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 END
