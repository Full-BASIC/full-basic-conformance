1 REM FBCS FIL-0025
2 REM CLAIM A-11.3.4.1-04
3 REM TYPE SELF
100 PRINT "FIL-0025 PRINT # WITH A TRAILING PRINT-SEPARATOR LEAVES THE RECORD OPEN (11.3.4.1)"
110 LET OK = 1
120 FOR K = 1 TO 2
130   IF K = 1 THEN OPEN #1: NAME "FIL0025.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
140   IF K = 2 THEN OPEN #1: NAME "FIL0025B.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150   PRINT #1: "A";
160   PRINT #1: "B"
170   PRINT #1: "C",
180   PRINT #1: "D"
190   PRINT #1: "X";
200   PRINT #1
210   PRINT #1: "E"
220   CLOSE #1
230   IF K = 1 THEN OPEN #2: NAME "FIL0025.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
240   IF K = 2 THEN OPEN #2: NAME "FIL0025B.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
250   LINE INPUT #2: R1$
260   LINE INPUT #2: R2$
270   LINE INPUT #2: R3$
280   LINE INPUT #2: R4$
290   CLOSE #2
300   IF R1$ <> "AB" THEN LET OK = 0
310   IF LEN(R2$) < 2 OR R2$(1:1) <> "C" OR R2$(LEN(R2$):LEN(R2$)) <> "D" THEN LET OK = 0
320   IF R3$ <> "X" OR R4$ <> "E" THEN LET OK = 0
330 NEXT K
340 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
999 END
