1 REM FBCS FIL-0199
2 REM CLAIM A-11.5.4.1-01
3 REM TYPE SELF
4 REM STD 11.5.4.1 l.8552-8557: REWRITE replaces the record pointed to and advances
5 REM the pointer to the next file-element, also with RECORD n: after
6 REM REWRITE #1, RECORD 1 the pointer is at record-area 2 (ASK RECORD=2) and a
7 REM READ #1 without record-setter reads record 2. STD 11.3.4 l.7536-7541 + 11.5.5.2:
8 REM after WRITE #1, RECORD 1 the pointer is at the (empty) area 2, so REWRITE #1
9 REM without record-setter raises 7305 (nonexistent record).
10 LET OK = 1
20 OPEN #1: NAME "FIL0199.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
30 WRITE #1, RECORD 1: 10
40 WRITE #1, RECORD 2: 20
50 REWRITE #1, RECORD 1: 11
60 ASK #1: RECORD R
70 IF R <> 2 THEN LET OK = 0
80 IF R <> 2 THEN PRINT "FALLO-ASK"; R
90 READ #1: X
100 IF X <> 20 THEN LET OK = 0
110 IF X <> 20 THEN PRINT "FALLO-READ"; X
120 READ #1, RECORD 1: Y
130 IF Y <> 11 THEN LET OK = 0
140 IF Y <> 11 THEN PRINT "FALLO-REWRITE"; Y
150 CLOSE #1
160 OPEN #2: NAME "FIL0199B.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
170 WRITE #2, RECORD 1: 5
180 WHEN EXCEPTION IN
190 REWRITE #2: 9
200 USE
210 LET T = EXTYPE
220 END WHEN
230 IF T <> 7305 THEN LET OK = 0
240 IF T <> 7305 THEN PRINT "FALLO-7305"; T
250 CLOSE #2
260 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
270 END
