1 REM FBCS FIL-0230
2 REM CLAIM E-1105
3 REM TYPE SELF
100 REM READ # INTO A SUBSTRING THAT OVERFLOWS RAISES 1105, NOT 1106 (11.4.5.3 l.8440-8441)
110 DECLARE STRING A$ * 3
120 DECLARE STRING B$(2) * 3
130 LET A$ = "ABC"
140 LET B$(1) = "ABC"
150 OPEN #1: NAME "FIL0230.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
160 WRITE #1: "X"
170 SET #1: POINTER BEGIN
180 LET OK = 0
190 WHEN EXCEPTION IN
200   READ #1: A$(2:1)
210 USE
220   IF EXTYPE = 1105 AND A$ = "ABC" THEN LET OK = OK + 1
230 END WHEN
240 SET #1: POINTER BEGIN
250 WHEN EXCEPTION IN
260   READ #1: B$(1)(2:1)
270 USE
280   IF EXTYPE = 1105 AND B$(1) = "ABC" THEN LET OK = OK + 1
290 END WHEN
300 CLOSE #1
310 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
320 END
