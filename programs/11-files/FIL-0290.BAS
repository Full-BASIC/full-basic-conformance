1 REM FBCS FIL-0290
2 REM CLAIM A-11.3.4-TR81A
3 REM TYPE SELF
4 REM STD 11.3.4 l.7538-7541 and 11.3.4.8 l.7671-7675: if an exception of the third phase
5 REM prevents the creation of any file-element, the pointer is left as set in the second
6 REM phase. The TEMPLATE exceptions 8252, 8254, 8255 and 8256 (11.3.5.3 l.7914-7930) are
7 REM third-phase exceptions. In a RELATIVE NATIVE file the pointer stays at the record
8 REM area of RECORD r; in a KEYED NATIVE file at the first key greater than the given
9 REM one (11.2.4.1 l.7256-7260). No record is created and the next WRITE works.
10 LET OK = 1
20 OPEN #1: NAME "FIL0290R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
30 WRITE #1, RECORD 1, WITH "NUMERIC*2": 1
40 OPEN #2: NAME "FIL0290K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
50 WRITE #2, KEY "A", WITH "NUMERIC*2": 1
60 WRITE #2, KEY "E", WITH "NUMERIC*2": 3
100 FOR J = 1 TO 4
110 ON J GOSUB 1000, 1100, 1200, 1300
130 ASK #1: RECORD R
140 IF R <> 3 THEN LET OK = 0
150 READ #1, RECORD 3, WITH "NUMERIC*2", IF MISSING THEN 170: X
160 LET OK = 0
170 WRITE #1, RECORD 3, WITH "NUMERIC*2": 7
180 ASK #1: RECORD R
190 IF R <> 4 THEN LET OK = 0
200 READ #1, RECORD 3, WITH "NUMERIC*2": Y
210 IF Y <> 7 THEN LET OK = 0
215 DELETE #1, RECORD 3
230 SET #2: KEY "E"
240 ON J GOSUB 2000, 2100, 2200, 2300
250 ASK #2: KEY K$
260 IF K$ <> "E" THEN LET OK = 0
270 READ #2, KEY "C", WITH "NUMERIC*2", IF MISSING THEN 290: X
280 LET OK = 0
290 WRITE #2, KEY "C", WITH "NUMERIC*2": 7
300 ASK #2: KEY K$
310 IF K$ <> "E" THEN LET OK = 0
320 READ #2, KEY "C", WITH "NUMERIC*2": Y
330 IF Y <> 7 THEN LET OK = 0
335 DELETE #2, KEY "C"
340 NEXT J
350 CLOSE #1
360 CLOSE #2
370 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
380 STOP
1000 WHEN EXCEPTION IN
1010   WRITE #1, RECORD 3, WITH "NUMERIC*2": "AB"
1020   LET OK = 0
1030 USE
1040   IF EXTYPE <> 8252 THEN LET OK = 0
1050 END WHEN
1060 RETURN
1100 WHEN EXCEPTION IN
1110   WRITE #1, RECORD 3, WITH "NUMERIC*2": 1, 2
1120   LET OK = 0
1130 USE
1140   IF EXTYPE <> 8254 THEN LET OK = 0
1150 END WHEN
1160 RETURN
1200 WHEN EXCEPTION IN
1210   WRITE #1, RECORD 3, WITH "NUMERIC*2": 123
1220   LET OK = 0
1230 USE
1240   IF EXTYPE <> 8255 THEN LET OK = 0
1250 END WHEN
1260 RETURN
1300 WHEN EXCEPTION IN
1310   WRITE #1, RECORD 3, WITH "STRING*2": "ABC"
1320   LET OK = 0
1330 USE
1340   IF EXTYPE <> 8256 THEN LET OK = 0
1350 END WHEN
1360 RETURN
2000 WHEN EXCEPTION IN
2010   WRITE #2, KEY "C", WITH "NUMERIC*2": "AB"
2020   LET OK = 0
2030 USE
2040   IF EXTYPE <> 8252 THEN LET OK = 0
2050 END WHEN
2060 RETURN
2100 WHEN EXCEPTION IN
2110   WRITE #2, KEY "C", WITH "NUMERIC*2": 1, 2
2120   LET OK = 0
2130 USE
2140   IF EXTYPE <> 8254 THEN LET OK = 0
2150 END WHEN
2160 RETURN
2200 WHEN EXCEPTION IN
2210   WRITE #2, KEY "C", WITH "NUMERIC*2": 123
2220   LET OK = 0
2230 USE
2240   IF EXTYPE <> 8255 THEN LET OK = 0
2250 END WHEN
2260 RETURN
2300 WHEN EXCEPTION IN
2310   WRITE #2, KEY "C", WITH "STRING*2": "ABC"
2320   LET OK = 0
2330 USE
2340   IF EXTYPE <> 8256 THEN LET OK = 0
2350 END WHEN
2360 RETURN
2500 END
