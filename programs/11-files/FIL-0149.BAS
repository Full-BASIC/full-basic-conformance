1 REM FBCS FIL-0149
2 REM CLAIM A-11.4.4.11-04
3 REM TYPE SELF
100 PRINT "FIL-0149 COMPATIBILITY MEANS EQUAL FIELD SIZES OR BOTH NUMERIC WITH SIZE E (11.4.4.11)"
110 OPEN #1: NAME "FIL0149.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*4.2, STRING*4
130 WRITE #1, WITH 120: 12.5, "WXYZ"
140 CLOSE #1
150 OPEN #2: NAME "FIL0149.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 TEMPLATE: NUMERIC*4.2, STRING*4
170 READ #2, WITH 160: X, Y$
180 CLOSE #2
190 IF X = 12.5 AND Y$ = "WXYZ" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; X; " <"; Y$; ">"
200 END
