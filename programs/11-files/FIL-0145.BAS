1 REM FBCS FIL-0145
2 REM CLAIM A-11.4.4.10-02
3 REM TYPE SELF
100 PRINT "FIL-0145 INTERNAL STRINGS KEEP LENGTH AND CONTENT, NUMERICS ARE PRESERVED (11.4.4.10)"
110 OPEN #1: NAME "FIL0145.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
120 WRITE #1: "ABC", 2.5
130 CLOSE #1
140 OPEN #2: NAME "FIL0145.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
150 READ #2: S$, N
160 CLOSE #2
170 IF S$ = "ABC" AND LEN(S$) = 3 AND N = 2.5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; S$; "> "; N
180 END
