1 REM FBCS FIL-0164
2 REM CLAIM D-11.1-15
3 REM TYPE SELF
100 PRINT "FIL-0164 KEY LENGTHS UP TO 10000 CHARACTERS ARE ACCEPTED IN A KEYED FILE (11.2, App C)"
110 OPEN #1: NAME "FIL0164.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 LET K$ = REPEAT$("K", 10000)
130 WRITE #1, KEY K$: "BIG"
140 SET #1: KEY K$
150 READ #1: A$
160 CLOSE #1
170 IF A$ = "BIG" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
180 END
