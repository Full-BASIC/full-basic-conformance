1 REM FBCS FIL-0049
2 REM CLAIM A-11.1.4.2-04
3 REM TYPE SELF
100 PRINT "FIL-0049 OMITTED ACCESS MODE DEFAULTS TO OUTIN FOR A READ-WRITE FILE, AND CHANNEL ZERO ACTS AS OUTIN (11.1.4.2)"
110 OPEN #1: NAME "FIL0049.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "X"
130 CLOSE #1
140 OPEN #2: NAME "FIL0049.DAT", ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 ASK #2: ACCESS A$
160 CLOSE #2
170 ASK #0: ACCESS A0$
180 IF A$ = "OUTIN" AND A0$ = "OUTIN" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: FILE="; A$; " CH0="; A0$
190 END
