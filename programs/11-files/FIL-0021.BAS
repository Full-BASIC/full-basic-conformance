1 REM FBCS FIL-0021
2 REM CLAIM A-11.3.4.1-02
3 REM TYPE SELF
100 PRINT "FIL-0021 PRINT # USING CREATES ONE RECORD PER FORMAT PASS (11.3.4.1)"
110 OPEN #1: NAME "FIL0021.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
120 PRINT #1, USING "###": 1, 2
130 CLOSE #1
140 OPEN #2: NAME "FIL0021.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 LINE INPUT #2: B$
170 LET C$ = "NONE"
180 WHEN EXCEPTION IN
190   LINE INPUT #2: C$
200 USE
210   REM END OF FILE REACHED
220 END WHEN
230 CLOSE #2
240 IF A$ = "  1" AND B$ = "  2" AND C$ = "NONE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$; &
&"/"; C$
999 END
