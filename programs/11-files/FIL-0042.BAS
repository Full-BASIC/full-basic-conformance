1 REM FBCS FIL-0042
2 REM CLAIM A-11.1.4.1-04
3 REM TYPE SELF
100 PRINT "FIL-0042 CORE MODULE PROCESSES SEQUENTIAL DISPLAY, SEQUENTIAL INTERNAL AND STREAM INTERNAL (11.1.4.1)"
110 OPEN #1: NAME "FIL0042A.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "DISP"
130 CLOSE #1
140 OPEN #2: NAME "FIL0042B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
150 WRITE #2: 42, "INT"
160 CLOSE #2
170 OPEN #3: NAME "FIL0042C.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
180 WRITE #3: 7, "STR"
190 CLOSE #3
200 OPEN #4: NAME "FIL0042A.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 LINE INPUT #4: A$
220 CLOSE #4
230 OPEN #5: NAME "FIL0042B.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
240 READ #5: X, Y$
250 CLOSE #5
260 OPEN #6: NAME "FIL0042C.DAT", ACCESS INPUT, ORGANIZATION STREAM, RECTYPE INTERNAL
270 READ #6: U, V$
280 ASK #6: DATUM D$
290 CLOSE #6
300 IF A$ = "DISP" AND X = 42 AND Y$ = "INT" AND U = 7 AND V$ = "STR" THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"
310 END
