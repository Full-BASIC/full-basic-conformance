1 REM FBCS FIL-0215
2 REM CLAIM A-11.1.4.6-03
3 REM TYPE SELF
100 PRINT "FIL-0215 THE COLLATE SEQUENCE OF A KEYED FILE IS KNOWN TO A LATER PROGRAM (11.1.4.6)"
110 REM program 1 creates the file with NATIVE (its own unit sequence is STANDARD)
120 OPEN #1: NAME "FIL0215.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL, COLLATE NATIVE
130 WRITE #1, KEY "A": 1
140 CLOSE #1
150 REM program 2 reopens it without COLLATE and must find NATIVE
160 OPEN #2: NAME "PROG2.BAS", ACCESS OUTPUT
170 PRINT #2: "10 OPEN #1: NAME ""FIL0215.DAT"", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL"
180 PRINT #2: "20 ASK #1: COLLATE C$"
190 PRINT #2: "30 CLOSE #1"
200 PRINT #2: "40 IF UCASE$(C$) = ""NATIVE"" THEN PRINT ""*** TEST PASSED ***"" ELSE PRINT ""*** TEST FAILED: <""; C$; ""> ***"""
210 PRINT #2: "50 END"
220 CLOSE #2
230 CHAIN "PROG2.BAS"
240 PRINT "*** TEST FAILED: CHAIN RETURNED ***"
250 END
