1 REM FBCS FIL-0270
2 REM CLAIM A-11.5.4-TR72
3 REM TYPE SELF
4 REM STD 11.5.4 l.8527-8534: the first two phases of REWRITE and DELETE are the same
5 REM as for the data retrieval statements; STD 11.2.4.1 l.7256-7260: an exact search
6 REM that finds no key sets the pointer to the first greater key, or to end of file.
7 REM So after REWRITE or DELETE with a missing key (IF MISSING or exception 7305)
8 REM ASK KEY gives the next key and a READ without setter reads that record.
10 LET OK = 1
20 DIM M(1)
30 MAT M = ZER
40 OPEN #1: NAME "FIL0270.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
50 WRITE #1, KEY "A": 1
60 WRITE #1, KEY "C": 2
70 WRITE #1, KEY "E": 3
100 FOR I = 1 TO 3
110 READ P$, E$, N
120 FOR J = 1 TO 5
130 SET #1: KEY "E"
140 ON J GOSUB 1000, 1100, 1200, 1300, 1400
150 ASK #1: KEY K$
160 LET V = -1
170 READ #1, IF MISSING THEN 190: V
190 IF K$ <> E$ OR V <> N THEN LET OK = 0
200 IF K$ <> E$ OR V <> N THEN PRINT "FALLO"; J; P$; " "; K$; V
210 NEXT J
220 NEXT I
230 CLOSE #1
240 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 STOP
900 DATA "0", "A", 1
910 DATA "B", "C", 2
920 DATA "F", "", -1
1000 DELETE #1, KEY P$, IF MISSING THEN 1090
1010 LET OK = 0
1090 RETURN
1100 REWRITE #1, KEY P$, IF MISSING THEN 1190: 9
1110 LET OK = 0
1190 RETURN
1200 MAT REWRITE #1, KEY P$, IF MISSING THEN 1290: M
1210 LET OK = 0
1290 RETURN
1300 WHEN EXCEPTION IN
1310   DELETE #1, KEY P$
1320   LET OK = 0
1330 USE
1340   IF EXTYPE <> 7305 THEN LET OK = 0
1350 END WHEN
1360 RETURN
1400 WHEN EXCEPTION IN
1410   REWRITE #1, KEY P$: 9
1420   LET OK = 0
1430 USE
1440   IF EXTYPE <> 7305 THEN LET OK = 0
1450 END WHEN
1460 RETURN
1500 END
