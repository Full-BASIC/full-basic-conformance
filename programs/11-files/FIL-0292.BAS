1 REM FBCS FIL-0292
2 REM CLAIM A-11.3.4-TR81B
3 REM TYPE SELF
4 REM STD 11.3.4 l.7525-7541 and 11.3.4.7 l.7659-7660: an exception of the third phase
5 REM (8301) creates no record and leaves nothing behind. In RELATIVE and KEYED files
6 REM with RECTYPE INTERNAL or DISPLAY, after an 8301 that was handled, a following
7 REM WRITE, REWRITE or MAT REWRITE of a record that fits works and stores only its own
8 REM data (STD 11.5.4.1 l.8550-8555 for REWRITE).
10 LET OK = 1
20 DIM A$(2)
30 LET A$(1) = "A"
40 LET A$(2) = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
50 FOR T = 1 TO 2
60 IF T = 1 THEN OPEN #1: NAME "FIL0292R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 10
70 IF T = 2 THEN OPEN #1: NAME "FIL0292K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY, RECSIZE VARIABLE LENGTH 10
80 FOR J = 1 TO 4
100 IF T = 1 THEN WRITE #1, RECORD 1: "A" ELSE WRITE #1, KEY "A": "A"
105 IF J >= 3 THEN GOSUB 3000
110 ON J GOSUB 1000, 1100, 1200, 1300
120 IF J < 3 THEN GOSUB 3000
130 IF T = 1 THEN REWRITE #1, RECORD 1: "C" ELSE REWRITE #1, KEY "A": "C"
140 IF T = 1 THEN READ #1, RECORD 1: X$ ELSE READ #1, KEY "A": X$
150 IF T = 1 THEN READ #1, RECORD 2: Y$ ELSE READ #1, KEY "B": Y$
160 IF X$ <> "C" OR Y$ <> "B" THEN LET OK = 0
170 IF T = 1 THEN DELETE #1, RECORD 1 ELSE DELETE #1, KEY "A"
180 IF T = 1 THEN DELETE #1, RECORD 2 ELSE DELETE #1, KEY "B"
190 NEXT J
200 CLOSE #1
210 NEXT T
220 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 STOP
1000 WHEN EXCEPTION IN
1010   IF T = 1 THEN WRITE #1, RECORD 2: "ABCDEFGHIJKLMNOPQRSTUVWXYZ" ELSE WRITE #1, KEY "B": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
1020   LET OK = 0
1030 USE
1040   IF EXTYPE <> 8301 THEN LET OK = 0
1050 END WHEN
1060 RETURN
1100 WHEN EXCEPTION IN
1110   IF T = 1 THEN MAT WRITE #1, RECORD 2: A$ ELSE MAT WRITE #1, KEY "B": A$
1120   LET OK = 0
1130 USE
1140   IF EXTYPE <> 8301 THEN LET OK = 0
1150 END WHEN
1160 RETURN
1200 WHEN EXCEPTION IN
1210   IF T = 1 THEN REWRITE #1, RECORD 2: "ABCDEFGHIJKLMNOPQRSTUVWXYZ" ELSE REWRITE #1, KEY "B": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
1220   LET OK = 0
1230 USE
1240   IF EXTYPE <> 8301 THEN LET OK = 0
1250 END WHEN
1260 RETURN
1300 WHEN EXCEPTION IN
1310   IF T = 1 THEN MAT REWRITE #1, RECORD 2: A$ ELSE MAT REWRITE #1, KEY "B": A$
1320   LET OK = 0
1330 USE
1340   IF EXTYPE <> 8301 THEN LET OK = 0
1350 END WHEN
1360 RETURN
3000 IF T = 1 THEN WRITE #1, RECORD 2: "B" ELSE WRITE #1, KEY "B": "B"
3010 RETURN
3500 END
