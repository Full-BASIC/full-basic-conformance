1 REM FBCS FIL-0158
2 REM CLAIM D-11.1-6
3 REM TYPE SELF
100 OPTION ARITHMETIC NATIVE
110 PRINT "FIL-0158 REOPENING AN INTERNAL FILE UNDER A DIFFERENT ARITHMETIC OPTION KEEPS IT ACCESSIBLE (11.1.4.1, App C)"
120 OPEN #1: NAME "FIL0158.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
130 WRITE #1: 1.5
140 CLOSE #1
150 OPEN #2: NAME "FIL0158.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
160 READ #2: X
170 CLOSE #2
180 IF X = 1.5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: X="; X
190 END
