1 REM FBCS FIL-0574
2 REM CLAIM A-11.4.4.8-FI13
3 REM TYPE SELF
4 REM STD 11.1.4.3 l.6740-6747, 11.4.4 l.8065-8070, 11.4.4.8 l.8224-8229: one record per operation
100 PRINT "FIL-0574 SEQUENTIAL NATIVE RECORDS ARE DELIMITED: SKIP REST SKIPS TO THE NEXT RECORD"
110 OPEN #1: NAME "FIL0574.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: 2 OF NUMERIC*3
130 TEMPLATE: NUMERIC*3
140 WRITE #1, WITH 120: 1, 2
150 WRITE #1, WITH 130: 3
160 CLOSE #1
170 OPEN #2: NAME "FIL0574.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
180 READ #2, WITH 130: A, SKIP REST
190 READ #2, WITH 130: B
200 CLOSE #2
210 IF A = 1 AND B = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: A="; A; " B="; B
220 END
