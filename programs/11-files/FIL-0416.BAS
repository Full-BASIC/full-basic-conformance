1 REM FBCS FIL-0416
2 REM CLAIM A-11.1.4-TR124
3 REM TYPE SELF
4 REM STD 11.1.4.8 l.6922-6925, 11.1 l.6743-6752: ERASE REST keeps the values before the pointer, even from one WRITE.
100 OPEN #4: NAME "FIL0414.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
110 ERASE #4
120 WRITE #4: 1, 2, 3
130 SET #4: POINTER BEGIN
140 READ #4: X
150 ERASE REST #4
160 ASK #4: POINTER P1$, DATUM D1$
170 SET #4: POINTER BEGIN
180 READ #4: Y
190 ASK #4: POINTER P2$, DATUM D2$
200 CLOSE #4
210 IF X = 1 AND Y = 1 AND P1$ = "END" AND D1$ = "NONE" AND P2$ = "END" AND D2$ = "NONE" THEN
220    PRINT "*** TEST PASSED ***"
230 ELSE
240    PRINT "*** TEST FAILED: ["; P1$; "] ["; D1$; "] ["; P2$; "] ["; D2$; "]"; X; Y
250 END IF
260 END
