1 REM FBCS FIL-0131
2 REM CLAIM A-11.3.4.12-01
3 REM TYPE SELF
100 PRINT "FIL-0131 WITH A FIXED FIELD COUNT THE SPECIFIERS MUST MATCH THE ARRAY ELEMENTS (11.3.4.12)"
110 OPEN #1: NAME "FIL0131.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: 2 OF NUMERIC*3.4
130 DIM A(2)
140 LET A(1) = 1.11
150 LET A(2) = 2.22
160 MAT WRITE #1, WITH 120: A
170 CLOSE #1
180 OPEN #2: NAME "FIL0131.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
190 DIM B(2)
200 MAT READ #2, WITH 120: B
210 CLOSE #2
220 IF B(1) = 1.11 AND B(2) = 2.22 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; B(1); " "; B(2)
230 END
