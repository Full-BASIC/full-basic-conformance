1 REM FBCS FIL-0413
2 REM CLAIM A-11.2.4.1-TR123
3 REM TYPE SELF
4 REM STD 11.2.4.1 l.7205-7208: on a KEYED file NEXT leaves the pointer unchanged: after
5 REM SET POINTER BEGIN, READ NEXT reads the first record, the key does not change, and
6 REM successive READ NEXT visit every record without skipping any.
100 PRINT "FIL-0413 KEYED NEXT FROM BEGIN LEAVES THE POINTER AND VISITS EVERY RECORD"
110 OPEN #1: NAME "FIL0413.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 ERASE #1
130 WRITE #1, KEY "A": "ONE"
140 WRITE #1, KEY "B": "TWO"
150 WRITE #1, KEY "C": "THREE"
160 WRITE #1, KEY "D": "FOUR"
170 SET #1: POINTER BEGIN
180 READ #1, NEXT: F$
190 SET #1: POINTER BEGIN
200 SET #1: POINTER NEXT
210 ASK #1: KEY K$
220 SET #1: POINTER BEGIN
230 LET R$ = ""
240 FOR I = 1 TO 4
250 READ #1, NEXT: S$
260 LET R$ = R$ & S$ & ","
270 NEXT I
280 CLOSE #1
290 LET R$ = F$ & K$ & R$
300 IF R$ = "ONEAONE,TWO,THREE,FOUR," THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; R$
310 END
