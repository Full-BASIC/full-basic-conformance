1 REM FBCS FIL-0311
2 REM CLAIM A-11.3.4-TR83A
3 REM TYPE SELF
4 REM STD 11.3.4 l.7525-7541, 11.3.4.8 l.7671-7675: on NATIVE and DISPLAY files an exception while
5 REM evaluating an operand (first, middle or last) of WRITE adds no file-element and leaves no
6 REM values behind for the next WRITE of the channel.
10 LET OK = 1
20 OPEN #1: NAME "FIL0311R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
30 WHEN EXCEPTION IN
40   WRITE #1, RECORD 2, WITH "STRING*1, NUMERIC*2, STRING*1": "A", 1/0, "C"
50 USE
60   LET E1 = EXTYPE
70 END WHEN
80 WHEN EXCEPTION IN
90   WRITE #1, RECORD 2, WITH "STRING*1, NUMERIC*2": "A", 1/0
100 USE
110   LET E2 = EXTYPE
120 END WHEN
130 WRITE #1, RECORD 3, WITH "STRING*1": "Z"
140 READ #1, RECORD 3, WITH "STRING*1": X$
150 READ #1, RECORD 2, WITH "STRING*1", IF MISSING THEN 180: Y$
160 LET OK = 0
170 PRINT "FALLO-RELATIVE-NATIVE-REGISTRO-2-EXISTE"
180 IF E1 <> 3001 OR E2 <> 3001 OR X$ <> "Z" THEN LET OK = 0
190 IF E1 <> 3001 OR E2 <> 3001 OR X$ <> "Z" THEN PRINT "FALLO-RELATIVE-NATIVE"; E1; E2; X$
200 CLOSE #1
210 OPEN #2: NAME "FIL0311K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
220 WHEN EXCEPTION IN
230   WRITE #2, KEY "B", WITH "STRING*1, NUMERIC*2, STRING*1": "A", 1/0, "C"
240 USE
250   LET E1 = EXTYPE
260 END WHEN
270 WRITE #2, KEY "C", WITH "STRING*1": "Z"
280 READ #2, KEY "C", WITH "STRING*1": X$
290 IF E1 <> 3001 OR X$ <> "Z" THEN LET OK = 0
300 IF E1 <> 3001 OR X$ <> "Z" THEN PRINT "FALLO-KEYED-NATIVE"; E1; X$
310 CLOSE #2
320 OPEN #3: NAME "FIL0311D.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
330 WHEN EXCEPTION IN
340   WRITE #3, RECORD 2: "A", 1/0, "C"
350 USE
360   LET E1 = EXTYPE
370 END WHEN
380 WRITE #3, RECORD 3: "Z"
390 READ #3, RECORD 3: X$
400 IF E1 <> 3001 OR X$ <> "Z" THEN LET OK = 0
410 IF E1 <> 3001 OR X$ <> "Z" THEN PRINT "FALLO-RELATIVE-DISPLAY"; E1; X$
420 CLOSE #3
430 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
440 END
