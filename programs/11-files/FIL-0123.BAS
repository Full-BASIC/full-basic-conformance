1 REM FBCS FIL-0123
2 REM CLAIM A-11.3.4.4-01
3 REM TYPE SELF
100 PRINT "FIL-0123 THE DEFAULT ZONE WIDTH OF A DISPLAY FILE IS AT LEAST D+E+6 (11.3.4.4)"
110 OPEN #1: NAME "FIL0123.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 ASK #1: ZONEWIDTH Z
130 CLOSE #1
140 IF Z >= 8 + 3 + 6 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: ZW="; Z
150 END
