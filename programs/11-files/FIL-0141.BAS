1 REM FBCS FIL-0141
2 REM CLAIM A-11.4.4.8-01
3 REM TYPE SELF
4 REM STREAM INTERNAL is a core stream combination (l.6665-6667); in a STREAM file running out
5 REM of data is end of file, 8011 (l.8448-8449); the 8012 of a short record is non-STREAM only (l.8444-8446, FIL-0099)
100 PRINT "FIL-0141 END OF FILE DURING READ OF A STREAM FILE LEAVES UNFILLED VARIABLES, POINTER AT END, EXCEPTION 8011 (11.4.4.8)"
110 OPEN #1: NAME "FIL0141.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
120 WRITE #1: 1
130 CLOSE #1
140 OPEN #2: NAME "FIL0141.DAT", ACCESS INPUT, ORGANIZATION STREAM, RECTYPE INTERNAL
150 LET A = 55
160 LET B = 77
170 LET OK = 0
180 WHEN EXCEPTION IN
190   READ #2: A, B
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE = 8011 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 ASK #2: POINTER P$
250 CLOSE #2
260 IF OK = 1 AND A = 1 AND B = 77 AND P$ = "END" THEN PRINT "*** TEST PASSED ***"
270 IF NOT (OK = 1 AND A = 1 AND B = 77 AND P$ = "END") THEN PRINT "*** TEST FAILED: OK="; OK; " A="; A; " B="; B; " P="; P$
280 END
