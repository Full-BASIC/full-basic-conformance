1 REM FBCS FIL-0281
2 REM CLAIM A-11.4.4.6-03
3 REM TYPE INPUT
100 REM LINE INPUT #0 AND MAT LINE INPUT #0 ASSIGN A LINE TO A STRING VARIABLE LIKE LINE INPUT (11.4.4.6
102 REM L.8205-8209, 11.4.4.4 L.8176-8187): A LINE LONGER THAN THE LENGTH-MAX IS 1054 (10.2.5 L.5259-5261)
104 REM AND THE CURRENT LINE-INPUT-REPLY IS ASKED AGAIN. THE FIRST VARIABLE RESTARTS THE STATEMENT; FROM THE
106 REM SECOND ON ONLY THE CURRENT LINE IS ASKED AGAIN (10.2.4.2 L.5218-5228). THE REPLIES ARE IN FIL-0281.IN.
110 OPTION BASE 1
120 DECLARE STRING A$*3, B$*3, S$(3)*3, T$(2)*3
130 LET BAD = 0
140 REM CASE 1: ABCDE IS 1054 FOR THE FIRST VARIABLE: ABCDE / XY
150 LINE INPUT #0: A$
160 IF A$ <> "XY" THEN LET BAD = BAD + 1
170 REM CASE 2: 1054 IN THE SECOND VARIABLE ASKS ONLY THAT LINE AGAIN: AB / ABCDE / XY
180 LINE INPUT #0: A$, B$
190 IF A$ <> "AB" OR B$ <> "XY" THEN LET BAD = BAD + 1
200 REM CASE 3: 1054 IN THE FIRST VARIABLE ASKS FOR THE STATEMENT AGAIN: ABCDE / AB / CD
210 LINE INPUT #0: A$, B$
220 IF A$ <> "AB" OR B$ <> "CD" THEN LET BAD = BAD + 1
230 REM CASE 4: MAT LINE INPUT #0, 1054 IN THE SECOND LINE: AB / ABCDE / XY
240 MAT LINE INPUT #0: T$
250 IF T$(1) <> "AB" OR T$(2) <> "XY" THEN LET BAD = BAD + 1
260 REM CASE 5: MAT LINE INPUT #0, 1054 IN THE THIRD LINE: AB / CD / ABCDE / XY
270 MAT LINE INPUT #0: S$
280 IF S$(1) <> "AB" OR S$(2) <> "CD" OR S$(3) <> "XY" THEN LET BAD = BAD + 1
290 REM CASE 6: A LINE THAT FITS IS KEPT WHOLE, WITH ITS SPACES: ' A '
300 LINE INPUT #0: A$
310 IF A$ <> " A " OR LEN(A$) <> 3 THEN LET BAD = BAD + 1
320 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; BAD
330 END
