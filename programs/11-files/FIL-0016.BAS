1 REM FBCS FIL-0016
2 REM CLAIM A-11.2.4.2-02
3 REM TYPE SELF
100 PRINT "FIL-0016 PRINT # WITH IF THERE ON A SEQUENTIAL FILE, RECORD AT THE POINTER: RECOVERY TAKEN, FILE UNCHANGED (11.2.4.2)"
110 OPEN #1: NAME "FIL0016.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "ALPHA"
130 PRINT #1, BEGIN, IF THERE THEN 200: "BETA"
140 PRINT "*** TEST FAILED: IF THERE NOT TAKEN"
150 GOTO 999
200 CLOSE #1
210 OPEN #2: NAME "FIL0016.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
220 LINE INPUT #2: A$
230 LET B$ = "NONE"
240 WHEN EXCEPTION IN
250 LINE INPUT #2: B$
260 USE
270 REM END OF FILE REACHED
280 END WHEN
290 CLOSE #2
300 IF A$ = "ALPHA" AND B$ = "NONE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
999 END
