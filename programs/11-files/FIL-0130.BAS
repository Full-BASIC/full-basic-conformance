1 REM FBCS FIL-0130
2 REM CLAIM A-11.3.4.11-04
3 REM TYPE SELF
100 PRINT "FIL-0130 SKIP IN A FIELD COUNT PRODUCES SKIPPED FIELDS WITHOUT CONSUMING OPERANDS (11.3.4.11)"
110 OPEN #1: NAME "FIL0130.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: SKIP 1 OF NUMERIC*2.0, STRING*3
130 WRITE #1, WITH 120: "AB"
140 CLOSE #1
150 OPEN #2: NAME "FIL0130.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 TEMPLATE: NUMERIC*2.0, STRING*3
170 READ #2, WITH 160: X, Y$
180 CLOSE #2
190 IF X = 0 AND Y$ = "AB " THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: X="; X; " <"; Y$; ">"
200 END
