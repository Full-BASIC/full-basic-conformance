1 REM FBCS FIL-0112
2 REM CLAIM E-1105
3 REM TYPE SELF
100 PRINT "FIL-0112 STRING OVERFLOW ON ASSIGNMENT FROM A FILE (11.4.5.3)"
110 DECLARE STRING*4 S$
120 OPEN #1: NAME "FIL0112.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
130 WRITE #1: "ABCDEFGH"
140 CLOSE #1
150 OPEN #2: NAME "FIL0112.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
160 LET OK = 0
170 WHEN EXCEPTION IN
180   READ #2: S$
190   PRINT "*** TEST FAILED: NO EXCEPTION ***"
200 USE
210   IF EXTYPE = 1105 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
220 END WHEN
230 CLOSE #2
240 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 END
