1 REM FBCS FIL-0121
2 REM CLAIM A-11.3.4.3-01
3 REM TYPE SELF
100 PRINT "FIL-0121 WITHOUT A LENGTH INDEX THE EFFECTIVE MARGIN IS AT LEAST THE DEFAULT ZONE WIDTH (11.3.4.3)"
110 OPEN #1: NAME "FIL0121.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY, RECSIZE VARIABLE
120 ASK #1: ZONEWIDTH Z
130 PRINT #1: REPEAT$("X", 100)
140 SET #1: POINTER BEGIN
150 LINE INPUT #1: L$
160 CLOSE #1
170 IF LEN(L$) = 100 AND Z > 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: Z="; Z; " LEN="; LEN(L$)
180 END
