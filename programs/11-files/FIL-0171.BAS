1 REM FBCS FIL-0171
2 REM CLAIM D-11.4-2
3 REM TYPE SELF
100 PRINT "FIL-0171 PROMPT AND TIMEOUT CONTROLS ARE ACCEPTED AND IGNORED ON TRUE FILES (11.4, App C)"
110 OPEN #1: NAME "FIL0171.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "R1"
130 CLOSE #1
140 OPEN #2: NAME "FIL0171.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 INPUT #2, PROMPT "P>", TIMEOUT 5, ELAPSED T: A$
160 CLOSE #2
170 IF A$ = "R1" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
180 END
