1 REM FBCS FIL-0040
2 REM CLAIM A-11.1.4.1-02
3 REM TYPE SELF
100 PRINT "FIL-0040 AFTER OPEN A TRUE FILE IS ACCESSIBLE PER ITS ATTRIBUTES; IMPOSSIBLE ACCESS RAISES 71XX (11.1.4.1)"
110 OPEN #1: NAME "FIL0040.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "DATA"
130 ASK #1: ACCESS A$, ORGANIZATION O$, RECTYPE R$
140 CLOSE #1
150 LET OK = 0
160 WHEN EXCEPTION IN
170   OPEN #2: NAME "FIL0040.NOFILE", ACCESS INPUT
180   PRINT "*** TEST FAILED: NO EXCEPTION ***"
190 USE
200   IF EXTYPE > 7100 AND EXTYPE <= 7199 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
210 END WHEN
220 IF A$ = "OUTIN" AND O$ = "SEQUENTIAL" AND R$ = "DISPLAY" AND OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED ***"
230 END
