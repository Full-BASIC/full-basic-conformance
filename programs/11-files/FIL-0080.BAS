1 REM FBCS FIL-0080
2 REM CLAIM E-7050
3 REM TYPE SELF
100 PRINT "FIL-0080 REOPENING A KEYED FILE WITH A DIFFERENT COLLATE SEQUENCE RAISES 7050 (11.1.5)"
110 OPEN #1: NAME "FIL0080.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 WRITE #1, KEY "A": "FIRST"
130 CLOSE #1
140 LET OK = 0
150 WHEN EXCEPTION IN
160   OPEN #2: NAME "FIL0080.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY, COLLATE NATIVE
170   PRINT "*** TEST FAILED: NO EXCEPTION ***"
180 USE
190   IF EXTYPE = 7050 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
200 END WHEN
210 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
220 END
