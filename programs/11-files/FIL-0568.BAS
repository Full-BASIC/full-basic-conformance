1 REM FBCS FIL-0568
2 REM CLAIM A-11.3.4.1-CL33
3 REM TYPE SELF
4 REM STD 11.3.4.1 l.7573-7578: an open partial record is completed when the channel is closed
100 PRINT "FIL-0568 CLOSE COMPLETES AN OPEN PARTIAL RECORD (11.3.4.1)"
110 LET OK = 0
120 OPEN #1: NAME "FIL0568.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
130 ERASE #1
140 PRINT #1: "partial";
150 CLOSE #1
160 OPEN #1: NAME "FIL0568.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
170 SET #1: POINTER END
180 PRINT #1: "next"
190 CLOSE #1
200 OPEN #1: NAME "FIL0568.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 LINE INPUT #1: A$
220 LINE INPUT #1: B$
230 WHEN EXCEPTION IN
240   LINE INPUT #1: C$
250   PRINT "*** TEST FAILED: THIRD RECORD ***"
260 USE
270   LET OK = OK + 1
280 END WHEN
290 CLOSE #1
300 IF A$ = "partial" THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: A$ = "; A$
310 IF B$ = "next" THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: B$ = "; B$
320 IF OK = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
330 END
