1 REM FBCS FIL-0220
2 REM CLAIM A-11.3.4-TR67
3 REM TYPE SELF
4 REM STD 11.3.4 l.7517-7524: the second phase of a data creation statement sets the
5 REM pointer from the record-setter; if data-found is true the io-recovery-action is
6 REM taken (IF THERE) or an exception results (7308), and no further change is made
7 REM to the pointer position or the file: the pointer stays AT the existing record.
10 LET OK = 1
20 OPEN #1: NAME "FIL0220K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
30 WRITE #1, KEY "A": 1
40 WRITE #1, KEY "B": 2
50 WRITE #1, KEY "C": 3
60 SET #1: KEY "A"
70 WRITE #1, KEY "B", IF THERE THEN 100: 9
80 PRINT "FALLO-KEYED-NO-ENCONTRADO"
90 LET OK = 0
100 ASK #1: KEY K$
110 READ #1: X
120 IF K$ <> "B" OR X <> 2 THEN LET OK = 0
130 IF K$ <> "B" OR X <> 2 THEN PRINT "FALLO-KEYED-IF-THERE"; K$; X
140 SET #1: KEY "A"
150 WHEN EXCEPTION IN
160   WRITE #1, KEY "B": 9
170   LET OK = 0
180 USE
190   LET E = EXTYPE
200   ASK #1: KEY K$
210 END WHEN
220 READ #1: X
230 IF E <> 7308 OR K$ <> "B" OR X <> 2 THEN LET OK = 0
240 IF E <> 7308 OR K$ <> "B" OR X <> 2 THEN PRINT "FALLO-KEYED-7308"; E; K$; X
250 CLOSE #1
260 OPEN #2: NAME "FIL0220R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
270 WRITE #2, RECORD 1: 1
280 WRITE #2, RECORD 2: 2
290 SET #2: RECORD 1
300 WRITE #2, RECORD 2, IF THERE THEN 330: 9
310 PRINT "FALLO-RELATIVE-NO-ENCONTRADO"
320 LET OK = 0
330 ASK #2: RECORD R
340 READ #2: Y
350 IF R <> 2 OR Y <> 2 THEN LET OK = 0
360 IF R <> 2 OR Y <> 2 THEN PRINT "FALLO-RELATIVE-IF-THERE"; R; Y
370 SET #2: RECORD 1
380 WHEN EXCEPTION IN
390   WRITE #2, RECORD 2: 9
400   LET OK = 0
410 USE
420   LET E = EXTYPE
430   ASK #2: RECORD R
440 END WHEN
450 READ #2: Y
460 IF E <> 7308 OR R <> 2 OR Y <> 2 THEN LET OK = 0
470 IF E <> 7308 OR R <> 2 OR Y <> 2 THEN PRINT "FALLO-RELATIVE-7308"; E; R; Y
480 CLOSE #2
490 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
500 END
