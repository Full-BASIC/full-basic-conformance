1 REM FBCS FIL-0341
2 REM CLAIM A-11.3.4-TR87B
3 REM TYPE SELF
4 REM STD 11.3.4 l.7507-7514 (phase 1: attribute exceptions, nothing changes), l.7516-7524
5 REM (phase 2: data-found without recovery is exception 7308) and l.7525-7528 (phase 3: the
6 REM operands are evaluated only now): a failing operand or a function with side effects is not
7 REM evaluated when the WRITE ends in phase 1 (7302) or phase 2 (7308).
10 FUNCTION F$(X$)
20   LET C = C + 1
30   LET F$ = X$
40 END FUNCTION
50 LET OK = 1
60 LET C = 0
100 OPEN #1: NAME "FIL0341R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
110 WRITE #1, RECORD 1: "A"
120 WHEN EXCEPTION IN
130   WRITE #1, RECORD 1: 1/0
140 USE
150   LET E1 = EXTYPE
160 END WHEN
170 WHEN EXCEPTION IN
180   WRITE #1, RECORD 1: F$("P")
190 USE
200   LET E2 = EXTYPE
210 END WHEN
220 READ #1, RECORD 1: X$
230 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN LET OK = 0
240 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN PRINT "FALLO-RELATIVE-7308"; E1; E2; C; X$
250 CLOSE #1
300 OPEN #2: NAME "FIL0341K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
310 WRITE #2, KEY "A": "A"
320 WHEN EXCEPTION IN
330   WRITE #2, KEY "A": 1/0
340 USE
350   LET E1 = EXTYPE
360 END WHEN
370 WHEN EXCEPTION IN
380   WRITE #2, KEY "A": F$("P")
390 USE
400   LET E2 = EXTYPE
410 END WHEN
420 READ #2, KEY "A": X$
430 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN LET OK = 0
440 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN PRINT "FALLO-KEYED-7308"; E1; E2; C; X$
450 CLOSE #2
500 OPEN #3: NAME "FIL0341S.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
510 WRITE #3: "A"
520 SET #3: POINTER BEGIN
530 WHEN EXCEPTION IN
540   WRITE #3: 1/0
550 USE
560   LET E1 = EXTYPE
570 END WHEN
580 WHEN EXCEPTION IN
590   WRITE #3: F$("P")
600 USE
610   LET E2 = EXTYPE
620 END WHEN
630 SET #3: POINTER BEGIN
640 READ #3: X$
650 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN LET OK = 0
660 IF E1 <> 7308 OR E2 <> 7308 OR C <> 0 OR X$ <> "A" THEN PRINT "FALLO-SEQUENTIAL-7308"; E1; E2; C; X$
670 CLOSE #3
700 OPEN #4: NAME "FIL0341P.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
710 PRINT #4: "A"
720 SET #4: POINTER BEGIN
730 WHEN EXCEPTION IN
740   PRINT #4: 1/0
750 USE
760   LET E1 = EXTYPE
770 END WHEN
780 SET #4: POINTER BEGIN
790 LINE INPUT #4: X$
800 IF E1 <> 7308 OR X$ <> "A" THEN LET OK = 0
810 IF E1 <> 7308 OR X$ <> "A" THEN PRINT "FALLO-PRINT-7308"; E1; X$
820 CLOSE #4
900 OPEN #5: NAME "FIL0341W.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
910 WRITE #5, RECORD 1: "A"
920 CLOSE #5
930 OPEN #5: NAME "FIL0341W.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE INTERNAL
940 WHEN EXCEPTION IN
950   WRITE #5, RECORD 2: 1/0
960 USE
970   LET E1 = EXTYPE
980 END WHEN
990 WHEN EXCEPTION IN
1000   WRITE #5, RECORD 2: F$("P")
1010 USE
1020   LET E2 = EXTYPE
1030 END WHEN
1040 WHEN EXCEPTION IN
1050   WRITE #5, RECORD 1, IF THERE THEN 1100: 1/0
1060 USE
1070   LET E3 = EXTYPE
1080 END WHEN
1090 GOTO 1120
1100 LET E3 = 0
1110 REM 7302 comes before the recovery of phase 2
1120 IF E1 <> 7302 OR E2 <> 7302 OR E3 <> 7302 OR C <> 0 THEN LET OK = 0
1130 IF E1 <> 7302 OR E2 <> 7302 OR E3 <> 7302 OR C <> 0 THEN PRINT "FALLO-7302"; E1; E2; E3; C
1140 CLOSE #5
1200 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
1210 END
