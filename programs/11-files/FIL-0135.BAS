1 REM FBCS FIL-0135
2 REM CLAIM A-11.4.4.1-01
3 REM TYPE SELF
100 PRINT "FIL-0135 RECORD ENDING IN A COMMA FOLLOWED BY EOF LEAVES UNFILLED VARIABLES AND RAISES (11.4.4.1)"
110 OPEN #1: NAME "FIL0135.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "1,"
130 CLOSE #1
140 OPEN #2: NAME "FIL0135.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LET B = 99
160 LET OK = 0
170 WHEN EXCEPTION IN
180   INPUT #2: A, B
190   PRINT "*** TEST FAILED: NO EXCEPTION ***"
200 USE
210   IF EXTYPE = 8011 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
220 END WHEN
230 ASK #2: POINTER P$
240 CLOSE #2
250 IF OK = 1 AND B = 99 AND P$ = "END" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK; " B="; B; " P="; P$
260 END
