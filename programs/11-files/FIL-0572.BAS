1 REM FBCS FIL-0572
2 REM CLAIM A-11.1.4.7-CL39
3 REM TYPE SELF
4 REM STD 11.1.4.7 l.6902-6906: files opened by an external procedure on its own channels are closed on exit
100 PRINT "FIL-0572 EXTERNAL SUB EXIT CLOSES ITS FILES (11.1.4.7)"
110 LET OK = 0
115 DECLARE EXTERNAL SUB W
120 CALL W
130 WHEN EXCEPTION IN
140   PRINT #3: "x"
150   PRINT "*** TEST FAILED: CHANNEL 3 STILL OPEN ***"
160 USE
170   IF EXTYPE = 7004 THEN LET OK = OK + 1
180 END WHEN
190 OPEN #1: NAME "FIL0572.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
200 SET #1: POINTER END
210 PRINT #1: "next"
220 CLOSE #1
230 OPEN #1: NAME "FIL0572.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
240 LINE INPUT #1: A$
250 LINE INPUT #1: B$
260 CLOSE #1
270 IF A$ = "partial" THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: A$ = "; A$
280 IF B$ = "next" THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: B$ = "; B$
290 IF OK = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
300 END
400 EXTERNAL SUB W
410 OPEN #3: NAME "FIL0572.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
420 PRINT #3: "partial";
430 END SUB
