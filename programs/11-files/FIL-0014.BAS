1 REM FBCS FIL-0014
2 REM CLAIM A-11.3.4.1-01
3 REM TYPE SELF
100 PRINT "FIL-0014 ONE PRINT # STATEMENT CREATES EXACTLY ONE RECORD (11.3.4.1)"
110 OPEN #1: NAME "FIL0014.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
120 PRINT #1: "AB"; "CD"
130 CLOSE #1
140 OPEN #2: NAME "FIL0014.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 LET B$ = "NONE"
170 WHEN EXCEPTION IN
180 LINE INPUT #2: B$
190 USE
200 REM END OF FILE REACHED
210 END WHEN
220 CLOSE #2
230 IF A$ = "ABCD" AND B$ = "NONE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
999 END
