1 REM FBCS FIL-0190
2 REM CLAIM A-11.3.4.1-05
3 REM TYPE SELF
4 REM A partial record left by PRINT # is completed with an end-of-record when the next
5 REM operation of the channel is not a print-statement (STD 11.3.4.1 l.7573-7577).
100 PRINT "FIL-0190 PARTIAL RECORD OF A RELATIVE FILE IS COMPLETED BY CLOSE AND BY MAT PRINT (11.3.4.1 l.7573-7577)"
110 DIM M(1)
120 LET M(1) = 1
130 OPEN #1: NAME "FIL0190A.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
140 PRINT #1: "A";
150 CLOSE #1
160 OPEN #1: NAME "FIL0190A.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
170 LINE INPUT #1, IF MISSING THEN 330: A$
180 LINE INPUT #1, IF MISSING THEN 200: A2$
190 LET A2$ = "EXTRA"
200 CLOSE #1
210 OPEN #2: NAME "FIL0190B.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
220 PRINT #2: "B";
230 MAT PRINT #2: M
240 CLOSE #2
250 OPEN #2: NAME "FIL0190B.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
260 LINE INPUT #2, IF MISSING THEN 330: B1$
270 LINE INPUT #2, IF MISSING THEN 330: B2$
280 CLOSE #2
290 IF A$ = "A" AND A2$ = "" AND B1$ = "B" AND B2$ = " 1 " THEN 310
300 PRINT "*** TEST FAILED ***"; A$; "|"; B1$; "|"; B2$
305 GOTO 340
310 PRINT "*** TEST PASSED ***"
320 GOTO 340
330 PRINT "*** TEST FAILED: MISSING RECORD ***"
340 END
