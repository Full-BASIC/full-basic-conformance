1 REM FBCS FIL-0057
2 REM CLAIM A-11.1.4.6-02
3 REM TYPE SELF
100 DECLARE EXTERNAL SUB READIT
110 PRINT "FIL-0057 A PROGRAM UNIT WITH A DIFFERENT COLLATE SEQUENCE CAN STILL ACCESS A KEYED FILE (11.1.4.6)"
120 OPEN #1: NAME "FIL0057.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY, COLLATE NATIVE
130 WRITE #1, KEY "B": "SECOND"
140 WRITE #1, KEY "A": "FIRST"
150 CLOSE #1
160 LET OK = 0
170 CALL READIT(OK)
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
190 END
200 EXTERNAL SUB READIT(OK)
210 OPTION COLLATE STANDARD
220 LET S$ = ""
230 OPEN #1: NAME "FIL0057.DAT", ACCESS INPUT, ORGANIZATION KEYED, RECTYPE DISPLAY, COLLATE NATIVE
240 SET #1: KEY >= "A"
250 LINE INPUT #1: S$
260 IF S$ = "FIRST" THEN LET OK = 1
270 CLOSE #1
280 END SUB
