1 REM FBCS FIL-0157
2 REM CLAIM D-11.1-5
3 REM TYPE SELF
100 PRINT "FIL-0157 REOPENING WITH A DIFFERENT ORGANIZATION OR RECTYPE STILL ACCESSES THE FILE (11.1.4.1, App C)"
110 OPEN #1: NAME "FIL0157.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "DATA"
130 CLOSE #1
140 OPEN #2: NAME "FIL0157.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150 ASK #2: ORGANIZATION O$
160 CLOSE #2
170 OPEN #3: NAME "FIL0157.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
180 LET OK = 0
190 WHEN EXCEPTION IN
200   READ #3: X
210 USE
220   LET OK = 1
230 END WHEN
240 CLOSE #3
250 IF O$ = "RELATIVE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; O$
260 END
