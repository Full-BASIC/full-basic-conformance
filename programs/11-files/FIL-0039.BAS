1 REM FBCS FIL-0039
2 REM CLAIM A-11.1.4.1-01
3 REM TYPE SELF
100 PRINT &
&"FIL-0039 AFTER OPEN THE CHANNEL IS ACTIVE; REOPENING AN ACTIVE CHANNEL RAISES 7003; TWO CHANNELS MAY BE ACTIVE (11.1.4.1)"
110 OPEN #1: NAME "FIL0039.DAT", ACCESS OUTIN
120 ASK #1: NAME N1$
130 OPEN #2: NAME "FIL0039B.DAT", ACCESS OUTIN
140 ASK #2: NAME N2$
150 LET OK = 0
160 WHEN EXCEPTION IN
170   OPEN #1: NAME "FIL0039C.DAT", ACCESS OUTIN
180   PRINT "*** TEST FAILED: NO EXCEPTION ON REOPEN ***"
190 USE
200   IF EXTYPE = 7003 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
210 END WHEN
220 IF N1$ <> "" AND N2$ <> "" AND OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 CLOSE #1
240 CLOSE #2
250 END
