1 REM FBCS FIL-0160
2 REM CLAIM D-11.1-10
3 REM TYPE SELF
100 PRINT "FIL-0160 INTERNAL RECORD VALUES ROUND-TRIP TYPED (11.1.4.5, App C)"
110 OPEN #1: NAME "FIL0160.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
120 WRITE #1: 2.5, "STR", -7
130 CLOSE #1
140 OPEN #2: NAME "FIL0160.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
150 READ #2: X, S$, Y
160 CLOSE #2
170 IF X = 2.5 AND S$ = "STR" AND Y = -7 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
