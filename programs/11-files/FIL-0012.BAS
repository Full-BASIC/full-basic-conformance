1 REM FBCS FIL-0012
2 REM CLAIM A-11.3.4.2-01
3 REM TYPE SELF
100 PRINT "FIL-0012 MAT PRINT # WRITES THE ARRAY AS A DISPLAY RECORD (11.3.4.2)"
110 DIM M(2)
120 LET M(1) = 7
130 LET M(2) = 9
140 OPEN #1: NAME "FIL0012.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150 MAT PRINT #1: M;
160 CLOSE #1
170 OPEN #2: NAME "FIL0012.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
180 LINE INPUT #2: A$
190 CLOSE #2
200 IF POS(A$, "7") > 0 AND POS(A$, "9") > POS(A$, "7") THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED: RECORD IS ["; A$; "]"
999 END
