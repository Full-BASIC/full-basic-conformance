100 PRINT "FIL-0137 LINE INPUT KEEPS LEADING AND TRAILING SPACES AND ASSIGNS A NULL RECORD (11.4.4.4)"
110 OPEN #1: NAME "FIL0137.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "  SPACED  "
130 PRINT #1: ""
140 CLOSE #1
150 OPEN #2: NAME "FIL0137.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
