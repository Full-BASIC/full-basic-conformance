1 REM FBCS FIL-0018
2 REM CLAIM A-11.1.5-01
3 REM TYPE SELF
100 PRINT "FIL-0018 OPEN OF A NONEXISTENT FILE WITH ACCESS INPUT RAISES 71XX (11.1.5)"
110 WHEN EXCEPTION IN
120   OPEN #1: NAME "FIL0018.NOFILE", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
130   PRINT "*** TEST FAILED: NO EXCEPTION ***"
140 USE
150   IF EXTYPE > 7100 AND EXTYPE <= 7199 AND EXLINE = 120 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE"; &
&EXTYPE; "EXLINE"; EXLINE
160 END WHEN
170 END
