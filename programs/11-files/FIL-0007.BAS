1 REM FBCS FIL-0007
2 REM CLAIM E-7322
3 REM TYPE SELF
100 PRINT "FIL-0007 REWRITE ON AN INPUT FILE (11.5.5.1)"
110 OPEN #1: NAME "DATA.DAT", ORGANIZATION RELATIVE, ACCESS OUTIN, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 99
120 WRITE #1, RECORD 1: 1
130 CLOSE #1
140 OPEN #1: NAME "DATA.DAT", ORGANIZATION RELATIVE, ACCESS INPUT, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 99
150 LET OK = 0
160 WHEN EXCEPTION IN
170   REWRITE #1, RECORD 1: 2
180   PRINT "*** TEST FAILED: NO EXCEPTION ***"
190 USE
200   IF EXTYPE = 7322 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
210 END WHEN
220 CLOSE #1
230 OPEN #1: NAME "DATA.DAT", ORGANIZATION RELATIVE, ACCESS OUTIN, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 99
240 READ #1, RECORD 1: X
250 CLOSE #1
260 IF OK = 1 AND X = 1 THEN PRINT "*** TEST PASSED ***"
270 IF OK = 1 AND X <> 1 THEN PRINT "*** TEST FAILED: RECORD CHANGED"; X
280 END
