1 REM FBCS FIL-0128
2 REM CLAIM A-11.3.4.11-02
3 REM TYPE SELF
100 PRINT "FIL-0128 A TEMPLATE IDENTIFIER AS A STRING EXPRESSION IS EVALUATED AND USED (11.3.4.11)"
110 OPEN #1: NAME "FIL0128.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 LET T$ = "NUMERIC*3.2"
