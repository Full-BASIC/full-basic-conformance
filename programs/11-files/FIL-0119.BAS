100 PRINT "FIL-0119 ALL FORMS OF THE EXAMPLES OF 11.3.3 ARE ACCEPTED (11.3.3)"
110 LET N = 20
120 LET A = 1
130 LET B = 2
140 LET C = 3
150 LET A$ = "SA"
160 LET B$ = "SB"
170 LET C$ = "SC"
180 LET D$ = "SD"
190 LET X = 5
200 LET Y = 6
210 LET Z = 7
220 LET W = 8
