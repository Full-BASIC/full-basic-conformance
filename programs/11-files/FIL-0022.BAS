1 REM FBCS FIL-0022
2 REM CLAIM A-11.3.4.1-03
3 REM TYPE SELF
100 PRINT "FIL-0022 PRINT # WITHOUT ITEMS CREATES AN EMPTY RECORD (11.3.4.1)"
110 LET OK = 1
120 FOR K = 1 TO 2
130   IF K = 1 THEN OPEN #1: NAME "FIL0022.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
140   IF K = 2 THEN OPEN #1: NAME "FIL0022B.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150   PRINT #1
160   PRINT #1: "A"
170   CLOSE #1
180   IF K = 1 THEN OPEN #2: NAME "FIL0022.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
190   IF K = 2 THEN OPEN #2: NAME "FIL0022B.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
200   LINE INPUT #2: A$
210   LINE INPUT #2: B$
220   CLOSE #2
230   IF A$ <> "" OR B$ <> "A" THEN LET OK = 0
240 NEXT K
250 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
999 END
