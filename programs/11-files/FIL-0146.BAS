1 REM FBCS FIL-0146
2 REM CLAIM A-11.4.4.11-01
3 REM TYPE SELF
100 PRINT "FIL-0146 NATIVE READ ALWAYS NEEDS A TEMPLATE AND NO OTHER RECORD TYPE MAY USE ONE (11.4.4.11)"
110 OPEN #1: NAME "FIL0146.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*3.2
130 WRITE #1, WITH 120: 42
140 CLOSE #1
150 OPEN #2: NAME "FIL0146.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 LET OK1 = 0
170 WHEN EXCEPTION IN
180   READ #2: X
190   PRINT "*** TEST FAILED: NATIVE READ WITHOUT TEMPLATE ***"
200 USE
210   IF EXTYPE = 7316 THEN LET OK1 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
220 END WHEN
230 CLOSE #2
240 OPEN #3: NAME "FIL0146B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
250 PRINT #3: "D"
260 CLOSE #3
270 OPEN #4: NAME "FIL0146B.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
280 TEMPLATE: NUMERIC*3.2
290 LET OK2 = 0
300 WHEN EXCEPTION IN
310   READ #4, WITH 280: Y
320   PRINT "*** TEST FAILED: TEMPLATE ON DISPLAY READ ***"
330 USE
340   IF EXTYPE = 7315 THEN LET OK2 = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
350 END WHEN
360 CLOSE #4
370 IF OK1 = 1 AND OK2 = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; OK1; " "; OK2
380 END
