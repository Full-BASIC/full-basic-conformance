1 REM FBCS FIL-0501
2 REM CLAIM A-11.1.2-TR176
3 REM TYPE OUTPUT
4 REM STD 11.1.2 prod. 3, 5.2.4: a channel number that is not an integer is rounded with INT(X+.5); #1.4 and #0.6
5 REM are channel 1 in OPEN, PRINT, SET, LINE INPUT, ASK and CLOSE.
100 LET C = 1.4
110 OPEN #C: NAME "FIL0501.DAT", ACCESS OUTIN
120 PRINT #C: "X"
130 PRINT #0.6: "Y"
140 SET #C: POINTER BEGIN
150 ASK #1.49: POINTER P$
160 PRINT P$
170 LINE INPUT #C: A$
180 LINE INPUT #0.6: B$
190 PRINT A$; B$
200 CLOSE #C
210 OPEN #1: NAME "FIL0501.DAT", ACCESS INPUT
220 CLOSE #1
230 END
