1 REM FBCS FIL-0132
2 REM CLAIM A-11.3.4.12-02
3 REM TYPE SELF
4 REM The fixed count 2 takes the first two elements of the array, so the variable count ?
5 REM meets the array in the middle: 8253 (11.3.4.12 l.7846-7848, 11.3.5.3 l.7919-7920).
100 PRINT "FIL-0132 AN ARRAY NEVER USES BOTH A VARIABLE AND FIXED FIELD COUNTS (11.3.4.12)"
110 OPEN #1: NAME "FIL0132.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: 2 OF NUMERIC*3.4, ? OF NUMERIC*5.2
130 DIM A(4)
140 FOR I = 1 TO 4
150   LET A(I) = I
160 NEXT I
170 LET OK = 0
180 WHEN EXCEPTION IN
190   MAT WRITE #1, WITH 120: A
200   PRINT "*** TEST FAILED: MIXED COUNTS ACCEPTED ***"
210 USE
220   IF EXTYPE = 8253 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 CLOSE #1
250 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 END
