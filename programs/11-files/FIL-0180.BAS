1 REM FBCS FIL-0180
2 REM CLAIM A-11.4.4.5-G01
3 REM TYPE SELF
100 PRINT "FIL-0180 MAT LINE INPUT # READS ONE RECORD PER ARRAY ELEMENT (11.4.4.5)"
110 OPEN #1: NAME "FIL0180.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "UNO"
130 PRINT #1: "DOS"
140 PRINT #1: "TRES"
150 CLOSE #1
160 DIM A$(3)
170 OPEN #2: NAME "FIL0180.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
180 MAT LINE INPUT #2: A$
190 CLOSE #2
200 IF A$(1)="UNO" AND A$(2)="DOS" AND A$(3)="TRES" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
999 END
