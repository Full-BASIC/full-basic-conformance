1 REM FBCS FIL-0020
2 REM CLAIM A-11.1.5-03
3 REM TYPE SELF
100 PRINT "FIL-0020 OPEN WITH ACCESS INPUT OF AN EXISTING FILE STILL SUCCEEDS (11.1)"
110 OPEN #1: NAME "FIL0020.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "HELLO"
130 CLOSE #1
140 WHEN EXCEPTION IN
150   OPEN #2: NAME "FIL0020.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160   LINE INPUT #2: A$
170   CLOSE #2
180 USE
190   PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
200   STOP
210 END WHEN
220 IF A$ = "HELLO" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$
230 END
