1 REM FBCS FIL-0156
2 REM CLAIM D-11.1-4
3 REM TYPE SELF
100 PRINT "FIL-0156 AT LEAST 10 NONZERO CHANNELS MAY BE ACTIVE SIMULTANEOUSLY (11.1.4.1, App C)"
110 LET N = 0
120 FOR C = 1 TO 10
130   OPEN #C: NAME "FIL0156.DAT", ACCESS OUTIN
140   LET N = N + 1
150 NEXT C
160 FOR C = 1 TO 10
170   CLOSE #C
180 NEXT C
190 IF N = 10 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: N="; N
200 END
