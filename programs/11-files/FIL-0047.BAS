1 REM FBCS FIL-0047
2 REM CLAIM A-11.1.4.2-02
3 REM TYPE SELF
100 PRINT "FIL-0047 ACCESS OUTPUT ALLOWS PRINT, WRITE AND SET POINTER, APPENDING ONLY (11.1.4.2)"
110 OPEN #1: NAME "FIL0047.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "OLD"
130 CLOSE #1
140 OPEN #2: NAME "FIL0047.DAT", ACCESS OUTPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 SET #2: POINTER BEGIN
160 ASK #2: POINTER P$
170 SET #2: POINTER END
180 PRINT #2: "NEW"
190 CLOSE #2
200 OPEN #3: NAME "FIL0047.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 LINE INPUT #3: A$
220 LINE INPUT #3: B$
230 CLOSE #3
240 IF P$ = "BEGIN" AND A$ = "OLD" AND B$ = "NEW" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; P$; " <"; A$; &
&"> <"; B$; ">"
250 END
