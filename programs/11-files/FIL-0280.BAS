1 REM FBCS FIL-0280
2 REM CLAIM A-11.4.4.6-02
3 REM TYPE INPUT
100 REM INPUT #0 AND MAT INPUT #0 FOLLOW THE RECOVERY OF INPUT AND MAT INPUT (11.4.4.6 L.8205-8209):
102 REM AN EXCEPTION IN A REPLY THAT IS NOT THE FIRST (A CONTINUATION AFTER A FINAL COMMA) ASKS FOR
104 REM THE CURRENT INPUT-REPLY AGAIN, NOT THE WHOLE STATEMENT (10.2.5 L.5240-5261, 10.5.5 L.6109-6133).
106 REM THE DATA ACCEPTED IN EARLIER REPLIES STAY ASSIGNED. THE REPLIES ARE IN FIL-0280.IN, IN ORDER.
110 OPTION BASE 1
120 DIM M(2), N(3)
130 DECLARE STRING S$(2)*3, A$*3, B$*3
140 LET BAD = 0
150 REM CASE 1: 8103 (NONNUMERIC) IN THE CONTINUATION: REPLIES 1, / Q / 7
160 INPUT #0: A, B
170 IF A <> 1 OR B <> 7 THEN LET BAD = BAD + 1
180 REM CASE 2: 1007 (OVERFLOW): 1, / 1E99999 / 7
190 INPUT #0: A, B
200 IF A <> 1 OR B <> 7 THEN LET BAD = BAD + 1
210 REM CASE 3: 8002 (TOO FEW): 1, / 2 / 5,6   THE RETRY OF THE SECOND REPLY GIVES B AND C
220 INPUT #0: A, B, C
230 IF A <> 1 OR B <> 5 OR C <> 6 THEN LET BAD = BAD + 1
240 REM CASE 4: 8003 (TOO MANY): 1, / 2,3 / 4
250 INPUT #0: A, B
260 IF A <> 1 OR B <> 4 THEN LET BAD = BAD + 1
270 REM CASE 5: 1054 (STRING OVERFLOW, LENGTH-MAX 3): AB, / ABCDE / XY
290 INPUT #0: A$, B$
300 IF A$ <> "AB" OR B$ <> "XY" THEN LET BAD = BAD + 1
310 REM CASE 6: 8102 (SYNTAX): X, / "Y / Z
320 INPUT #0: A$, B$
330 IF A$ <> "X" OR B$ <> "Z" THEN LET BAD = BAD + 1
340 REM CASE 7: MAT INPUT #0, 8103 IN THE CONTINUATION: 1, / Q / 7
350 MAT INPUT #0: M
360 IF M(1) <> 1 OR M(2) <> 7 THEN LET BAD = BAD + 1
370 REM CASE 8: MAT INPUT #0, THE REJECTED REPLY IS REPLACED WHOLE: 1, / 2,Q / 5,6
380 MAT INPUT #0: N
390 IF N(1) <> 1 OR N(2) <> 5 OR N(3) <> 6 THEN LET BAD = BAD + 1
400 REM CASE 9: MAT INPUT #0, 1054 IN THE CONTINUATION: AB, / ABCDE / XY
410 MAT INPUT #0: S$
420 IF S$(1) <> "AB" OR S$(2) <> "XY" THEN LET BAD = BAD + 1
430 REM CASE 10: AN ELEMENT OF AN ARRAY AS THE TARGET (SUBSCRIPTS AFTER THE DATA): 1, / Q / 7
440 MAT M = ZER
450 INPUT #0: M(1), M(2)
460 IF M(1) <> 1 OR M(2) <> 7 THEN LET BAD = BAD + 1
470 REM CONTROL: THE ERROR IN THE FIRST REPLY RESTARTS THE STATEMENT: 4,Q / 4,5
480 INPUT #0: A, B
490 IF A <> 4 OR B <> 5 THEN LET BAD = BAD + 1
500 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; BAD
510 END
