1 REM FBCS FIL-0414
2 REM CLAIM A-11.2.4.1-TR123
3 REM TYPE SELF
4 REM STD 11.2.4.1 l.7205-7208: on a KEYED file NEXT after a READ, after a DELETE and at
5 REM end of file leaves the pointer where the previous operation left it.
100 PRINT "FIL-0414 KEYED NEXT AFTER READ, AFTER DELETE AND AT END OF FILE"
110 OPEN #1: NAME "FIL0414.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 ERASE #1
130 WRITE #1, KEY "A": "ONE"
140 WRITE #1, KEY "B": "TWO"
150 WRITE #1, KEY "C": "THREE"
160 WRITE #1, KEY "D": "FOUR"
170 SET #1: KEY "B"
180 READ #1: S$
190 SET #1: POINTER NEXT
200 ASK #1: KEY K1$
210 READ #1, NEXT: T$
220 DELETE #1, KEY "B"
230 SET #1: KEY "A"
240 READ #1: U$
250 SET #1: POINTER NEXT
260 ASK #1: KEY K2$
270 SET #1: KEY "C"
280 DELETE #1
290 SET #1: POINTER NEXT
300 ASK #1: KEY K3$
310 SET #1: POINTER END
320 SET #1: POINTER NEXT
330 SET #1: POINTER BEGIN
340 LET R$ = ""
350 FOR I = 1 TO 2
360 READ #1, NEXT: V$
370 LET R$ = R$ & V$ & ","
380 NEXT I
390 CLOSE #1
400 LET R$ = S$ & K1$ & T$ & K2$ & K3$ & R$
410 IF R$ = "TWOCTHREECDONE,FOUR," THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; R$
420 END
