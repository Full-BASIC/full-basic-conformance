1 REM FBCS FIL-0505
2 REM CLAIM A-11.2.4.1-05
3 REM TYPE SELF
100 PRINT "FIL-0505 SAME AFTER MAT WRITE AND AFTER WRITE/MAT WRITE WITH (11.2.4.1)"
110 OPTION BASE 1
120 DIM V(2)
130 LET V(1) = 10
140 LET V(2) = 20
150 LET OK = 1
160 WHEN EXCEPTION IN
170   OPEN #1: NAME "FIL0505A.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
180   ERASE #1
190   WRITE #1: 1, 2
200   MAT WRITE #1: V
210   SET #1: POINTER SAME
220   READ #1: X, Y
230   IF X <> 10 OR Y <> 20 THEN LET OK = 0
240   CLOSE #1
250   OPEN #2: NAME "FIL0505B.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
260   ERASE #2
270   WRITE #2, WITH "NUMERIC*3": 5
280   SET #2: POINTER SAME
290   READ #2, WITH "NUMERIC*3": X
300   IF X <> 5 THEN LET OK = 0
310   MAT WRITE #2, WITH "? OF NUMERIC*2": V
320   SET #2: POINTER SAME
330   MAT READ #2, WITH "? OF NUMERIC*2": V
340   IF V(1) <> 10 OR V(2) <> 20 THEN LET OK = 0
350   CLOSE #2
360 USE
370   PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
380   STOP
390 END WHEN
400 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: SAME DID NOT REACH THE FIRST ELEMENT CREATED"
410 END
