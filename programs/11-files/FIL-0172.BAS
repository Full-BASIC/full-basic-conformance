1 REM FBCS FIL-0172
2 REM CLAIM D-11.4-3
3 REM TYPE SELF
100 PRINT "FIL-0172 NUMERIC CONSTANTS FROM DISPLAY RECORDS KEEP THEIR FULL VALUE (11.4.4.9, App C)"
110 OPEN #1: NAME "FIL0172.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "0.1"
130 CLOSE #1
140 OPEN #2: NAME "FIL0172.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 READ #2: B
160 CLOSE #2
170 IF B = 0.1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: B="; B
180 END
