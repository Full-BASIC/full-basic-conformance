1 REM FBCS FIL-0138
2 REM CLAIM A-11.4.4.4-02
3 REM TYPE SELF
100 PRINT "FIL-0138 LINE INPUT AT END OF FILE KEEPS OLD VALUES, POINTER AT END, EXCEPTION (11.4.4.4)"
110 OPEN #1: NAME "FIL0138.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "ONLY"
130 CLOSE #1
140 OPEN #2: NAME "FIL0138.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 LET C$ = "OLD"
170 LET OK = 0
180 WHEN EXCEPTION IN
190   LINE INPUT #2: C$
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE = 7305 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 ASK #2: POINTER P$
250 CLOSE #2
260 IF A$ = "ONLY" AND OK = 1 AND C$ = "OLD" AND P$ = "END" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; &
&"> OK="; OK; " <"; C$; "> P="; P$
270 END
