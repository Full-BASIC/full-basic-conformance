1 REM FBCS FIL-0013
2 REM CLAIM A-11.3.4.2-02
3 REM TYPE SELF
100 PRINT "FIL-0013 MAT PRINT # WITH IF THERE, RECORD PRESENT: RECOVERY TAKEN, FILE UNCHANGED (11.3.4)"
110 DIM M(2)
120 MAT M = CON
130 OPEN #1: NAME "FIL0013.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
140 WRITE #1: "ALPHA"
150 MAT PRINT #1, BEGIN, IF THERE THEN 200: M;
160 PRINT "*** TEST FAILED: IF THERE NOT TAKEN"
170 GOTO 999
200 CLOSE #1
210 OPEN #2: NAME "FIL0013.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
220 LINE INPUT #2: A$
230 LET B$ = "NONE"
240 WHEN EXCEPTION IN
250 LINE INPUT #2: B$
260 USE
270 REM END OF FILE REACHED
280 END WHEN
290 CLOSE #2
300 IF A$ = "ALPHA" AND B$ = "NONE" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
999 END
