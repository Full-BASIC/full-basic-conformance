1 REM FBCS FIL-0600
2 REM CLAIM D-11.2-2
3 REM TYPE INPUT
4 REM STD 11.2.4.2 l.7288-7296: the end of the standard input is the device condition "no data available" (App C)
100 PRINT "FIL-0600 INPUT #0 AND LINE INPUT #0 TAKE IF MISSING AT THE END OF THE STANDARD INPUT"
110 INPUT #0, IF MISSING THEN 190: A
120 INPUT #0, IF MISSING THEN 200: B
130 PRINT "*** TEST FAILED: THE SECOND INPUT FOUND DATA ***"
140 STOP
190 PRINT "*** TEST FAILED: THE FIRST INPUT FOUND NO DATA ***"
195 STOP
200 REM THE SECOND INPUT FOUND THE END OF THE STANDARD INPUT
210 LINE INPUT #0, IF MISSING THEN 230: L$
220 PRINT "*** TEST FAILED: LINE INPUT FOUND DATA ***"
225 STOP
230 DO
240   INPUT #0, IF MISSING THEN EXIT DO: C
250   PRINT "*** TEST FAILED: THE THIRD INPUT FOUND DATA ***"
260   STOP
270 LOOP
280 IF A = 5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: A = "; A
290 END
