1 REM FBCS FIL-0320
2 REM CLAIM A-11.4.4.6-TR84
3 REM TYPE INPUT
100 REM INPUT #0 AND LINE INPUT #0 INTO AN ARRAY ELEMENT, A SUBSTRING, A SUBSTRING OF AN ELEMENT, AN ELEMENT
102 REM OF A FORMAL ARRAY OR A STRING PARAMETER PASSED BY REFERENCE FOLLOW THE DEVICE SEMANTICS (11.4.4.6
104 REM L.8205-8209): A REPLY THAT DOES NOT FIT THE LENGTH-MAX OF THE TARGET IS 1054, NONFATAL (10.2.5
106 REM L.5259-5261), AND THE CURRENT REPLY IS ASKED AGAIN (NOT THE FATAL 1105 OF FILES, 11.4.5.3).
108 REM THE REPLIES ARE IN FIL-0320.IN.
109 DECLARE SUB R
110 DECLARE STRING A$(2)*3, S$*4, B$*3, Q$(2)*3, P$(2)*4
120 LET BAD = 0
130 REM CASE 1: ELEMENT: ABCDE / XY
140 INPUT #0: A$(1)
150 IF A$(1) <> "XY" OR LEN(A$(1)) <> 2 THEN LET BAD = BAD + 1
160 REM CASE 2: LINE INPUT INTO AN ELEMENT: ABCDE / XY
170 LINE INPUT #0: A$(2)
180 IF A$(2) <> "XY" THEN LET BAD = BAD + 1
190 REM CASE 3: SUBSTRING S$(2:3): ABCDE / XY GIVES 1XY4
200 LET S$ = "1234"
210 INPUT #0: S$(2:3)
220 IF S$ <> "1XY4" THEN LET BAD = BAD + 1
230 REM CASE 4: LINE INPUT INTO A SUBSTRING OF AN ELEMENT: ABCDE / XY
260 LET P$(1) = "1234"
270 LINE INPUT #0: P$(1)(2:3)
280 IF P$(1) <> "1XY4" THEN LET BAD = BAD + 1
290 REM CASE 5: PARAMETER BY REFERENCE AND ELEMENT OF A FORMAL ARRAY, INPUT AND LINE INPUT
300 CALL R(B$, Q$)
310 IF B$ <> "XY" THEN LET BAD = BAD + 1
320 IF Q$(1) <> "AB" THEN LET BAD = BAD + 1
330 REM CASE 6: CONTINUATION: ONLY THE SECOND REPLY IS ASKED AGAIN
340 INPUT #0: A$(1), A$(2)
350 IF A$(1) <> "AB" OR A$(2) <> "XY" THEN LET BAD = BAD + 1
360 REM CASE 7: THE SUBSCRIPT READ IN THE SAME STATEMENT
370 LET A$(2) = ""
375 INPUT #0: I, A$(I)
380 IF A$(2) <> "XY" THEN LET BAD = BAD + 1
390 IF BAD = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; BAD
400 SUB R(X$, Y$())
410   INPUT #0: X$
420   LINE INPUT #0: Y$(1)
430 END SUB
440 END
