1 REM FBCS FIL-0502
2 REM CLAIM A-11.1.2-TR176
3 REM TYPE OUTPUT
4 REM STD 11.1.2 prod. 3, 11.1.5 7001 7002, 5.2.4: the channel number is rounded first and then checked: #255.4 is
5 REM channel 255, #255.6 is 256 (7001), #0.4 is channel zero (7002), #-.6 is -1 (7001).
100 WHEN EXCEPTION IN
110   OPEN #255.6: NAME "FIL0502A.DAT", ACCESS OUTPUT
120   PRINT "NOEXC"
130 USE
140   PRINT EXTYPE
150 END WHEN
160 WHEN EXCEPTION IN
170   OPEN #0.4: NAME "FIL0502B.DAT", ACCESS OUTPUT
180   PRINT "NOEXC"
190 USE
200   PRINT EXTYPE
210 END WHEN
220 WHEN EXCEPTION IN
230   OPEN #255.4: NAME "FIL0502C.DAT", ACCESS OUTPUT
240   PRINT "NOEXC"
250 USE
260   PRINT EXTYPE
270 END WHEN
280 WHEN EXCEPTION IN
290   OPEN #-.6: NAME "FIL0502D.DAT", ACCESS OUTPUT
300   PRINT "NOEXC"
310 USE
320   PRINT EXTYPE
330 END WHEN
340 END
