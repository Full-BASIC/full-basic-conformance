1 REM FBCS FIL-0198
2 REM CLAIM A-11.3.4-02
3 REM TYPE SELF
4 REM STD 11.3.4 l.7526-7541: after WRITE #1, RECORD 3: 30 the pointer is at
5 REM record-area 4, which is end of file (11.1.4.3 l.6762-6766): ASK gives
6 REM RECORD=4 POINTER=END. A following WRITE #1: 40 without record-setter creates
7 REM record 4 (7308 only if the pointer identifies an existing record, 11.3.5.2
8 REM l.7904-7908), and READ #1, RECORD 4 reads it back.
10 LET OK = 1
20 OPEN #1: NAME "FIL0198.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
30 WRITE #1, RECORD 3: 30
40 ASK #1: RECORD R, POINTER P$
50 IF R <> 4 OR P$ <> "END" THEN LET OK = 0
60 IF R <> 4 OR P$ <> "END" THEN PRINT "FALLO-ASK"; R; P$
70 WRITE #1: 40
80 ASK #1: RECORD R2, POINTER P2$
90 IF R2 <> 5 OR P2$ <> "END" THEN LET OK = 0
100 IF R2 <> 5 OR P2$ <> "END" THEN PRINT "FALLO-ASK2"; R2; P2$
110 READ #1, RECORD 4: X
120 IF X <> 40 THEN LET OK = 0
130 IF X <> 40 THEN PRINT "FALLO-READ"; X
140 READ #1, RECORD 3: W
150 IF W <> 30 THEN LET OK = 0
160 CLOSE #1
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
