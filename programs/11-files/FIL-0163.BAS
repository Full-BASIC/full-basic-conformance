1 REM FBCS FIL-0163
2 REM CLAIM D-11.1-14
3 REM TYPE SELF
100 PRINT "FIL-0163 71XX FILE-ACCESS FAILURE CODES: 7107 MEANS FILE DOES NOT EXIST (11.1.5, App C)"
110 LET OK = 0
120 WHEN EXCEPTION IN
130   OPEN #1: NAME "FIL0163.NOFILE", ACCESS INPUT
140   PRINT "*** TEST FAILED: NO EXCEPTION ***"
150 USE
160   IF EXTYPE = 7107 AND EXLINE = 130 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE; "EXLINE"; EXLINE
170 END WHEN
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
