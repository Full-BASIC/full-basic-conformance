1 REM FBCS FIL-0261
2 REM CLAIM A-11.3.4-TR71
3 REM TYPE SELF
4 REM STD 11.3.4.8 l.7671-7675: for a non-STREAM, non-DISPLAY file the values form one
5 REM record; if an exception occurs before the statement is completed, no record is
6 REM added to the file (11.3.4 l.7532-7536).
7 REM SEQUENTIAL INTERNAL file: a WRITE # that fails creates no record.
10 LET OK = 1
20 LET N = 0
30 OPEN #1: NAME "FIL0261.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
100 WHEN EXCEPTION IN
110   WRITE #1: 1, 1/0
120 USE
130   LET N = N + 1
140 END WHEN
150 WRITE #1: 2
200 WHEN EXCEPTION IN
210   WRITE #1: 1/0, 1
220 USE
230   LET N = N + 1
240 END WHEN
250 WRITE #1: 3
300 WHEN EXCEPTION IN
310   WRITE #1: 4, 5, 1/0
320 USE
330   LET N = N + 1
340 END WHEN
350 WRITE #1: 6
400 SET #1: POINTER BEGIN
410 READ #1: A
420 READ #1: B
430 READ #1: C
440 LET M = 0
450 READ #1, IF MISSING THEN 480: D
460 LET M = 1
480 IF N <> 3 THEN LET OK = 0
490 IF A <> 2 OR B <> 3 OR C <> 6 OR M <> 0 THEN LET OK = 0
500 IF OK = 0 THEN PRINT "FALLO"; N; A; B; C; M
510 CLOSE #1
520 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
530 END
