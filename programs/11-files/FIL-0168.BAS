1 REM FBCS FIL-0168
2 REM CLAIM D-11.3-3
3 REM TYPE SELF
100 PRINT "FIL-0168 MARGINS AND ZONE WIDTHS UP TO AT LEAST 1000000 ARE SUPPORTED (11.3.4, App C)"
110 OPEN #1: NAME "FIL0168.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 SET #1: MARGIN 1000000
130 SET #1: ZONEWIDTH 1000000
140 ASK #1: MARGIN M, ZONEWIDTH Z
150 CLOSE #1
160 IF M = 1000000 AND Z = 1000000 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: M="; M; " Z="; Z
170 END
