1 REM FBCS FIL-0564
2 REM CLAIM A-11.1.5-CL05
3 REM TYPE OUTPUT
4 REM STD 11.1.5 l.7069-7072: an OPEN whose file name is empty cannot give access to any file; the exception is
5 REM in the implementation-defined 71xx range (fatal), not 7100 (NAME has no recognizable-value rule).
100 LET E$ = ""
110 LET A$ = "abc"
120 WHEN EXCEPTION IN
130   OPEN #1: NAME "", ACCESS OUTIN, ORGANIZATION SEQUENTIAL
140   PRINT "NOEXC"
150 USE
160   PRINT INT(EXTYPE / 100)
170 END WHEN
180 WHEN EXCEPTION IN
190   OPEN #1: NAME E$, ACCESS INPUT
200   PRINT "NOEXC"
210 USE
220   PRINT INT(EXTYPE / 100)
230 END WHEN
240 WHEN EXCEPTION IN
250   OPEN #1: NAME A$(1:0), ACCESS OUTPUT, ORGANIZATION RELATIVE
260   PRINT "NOEXC"
270 USE
280   PRINT INT(EXTYPE / 100)
290 END WHEN
300 END
