1 REM FBCS FIL-0175
2 REM CLAIM D-11.5-1
3 REM TYPE SELF
100 PRINT "FIL-0175 REWRITE AND DELETE ON A SEQUENTIAL FILE RAISE -7500 (11.5, App C)"
110 OPEN #1: NAME "FIL0175.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "ONE"
130 LET OK = 0
140 WHEN EXCEPTION IN
150   REWRITE #1: "TWO"
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = -7500 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 WHEN EXCEPTION IN
210   DELETE #1
220   PRINT "*** TEST FAILED: NO EXCEPTION ***"
230 USE
240   IF EXTYPE = -7500 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
250 END WHEN
260 CLOSE #1
270 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
280 END
