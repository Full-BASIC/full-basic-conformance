1 REM FBCS FIL-0029
2 REM CLAIM A-11-01
3 REM TYPE SELF
100 PRINT "FIL-0029 CREATE, PRESERVE AND RETRIEVE A TRUE FILE (11)"
110 OPEN #1: NAME "FIL0029.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "PERSISTED"
130 CLOSE #1
140 OPEN #2: NAME "FIL0029.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 CLOSE #2
170 IF A$ = "PERSISTED" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
180 END
