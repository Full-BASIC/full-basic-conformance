1 REM FBCS FIL-0002
2 REM CLAIM A-11.3.2-02
3 REM TYPE SELF
100 PRINT "FIL-0002 PRINT # WITH IF THERE, RECORD PRESENT: RECOVERY TAKEN, FILE UNCHANGED (11.3.2)"
110 OPEN #1: NAME "FIL0002.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
120 PRINT #1: "ALPHA"
130 PRINT #1, BEGIN, IF THERE THEN 200: "BETA"
140 PRINT "*** TEST FAILED: IF THERE NOT TAKEN"
150 GOTO 999
200 CLOSE #1
210 OPEN #2: NAME "FIL0002.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
220 LINE INPUT #2: A$
230 LET B$ = "NONE"
240 LET C$ = "NONE"
250 WHEN EXCEPTION IN
260 LINE INPUT #2: B$
270 LINE INPUT #2: C$
280 USE
290 REM END OF FILE REACHED
300 END WHEN
310 CLOSE #2
320 IF A$ = "ALPHA" AND B$ <> "BETA" AND C$ <> "BETA" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; &
&B$; "/"; C$
999 END
