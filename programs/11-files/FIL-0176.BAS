1 REM FBCS FIL-0176
2 REM CLAIM D-11.5-2
3 REM TYPE SELF
100 PRINT "FIL-0176 REWRITE WITH A TEMPLATE WITHOUT SKIP OVER A SKIP-CREATED NATIVE RECORD SUCCEEDS (11.5, App C)"
110 OPEN #1: NAME "FIL0176.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
120 TEMPLATE: SKIP 1 OF NUMERIC*2.0, STRING*3
130 WRITE #1, KEY "K", WITH 120: "AB"
140 CLOSE #1
150 OPEN #2: NAME "FIL0176.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
160 TEMPLATE: NUMERIC*2.0, STRING*3
170 REWRITE #2, KEY "K", WITH 160: 99, "XY"
180 CLOSE #2
190 OPEN #3: NAME "FIL0176.DAT", ACCESS INPUT, ORGANIZATION KEYED, RECTYPE NATIVE
200 READ #3, KEY "K", WITH 160: X, Y$
210 CLOSE #3
220 IF X = 99 AND Y$ = "XY " THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; X; " <"; Y$; ">"
230 END
