1 REM FBCS FIL-0083
2 REM CLAIM E-71xx
3 REM TYPE SELF
100 PRINT "FIL-0083 IMPOSSIBLE FILE ACCESS RAISES A FATAL 71XX (11.1.5)"
110 LET OK = 0
120 WHEN EXCEPTION IN
130   OPEN #1: NAME "FIL0083.NOFILE", ACCESS INPUT
140   PRINT "*** TEST FAILED: NO EXCEPTION ***"
150 USE
160   IF EXTYPE > 7100 AND EXTYPE <= 7199 AND EXLINE = 130 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE; "EXLINE"; &
&EXLINE
170 END WHEN
180 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
