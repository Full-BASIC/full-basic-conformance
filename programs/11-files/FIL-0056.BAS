1 REM FBCS FIL-0056
2 REM CLAIM A-11.1.4.6-01
3 REM TYPE SELF
100 PRINT "FIL-0056 THE COLLATE SEQUENCE OF A KEYED FILE GOVERNS RECORD OPERATIONS AND ERASE (11.1.4.6)"
110 OPEN #1: NAME "FIL0056.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 WRITE #1, KEY "B": "SECOND"
130 WRITE #1, KEY "A": "FIRST"
140 WRITE #1, KEY "C": "THIRD"
150 SET #1: KEY >= "A"
160 READ #1: R1$
170 SET #1: KEY > "A"
180 READ #1: R2$
190 SET #1: KEY = "C"
200 READ #1: R3$
210 ERASE #1
220 SET #1: POINTER BEGIN
230 LET OK = 0
240 WHEN EXCEPTION IN
250   READ #1: R4$
260   PRINT "*** TEST FAILED: NO EXCEPTION AFTER ERASE ***"
270 USE
280   IF EXTYPE = 7305 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
290 END WHEN
300 CLOSE #1
310 IF R1$ = "FIRST" AND R2$ = "SECOND" AND R3$ = "THIRD" AND OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT &
&"*** TEST FAILED: "; R1$; " "; R2$; " "; R3$
320 END
