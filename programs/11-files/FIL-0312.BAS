1 REM FBCS FIL-0312
2 REM CLAIM A-11.3.4-TR83A
3 REM TYPE SELF
4 REM STD 11.3.4 l.7525-7541, 11.5.4.1 l.8548-8555: an exception in an operand of REWRITE leaves the
5 REM record unchanged and nothing behind: the next correct REWRITE replaces it with its own values.
10 LET OK = 1
20 OPEN #1: NAME "FIL0312R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
30 WRITE #1, RECORD 1: "Q"
40 WHEN EXCEPTION IN
50   REWRITE #1, RECORD 1: "P", 1/0, "R"
60 USE
70   LET E1 = EXTYPE
80 END WHEN
90 READ #1, RECORD 1: X$
100 REWRITE #1, RECORD 1: "Z"
110 READ #1, RECORD 1: Y$
120 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN LET OK = 0
130 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN PRINT "FALLO-RELATIVE-INTERNAL"; E1; X$; Y$
140 CLOSE #1
150 OPEN #2: NAME "FIL0312K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
160 WRITE #2, KEY "A": "Q"
170 WHEN EXCEPTION IN
180   REWRITE #2, KEY "A": "P", 1/0
190 USE
200   LET E1 = EXTYPE
210 END WHEN
220 READ #2, KEY "A": X$
230 REWRITE #2, KEY "A": "Z"
240 READ #2, KEY "A": Y$
250 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN LET OK = 0
260 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN PRINT "FALLO-KEYED-INTERNAL"; E1; X$; Y$
270 CLOSE #2
280 OPEN #3: NAME "FIL0312N.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
290 WRITE #3, RECORD 1, WITH "STRING*1": "Q"
300 WHEN EXCEPTION IN
310   REWRITE #3, RECORD 1, WITH "STRING*1, NUMERIC*2, STRING*1": "P", 1/0, "R"
320 USE
330   LET E1 = EXTYPE
340 END WHEN
350 READ #3, RECORD 1, WITH "STRING*1": X$
360 REWRITE #3, RECORD 1, WITH "STRING*1": "Z"
370 READ #3, RECORD 1, WITH "STRING*1": Y$
380 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN LET OK = 0
390 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN PRINT "FALLO-RELATIVE-NATIVE"; E1; X$; Y$
400 CLOSE #3
410 OPEN #4: NAME "FIL0312D.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
420 WRITE #4, RECORD 1: "Q"
430 WHEN EXCEPTION IN
440   REWRITE #4, RECORD 1: "P", 1/0
450 USE
460   LET E1 = EXTYPE
470 END WHEN
480 READ #4, RECORD 1: X$
490 REWRITE #4, RECORD 1: "Z"
500 READ #4, RECORD 1: Y$
510 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN LET OK = 0
520 IF E1 <> 3001 OR X$ <> "Q" OR Y$ <> "Z" THEN PRINT "FALLO-RELATIVE-DISPLAY"; E1; X$; Y$
530 CLOSE #4
540 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
550 END
