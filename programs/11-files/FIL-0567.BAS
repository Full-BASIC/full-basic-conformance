1 REM FBCS FIL-0567
2 REM CLAIM D-11.5-1
3 REM TYPE SELF
4 REM STD 11.5 l.8501-8526: REWRITE and DELETE on organizations other than RELATIVE and KEYED are
5 REM implementation-defined. FullBASIC raises -7500 on STREAM files and on SEQUENTIAL INTERNAL files too.
100 PRINT "FIL-0567 REWRITE AND DELETE ON STREAM AND SEQUENTIAL INTERNAL FILES RAISE -7500 (11.5, App C)"
110 LET OK = 0
120 OPEN #1: NAME "FIL0567S.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
130 WRITE #1: 1
140 WHEN EXCEPTION IN
150   REWRITE #1: 2
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = -7500 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
190 END WHEN
200 WHEN EXCEPTION IN
210   DELETE #1
220   PRINT "*** TEST FAILED: NO EXCEPTION ***"
230 USE
240   IF EXTYPE = -7500 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
250 END WHEN
260 CLOSE #1
270 OPEN #2: NAME "FIL0567Q.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
280 WRITE #2: 1
290 WHEN EXCEPTION IN
300   REWRITE #2: 2
310   PRINT "*** TEST FAILED: NO EXCEPTION ***"
320 USE
330   IF EXTYPE = -7500 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
340 END WHEN
350 CLOSE #2
360 IF OK = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
370 END
