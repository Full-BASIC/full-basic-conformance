1 REM FBCS FIL-0011
2 REM CLAIM E-8302
3 REM TYPE SELF
100 PRINT "FIL-0011 READ FROM AN INTERNAL RECORD LONGER THAN RECSIZE (11.4.5.3)"
110 DIM M$(1)
120 LET A$ = "ORIG"
130 OPEN #1: NAME "DATA.DAT", ORGANIZATION RELATIVE, ACCESS OUTIN, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 99
140 WRITE #1, RECORD 1: "ABCDEFGH"
150 CLOSE #1
160 OPEN #1: NAME "DATA.DAT", ORGANIZATION RELATIVE, ACCESS INPUT, RECTYPE INTERNAL, RECSIZE VARIABLE LENGTH 3
170 LET OK = 0
180 WHEN EXCEPTION IN
190   READ #1, RECORD 1: A$
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE = 8302 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 IF OK = 1 AND A$ = "ORIG" THEN PRINT "*** TEST PASSED ***"
250 IF OK = 1 AND A$ <> "ORIG" THEN PRINT "*** TEST FAILED: VARIABLE ASSIGNED"
260 END
