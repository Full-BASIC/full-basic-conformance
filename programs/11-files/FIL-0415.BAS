1 REM FBCS FIL-0415
2 REM CLAIM A-11.1.4-TR124
3 REM TYPE SELF
4 REM STD 11.1 l.6743-6752, 11.1.4.9 Table 5 l.7003-7010: a stream is a sequence of values; READ of one of three leaves MIDDLE.
100 OPEN #4: NAME "FIL0413.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE INTERNAL
110 ERASE #4
120 WRITE #4: 1, 2, 3
130 SET #4: POINTER BEGIN
140 ASK #4: POINTER P0$
150 READ #4: X
160 ASK #4: POINTER P1$, DATUM D1$
170 READ #4: Y
180 READ #4: Z
190 ASK #4: POINTER P2$, DATUM D2$
200 CLOSE #4
210 IF P0$ = "BEGIN" AND X = 1 AND P1$ = "MIDDLE" AND D1$ = "NUMERIC" AND Y = 2 AND Z = 3 AND P2$ = "END" AND D2$ = "NONE" THEN
220    PRINT "*** TEST PASSED ***"
230 ELSE
240    PRINT "*** TEST FAILED: ["; P0$; "] ["; P1$; "] ["; D1$; "] ["; P2$; "] ["; D2$; "]"; X; Y; Z
250 END IF
260 END
