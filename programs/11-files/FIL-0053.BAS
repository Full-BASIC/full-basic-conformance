1 REM FBCS FIL-0053
2 REM CLAIM A-11.1.4.5-01
3 REM TYPE SELF
100 PRINT "FIL-0053 THE LENGTH OF A DISPLAY RECORD IS ITS NUMBER OF CHARACTERS (11.1.4.5)"
110 OPEN #1: NAME "FIL0053.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "ABC"
130 CLOSE #1
140 OPEN #2: NAME "FIL0053.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 CLOSE #2
170 IF A$ = "ABC" AND LEN(A$) = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; ">"
180 END
