1 REM FBCS FIL-0608
2 REM CLAIM E-8013
3 REM TYPE SELF
4 REM STD 10.5.4.3 l.6014-6020, 11.4.4 l.8040-8054, 11.4.5.3 l.8451-8453
100 PRINT "FIL-0608 MAT INPUT # A(?) WITH MORE DATA THAN ITS ORIGINAL SIZE: THE DATA THAT FIT ARE ASSIGNED, THEN 8013"
110 OPTION BASE 1
120 DIM A(3)
130 MAT A = (9) * CON
140 OPEN #1: NAME "FIL0608.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 ERASE #1
160 PRINT #1: "1, 2, 3, 4"
170 SET #1: POINTER BEGIN
180 LET OK = 0
190 LET E = 0
200 WHEN EXCEPTION IN
210   MAT INPUT #1: A(?)
220 USE
230   LET E = EXTYPE
240 END WHEN
250 IF E = 8013 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; E
260 IF UBOUND(A) = 3 AND A(1) = 1 AND A(2) = 2 AND A(3) = 3 THEN LET OK = OK + 1
270 IF OK < 2 THEN PRINT "*** TEST FAILED:"; UBOUND(A); A(1); A(2); A(3)
280 CLOSE #1
290 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK = "; OK
300 END
