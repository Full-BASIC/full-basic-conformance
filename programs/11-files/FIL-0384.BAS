1 REM FBCS FIL-0384
2 REM CLAIM A-11.3.4.1-TR96
3 REM TYPE SELF
4 REM STD 11.3.4.1 l.7543-7547 (a PRINT # works as 10.3 and 10.4, the characters form a DISPLAY
5 REM record) with 10.3.4.3 l.5452-5466 (tab-call: n rounded, n reduced modulo the margin, spaces
6 REM up to n or end-of-record plus n-1 spaces when the column is already past n) and 10.3.5
7 REM l.5532-5533 (TAB below one is 4005). Checked on SEQUENTIAL and RELATIVE DISPLAY files.
10 LET OK = 1
100 OPEN #1: NAME "FIL0384S.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
110 ERASE #1
120 PRINT #1: "AB"; TAB(6); "C"
130 PRINT #1: "ABCDE"; TAB(2); "D"
140 PRINT #1: "AB";
150 PRINT #1: TAB(6); "C"
160 PRINT #1: 1; TAB(8); 2
170 PRINT #1: TAB(2.6); "R"
180 SET #1: ZONEWIDTH 5
190 SET #1: MARGIN 10
200 PRINT #1: TAB(13); "X"
210 SET #1: POINTER BEGIN
220 LET R$ = ""
230 DO
240   LINE INPUT #1, IF MISSING THEN EXIT DO: L$
250   LET R$ = R$ & "[" & L$ & "]"
260 LOOP
270 LET W$ = "[AB   C][ABCDE][ D][AB   C][ 1      2 ][  R][  X]"
280 IF R$ <> W$ THEN LET OK = 0
290 IF R$ <> W$ THEN PRINT "FALLO-SEQUENTIAL "; R$
300 CLOSE #1
400 OPEN #2: NAME "FIL0384R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
410 ERASE #2
420 PRINT #2: "AB"; TAB(6); "C"
430 PRINT #2: "ABCDE"; TAB(2); "D"
440 PRINT #2: "AB";
450 PRINT #2: TAB(6); "C"
460 PRINT #2: 1; TAB(8); 2
470 PRINT #2: TAB(2.6); "R"
480 SET #2: ZONEWIDTH 5
490 SET #2: MARGIN 10
500 PRINT #2: TAB(13); "X"
510 SET #2: POINTER BEGIN
520 LET R$ = ""
530 DO
540   LINE INPUT #2, IF MISSING THEN EXIT DO: L$
550   LET R$ = R$ & "[" & L$ & "]"
560 LOOP
570 IF R$ <> W$ THEN LET OK = 0
580 IF R$ <> W$ THEN PRINT "FALLO-RELATIVE "; R$
590 CLOSE #2
700 OPEN #3: NAME "FIL0384W.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
710 ERASE #3
720 LET E1 = 0
730 WHEN EXCEPTION IN
740   PRINT #3: TAB(0); "Y"
750 USE
760   LET E1 = EXTYPE
770 END WHEN
780 IF E1 <> 4005 THEN LET OK = 0
790 IF E1 <> 4005 THEN PRINT "FALLO-4005 "; E1
800 CLOSE #3
900 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
910 END
