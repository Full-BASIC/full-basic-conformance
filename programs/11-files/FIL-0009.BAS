1 REM FBCS FIL-0009
2 REM CLAIM E-8302
3 REM TYPE SELF
100 PRINT "FIL-0009 LINE INPUT FROM A RECORD LONGER THAN RECSIZE (11.4.5.3)"
110 DIM M$(1)
120 LET A$ = "ORIG"
130 OPEN #1: NAME "DATA.DAT", ORGANIZATION SEQUENTIAL, ACCESS OUTIN, RECTYPE DISPLAY, RECSIZE VARIABLE LENGTH 99
140 PRINT #1: "ABCDEFGH"
150 CLOSE #1
160 OPEN #1: NAME "DATA.DAT", ORGANIZATION SEQUENTIAL, ACCESS INPUT, RECTYPE DISPLAY, RECSIZE VARIABLE LENGTH 3
170 LET OK = 0
180 WHEN EXCEPTION IN
190   LINE INPUT #1: A$
200   PRINT "*** TEST FAILED: NO EXCEPTION ***"
210 USE
220   IF EXTYPE = 8302 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
230 END WHEN
240 IF OK = 1 AND A$ = "ORIG" THEN PRINT "*** TEST PASSED ***"
250 IF OK = 1 AND A$ <> "ORIG" THEN PRINT "*** TEST FAILED: VARIABLE ASSIGNED"
260 END
