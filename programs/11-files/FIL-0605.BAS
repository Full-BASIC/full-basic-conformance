1 REM FBCS FIL-0605
2 REM CLAIM E-8012
3 REM TYPE SELF
4 REM STD 11.4.4 l.8051-8054: the variables assigned before an exception keep their new values
100 PRINT "FIL-0605 A RECORD WITH TOO FEW DATA ASSIGNS THE DATA IT HAS BEFORE RAISING 8012 (11.4.4)"
110 OPEN #1: NAME "FIL0605.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 ERASE #1
130 PRINT #1: "4,5"
140 PRINT #1: "6,7,8,9"
150 SET #1: POINTER BEGIN
160 LET A = -1
170 LET B = -1
180 LET C = -1
190 LET OK = 0
200 WHEN EXCEPTION IN
210   INPUT #1: A, B, C
220 USE
230   IF EXTYPE = 8012 AND A = 4 AND B = 5 AND C = -1 THEN LET OK = OK + 1
240 END WHEN
250 LET A = -1
260 LET B = -1
270 LET C = -1
280 WHEN EXCEPTION IN
290   INPUT #1: A, B, C
300 USE
310   IF EXTYPE = 8013 AND A = 6 AND B = 7 AND C = 8 THEN LET OK = OK + 1
320 END WHEN
330 CLOSE #1
340 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK = "; OK; A; B; C
350 END
