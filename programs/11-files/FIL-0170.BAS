1 REM FBCS FIL-0170
2 REM CLAIM D-11.4-1
3 REM TYPE SELF
100 PRINT "FIL-0170 A NUMERIC*15.10 NATIVE FIELD KEEPS 10 FRACTION DIGITS (11.4.5.3, App C)"
110 OPEN #1: NAME "FIL0170.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*15.10
130 WRITE #1, WITH 120: 1/3
140 CLOSE #1
150 OPEN #2: NAME "FIL0170.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 READ #2, WITH 120: X
170 CLOSE #2
180 IF X <> 1/3 AND X > 0.333 AND X < 0.334 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: X="; X
190 END
