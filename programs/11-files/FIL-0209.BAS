1 REM FBCS FIL-0209
2 REM CLAIM A-11.1.4.6-03
3 REM TYPE SELF
100 PRINT "FIL-0209 OMITTED COLLATE SEQUENCE ON AN EXISTING FILE USES THE FILE'S SEQUENCE (11.1.4.6)"
110 DECLARE EXTERNAL SUB REOPENNATIVE
120 REM file created with NATIVE by a unit whose sequence is STANDARD
130 OPEN #1: NAME "FIL0209A.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL, COLLATE NATIVE
140 WRITE #1, KEY "A": 1
150 CLOSE #1
160 OPEN #1: NAME "FIL0209A.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
170 ASK #1: COLLATE C1$
180 CLOSE #1
190 REM file created with STANDARD, reopened without COLLATE by a NATIVE unit
200 OPEN #1: NAME "FIL0209B.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL, COLLATE STANDARD
210 WRITE #1, KEY "B": 2
220 CLOSE #1
225 LET C2$ = ""
226 LET V = 0
230 CALL REOPENNATIVE(C2$, V)
240 IF UCASE$(C1$) = "NATIVE" AND UCASE$(C2$) = "STANDARD" AND V = 2 THEN
241 PRINT "*** TEST PASSED ***"
242 ELSE
243 PRINT "*** TEST FAILED: <"; C1$; "> <"; C2$; "> "; V
244 END IF
250 END
260 EXTERNAL SUB REOPENNATIVE(C$, V)
270 OPTION COLLATE NATIVE
280 OPEN #1: NAME "FIL0209B.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
290 ASK #1: COLLATE C$
300 SET #1: KEY "B"
310 READ #1: V
320 CLOSE #1
330 END SUB
