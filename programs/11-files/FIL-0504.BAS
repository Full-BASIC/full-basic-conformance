1 REM FBCS FIL-0504
2 REM CLAIM A-11.1.4.5-TR177
3 REM TYPE OUTPUT
4 REM STD 11.1.4.5 l.6853-6854, 11.1.5 7051, 5.2.4: the LENGTH index is rounded first and then must be greater than
5 REM zero: LENGTH .4 is 0 (7051), LENGTH .5 is 1.
100 WHEN EXCEPTION IN
110   OPEN #1: NAME "FIL0504A.DAT", ACCESS OUTPUT, RECSIZE VARIABLE LENGTH .4
120   PRINT "NOEXC"
130 USE
140   PRINT EXTYPE
150 END WHEN
160 OPEN #2: NAME "FIL0504B.DAT", ACCESS OUTPUT, RECSIZE VARIABLE LENGTH .5
170 ASK #2: MARGIN M
180 PRINT M
190 END
