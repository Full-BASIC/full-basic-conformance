1 REM FBCS FIL-0148
2 REM CLAIM A-11.4.4.11-03
3 REM TYPE SELF
100 PRINT "FIL-0148 NATIVE FIELD SPECIFIERS MUST BE COMPATIBLE WITH THOSE THAT CREATED THE RECORD (11.4.4.11)"
110 OPEN #1: NAME "FIL0148.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*3.2, STRING*5
130 WRITE #1, WITH 120: 1.5, "ABC"
140 CLOSE #1
150 OPEN #2: NAME "FIL0148.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
160 TEMPLATE: NUMERIC*3.2, STRING*5
170 READ #2, WITH 160: X, Y$
180 CLOSE #2
190 IF X = 1.5 AND Y$ = "ABC  " THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; X; " <"; Y$; ">"
200 END
