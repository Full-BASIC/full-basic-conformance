1 REM FBCS FIL-0027
2 REM CLAIM E-7308
3 REM TYPE SELF
100 PRINT "FIL-0027 THE EXCEPTION LEAVES THE SEQUENTIAL FILE UNCHANGED (11.3.2, 11.3.5.2)"
110 LET OK = 0
120 OPEN #1: NAME "FIL0027.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
130 WRITE #1: "A"
140 WRITE #1: "B"
150 SET #1: POINTER BEGIN
160 WHEN EXCEPTION IN
170   WRITE #1: "Z"
180 USE
190   IF EXTYPE = 7308 THEN LET OK = 1
200 END WHEN
210 SET #1: POINTER BEGIN
220 INPUT #1: X$
230 INPUT #1: Y$
240 CLOSE #1
250 IF OK = 1 AND X$ = "A" AND Y$ = "B" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 END
