110 OPEN #1: NAME "FIL0169.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: 1/3
130 PRINT #1: 123456789012345678
140 CLOSE #1
150 OPEN #2: NAME "FIL0169.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 LINE INPUT #2: A$
170 LINE INPUT #2: B$
180 CLOSE #2
190 IF A$ = " .33333333 " AND B$ = " 1.2345679E+17 " THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; &
&"> <"; B$; ">"
200 END
