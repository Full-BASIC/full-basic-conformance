1 REM FBCS FIL-0260
2 REM CLAIM A-11.3.4-TR71
3 REM TYPE SELF
4 REM STD 11.3.4 l.7532-7536: an exception during data transfer never results in a
5 REM partial file-element being added to the file; 11.3.4.1 l.7568-7570: with an
6 REM exception before the end of the statement the partial record is not added.
7 REM SEQUENTIAL DISPLAY file: PRINT # and WRITE # that fail leave nothing behind.
10 LET OK = 1
20 LET N = 0
30 OPEN #1: NAME "FIL0260.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
100 REM FAIL IN THE SECOND ITEM, THEN A GOOD PRINT
110 WHEN EXCEPTION IN
120   PRINT #1: "AB"; 1/0
130 USE
140   LET N = N + 1
150 END WHEN
160 PRINT #1: "ONE"
200 REM FAIL IN THE FIRST ITEM
210 WHEN EXCEPTION IN
220   PRINT #1: 1/0; "AB"
230 USE
240   LET N = N + 1
250 END WHEN
260 PRINT #1: "TWO"
300 REM FAIL IN THE LAST OF THREE ITEMS
310 WHEN EXCEPTION IN
320   PRINT #1: "P"; "Q"; 1/0
330 USE
340   LET N = N + 1
350 END WHEN
360 PRINT #1: "THREE"
400 REM WRITE # THAT FAILS CREATES NO RECORD
410 WHEN EXCEPTION IN
420   WRITE #1: 1, 1/0
430 USE
440   LET N = N + 1
450 END WHEN
460 WRITE #1: 9
500 REM A PARTIAL RECORD LEFT BY AN EARLIER STATEMENT (TRAILING ;) IS KEPT AND COMPLETED
510 PRINT #1: "XY";
520 WHEN EXCEPTION IN
530   PRINT #1: "AB"; 1/0
540 USE
550   LET N = N + 1
560 END WHEN
570 PRINT #1: "CD"
600 SET #1: POINTER BEGIN
610 LINE INPUT #1: A$
620 LINE INPUT #1: B$
630 LINE INPUT #1: C$
640 LINE INPUT #1: D$
650 LINE INPUT #1: E$
660 LET M = 0
670 LINE INPUT #1, IF MISSING THEN 700: F$
680 LET M = 1
700 IF N <> 5 THEN LET OK = 0
710 IF A$ <> "ONE" OR B$ <> "TWO" OR C$ <> "THREE" OR E$ <> "XYCD" THEN LET OK = 0
720 IF VAL(D$) <> 9 OR M <> 0 THEN LET OK = 0
730 IF OK = 0 THEN PRINT "FALLO"; N; A$; "|"; B$; "|"; C$; "|"; D$; "|"; E$; "|"; M
740 CLOSE #1
750 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
760 END
