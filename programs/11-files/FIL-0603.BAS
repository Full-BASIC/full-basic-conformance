1 REM FBCS FIL-0603
2 REM CLAIM A-11.1.4.2-02
3 REM TYPE SELF
4 REM STD 11.1.4.2 l.6698-6700: SET with pointer-items is allowed on a file opened as OUTPUT, also with KEY
100 PRINT "FIL-0603 SET KEY IS ALLOWED ON A KEYED FILE OPENED AS OUTPUT (11.1.4.2)"
110 LET OK = 0
120 OPEN #1: NAME "FIL0603.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
130 ERASE #1
140 WRITE #1, KEY "A": "ONE"
150 CLOSE #1
160 OPEN #1: NAME "FIL0603.DAT", ACCESS OUTPUT, ORGANIZATION KEYED, RECTYPE DISPLAY
170 DO
180   SET #1: KEY "A", IF THERE THEN EXIT DO
190   PRINT "*** TEST FAILED: KEY A NOT FOUND ***"
200   EXIT DO
210 LOOP
220 LET OK = OK + 1
230 LET FOUND = 0
240 DO
250   SET #1: KEY "B", IF THERE THEN EXIT DO
260   LET FOUND = 1
270   EXIT DO
280 LOOP
290 IF FOUND = 1 THEN LET OK = OK + 1 ELSE PRINT "*** TEST FAILED: KEY B FOUND ***"
300 CLOSE #1
310 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK = "; OK
320 END
