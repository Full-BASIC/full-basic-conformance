1 REM FBCS FIL-0044
2 REM CLAIM A-11.1.4.1-06
3 REM TYPE SELF
100 PRINT "FIL-0044 ENHANCED NATIVE PROCESSES SEQUENTIAL, RELATIVE AND KEYED NATIVE (11.1.4.1)"
110 OPEN #1: NAME "FIL0044A.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
120 TEMPLATE: NUMERIC*3.2, STRING*5
130 WRITE #1, WITH 120: 3.14, "ABC"
140 CLOSE #1
150 OPEN #2: NAME "FIL0044B.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE NATIVE
160 WRITE #2, RECORD 1, WITH 120: 2.5, "REL"
170 CLOSE #2
180 OPEN #3: NAME "FIL0044C.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE NATIVE
190 WRITE #3, KEY "K", WITH 120: 1.5, "KEY"
200 CLOSE #3
210 OPEN #4: NAME "FIL0044A.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE NATIVE
220 READ #4, WITH 120: X, Y$
230 CLOSE #4
240 OPEN #5: NAME "FIL0044B.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE NATIVE
250 READ #5, RECORD 1, WITH 120: U, V$
260 CLOSE #5
270 OPEN #6: NAME "FIL0044C.DAT", ACCESS INPUT, ORGANIZATION KEYED, RECTYPE NATIVE
280 READ #6, KEY "K", WITH 120: W, Z$
290 CLOSE #6
300 IF X = 3.14 AND Y$ = "ABC  " AND U = 2.5 AND V$ = "REL  " AND W = 1.5 AND Z$ = "KEY  " THEN PRINT "*** TEST PASSED ***" ELSE &
&PRINT "*** TEST FAILED: "; X; " <"; Y$; "> "; U; " <"; V$; "> "; W; " <"; Z$; ">"
310 END
