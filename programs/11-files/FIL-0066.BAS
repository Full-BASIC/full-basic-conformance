1 REM FBCS FIL-0066
2 REM CLAIM A-11.2.4-01
3 REM TYPE SELF
100 PRINT "FIL-0066 SET WITH POINTER ITEMS MOVES THE FILE POINTER (11.2.4)"
110 OPEN #1: NAME "FIL0066.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "A"
130 SET #1: POINTER BEGIN
140 ASK #1: POINTER P1$
150 SET #1: POINTER END
160 ASK #1: POINTER P2$
170 CLOSE #1
180 IF P1$ = "BEGIN" AND P2$ = "END" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; P1$; " "; P2$
190 END
