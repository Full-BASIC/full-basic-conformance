1 REM FBCS FIL-0206
2 REM CLAIM A-11.3.4-TR48
3 REM TYPE OUTPUT
4 REM STD 11.3.4.3 l.7600-7603 + 11.3.4.1 l.7557-7561 + 10.3.4.4 l.5486-5489: the
5 REM effective margin of a DISPLAY file is the LENGTH of RECSIZE when no SET
6 REM MARGIN follows the OPEN, and it cuts an overlength print-item mid-item.
7 REM With RECSIZE VARIABLE LENGTH 5, PRINT #1: "ABCDEFG" creates ABCDE and FG;
8 REM the zones still respect the margin (AB, CD, EFG in three records).
10 OPEN #1: NAME "FIL0206.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY, RECSIZE VARIABLE LENGTH 5
20 SET #1: ZONEWIDTH 5
30 PRINT #1: "ABCDEFG"
40 PRINT #1: "AB", "CD", "EFG"
50 CLOSE #1
60 OPEN #1: NAME "FIL0206.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
70 SET #1: POINTER BEGIN
80 LINE INPUT #1, IF MISSING THEN 120: X$
90 PRINT "["; X$; "]"
100 GOTO 80
120 END
