1 REM FBCS FIL-0001
2 REM CLAIM A-11.3.2-01
3 REM TYPE SELF
100 PRINT "FIL-0001 PRINT # WITH IF THERE, NO RECORD AT THE POINTER (11.3.2)"
110 OPEN #1: NAME "FIL0001.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
120 PRINT #1, IF THERE THEN 900: "ALPHA"
130 CLOSE #1
140 OPEN #2: NAME "FIL0001.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
150 LINE INPUT #2: A$
160 CLOSE #2
170 IF A$ = "ALPHA" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: RECORD IS "; A$
180 GOTO 999
900 PRINT "*** TEST FAILED: IF THERE TAKEN WITH NO RECORD"
999 END
