3 REM TYPE SELF
4 REM STD 11.1.4.2 l.6716-6718, 11.1.4.3 l.6758-6763: after OPEN as OUTPUT a RELATIVE file is at end of file
100 PRINT "FIL-0604 AFTER OPEN AS OUTPUT A RELATIVE FILE POINTS TO THE AREA AFTER THE LAST RECORD (11.1.4.2)"
110 OPEN #1: NAME "FIL0604.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
120 ERASE #1
130 WRITE #1, RECORD 1: 10
140 WRITE #1, RECORD 2: 20
150 CLOSE #1
160 OPEN #1: NAME "FIL0604.DAT", ACCESS OUTPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
170 ASK #1: POINTER P$, RECORD R
180 WRITE #1: 30
190 CLOSE #1
200 OPEN #1: NAME "FIL0604.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE DISPLAY
210 READ #1, RECORD 1: A
220 READ #1, RECORD 3: C
230 CLOSE #1
240 IF P$ = "END" AND R = 3 AND A = 10 AND C = 30 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; P$; R; A; C
250 END
