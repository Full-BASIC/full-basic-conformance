1 REM FBCS FIL-0343
2 REM CLAIM A-11.3.4-TR87C
3 REM TYPE SELF
4 REM STD 11.2.4.2 and 11.3.4 l.7516-7524, 11.5.4 l.8527-8533: the io-recovery-action declared by
5 REM a statement is taken or ignored by that statement only. After a WRITE or REWRITE that
6 REM stops with an exception (in an operand of phase 3, in phase 1 or with 8301), a later
7 REM statement of the channel does not take the old recovery.
10 LET OK = 1
100 OPEN #1: NAME "FIL0343R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
110 WRITE #1, RECORD 1: "A"
120 WHEN EXCEPTION IN
130   WRITE #1, RECORD 2, IF THERE THEN 1380: "P", 1/0
140 USE
150   LET E1 = EXTYPE
160 END WHEN
170 WHEN EXCEPTION IN
180   WRITE #1, RECORD 1: "Z"
190 USE
200   LET E2 = EXTYPE
210 END WHEN
220 READ #1, RECORD 1: X$
230 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN LET OK = 0
240 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN PRINT "FALLO-WRITE-RELATIVE"; E1; E2; X$
250 CLOSE #1
300 OPEN #2: NAME "FIL0343K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
310 WRITE #2, KEY "A": "A"
320 WHEN EXCEPTION IN
330   WRITE #2, KEY "B", IF THERE THEN 1380: "P", 1/0
340 USE
350   LET E1 = EXTYPE
360 END WHEN
370 WHEN EXCEPTION IN
380   WRITE #2, KEY "A": "Z"
390 USE
400   LET E2 = EXTYPE
410 END WHEN
420 READ #2, KEY "A": X$
430 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN LET OK = 0
440 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN PRINT "FALLO-WRITE-KEYED"; E1; E2; X$
450 CLOSE #2
500 OPEN #3: NAME "FIL0343S.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE INTERNAL
510 WRITE #3: "A"
520 WHEN EXCEPTION IN
530   WRITE #3, IF THERE THEN 1380: "P", 1/0
540 USE
550   LET E1 = EXTYPE
560 END WHEN
570 SET #3: POINTER BEGIN
580 WHEN EXCEPTION IN
590   WRITE #3: "Z"
600 USE
610   LET E2 = EXTYPE
620 END WHEN
630 SET #3: POINTER BEGIN
640 READ #3: X$
650 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN LET OK = 0
660 IF E1 <> 3001 OR E2 <> 7308 OR X$ <> "A" THEN PRINT "FALLO-WRITE-SEQUENTIAL"; E1; E2; X$
670 CLOSE #3
700 OPEN #4: NAME "FIL0343W.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
710 WRITE #4, RECORD 1: "A"
720 WHEN EXCEPTION IN
730   REWRITE #4, RECORD 1, IF MISSING THEN 1380: "P", 1/0
740 USE
750   LET E1 = EXTYPE
760 END WHEN
770 WHEN EXCEPTION IN
780   READ #4, RECORD 3: X$
790 USE
800   LET E2 = EXTYPE
810 END WHEN
820 IF E1 <> 3001 OR E2 <> 7305 THEN LET OK = 0
830 IF E1 <> 3001 OR E2 <> 7305 THEN PRINT "FALLO-REWRITE-RELATIVE"; E1; E2
840 CLOSE #4
1000 OPEN #5: NAME "FIL0343I.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
1010 WRITE #5, RECORD 1: "A"
1020 CLOSE #5
1030 OPEN #5: NAME "FIL0343I.DAT", ACCESS INPUT, ORGANIZATION RELATIVE, RECTYPE INTERNAL
1040 WHEN EXCEPTION IN
1050   WRITE #5, RECORD 1, IF THERE THEN 1380: "Z"
1060 USE
1070   LET E1 = EXTYPE
1080 END WHEN
1090 SET #5: POINTER BEGIN
1100 LET E2 = 1
1130 IF E1 <> 7302 OR E2 <> 1 THEN LET OK = 0
1140 IF E1 <> 7302 OR E2 <> 1 THEN PRINT "FALLO-7302-RECUPERACION-PENDIENTE"; E1; E2
1150 CLOSE #5
1200 OPEN #6: NAME "FIL0343M.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY, RECSIZE VARIABLE LENGTH 5
1210 WRITE #6, RECORD 1: "A"
1220 DIM A$(1)
1230 LET A$(1) = "LONGLONGLONG"
1240 WHEN EXCEPTION IN
1250   MAT WRITE #6, RECORD 2, IF THERE THEN 1380: A$
1260 USE
1270   LET E1 = EXTYPE
1280 END WHEN
1290 WHEN EXCEPTION IN
1300   MAT WRITE #6, RECORD 1: A$
1310 USE
1320   LET E2 = EXTYPE
1330 END WHEN
1340 IF E1 <> 8301 OR E2 <> 7308 THEN LET OK = 0
1350 IF E1 <> 8301 OR E2 <> 7308 THEN PRINT "FALLO-MAT-WRITE"; E1; E2
1360 CLOSE #6
1370 GOTO 1500
1380 PRINT "FALLO-SALTO-A-RECUPERACION-ANTIGUA"
1390 LET OK = 0
1500 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
1510 END
