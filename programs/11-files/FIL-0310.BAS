1 REM FBCS FIL-0310
2 REM CLAIM A-11.3.4-TR83A
3 REM TYPE SELF
4 REM STD 11.3.4 l.7516-7541 and 11.3.4.7 l.7659-7660: a WRITE stopped by exception 7308
5 REM (phase 2) or by an exception while evaluating an operand (phase 3) adds no file-element and
6 REM leaves nothing behind: the next correct WRITE on the channel stores exactly its own values.
10 LET OK = 1
20 OPEN #1: NAME "FIL0310R.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE INTERNAL
30 WRITE #1, RECORD 1: "A"
40 WHEN EXCEPTION IN
50   WRITE #1, RECORD 1: "P", "Q"
60 USE
70   LET E1 = EXTYPE
80 END WHEN
90 WRITE #1, RECORD 2: "Z"
100 READ #1, RECORD 2: X$
110 IF E1 <> 7308 OR X$ <> "Z" THEN LET OK = 0
120 IF E1 <> 7308 OR X$ <> "Z" THEN PRINT "FALLO-RELATIVE-7308"; E1; X$
130 WHEN EXCEPTION IN
140   WRITE #1, RECORD 3: "A", 1/0, "C"
150 USE
160   LET E2 = EXTYPE
170 END WHEN
180 WRITE #1, RECORD 4: "Z"
190 READ #1, RECORD 4: X$
200 READ #1, RECORD 3, IF MISSING THEN 230: Y$
210 LET OK = 0
220 PRINT "FALLO-RELATIVE-REGISTRO-3-EXISTE"
230 IF E2 <> 3001 OR X$ <> "Z" THEN LET OK = 0
240 IF E2 <> 3001 OR X$ <> "Z" THEN PRINT "FALLO-RELATIVE-1/0"; E2; X$
250 CLOSE #1
260 OPEN #2: NAME "FIL0310K.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE INTERNAL
270 WRITE #2, KEY "A": "A"
280 WHEN EXCEPTION IN
290   WRITE #2, KEY "A": "P", "Q"
300 USE
310   LET E1 = EXTYPE
320 END WHEN
330 WRITE #2, KEY "B": "Z"
340 READ #2, KEY "B": X$
350 IF E1 <> 7308 OR X$ <> "Z" THEN LET OK = 0
360 IF E1 <> 7308 OR X$ <> "Z" THEN PRINT "FALLO-KEYED-7308"; E1; X$
370 WHEN EXCEPTION IN
380   WRITE #2, KEY "C": "A", 1/0, "C"
390 USE
400   LET E2 = EXTYPE
410 END WHEN
420 WRITE #2, KEY "D": "Z"
430 READ #2, KEY "D": X$
440 READ #2, KEY "C", IF MISSING THEN 470: Y$
450 LET OK = 0
460 PRINT "FALLO-KEYED-CLAVE-C-EXISTE"
470 IF E2 <> 3001 OR X$ <> "Z" THEN LET OK = 0
480 IF E2 <> 3001 OR X$ <> "Z" THEN PRINT "FALLO-KEYED-1/0"; E2; X$
490 CLOSE #2
500 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
510 END
