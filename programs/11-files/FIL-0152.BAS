1 REM FBCS FIL-0152
2 REM CLAIM D-11-1
3 REM TYPE SELF
100 PRINT "FIL-0152 UNLISTED ORG/RECTYPE COMBOS ARE ACCEPTED (11, App C)"
110 OPEN #1: NAME "FIL0152A.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE DISPLAY
120 PRINT #1: "S1"
130 CLOSE #1
140 OPEN #2: NAME "FIL0152B.DAT", ACCESS OUTIN, ORGANIZATION STREAM, RECTYPE NATIVE
150 TEMPLATE: NUMERIC*3.2
160 WRITE #2, WITH 150: 1.5
170 CLOSE #2
180 OPEN #3: NAME "FIL0152A.DAT", ACCESS INPUT, ORGANIZATION STREAM, RECTYPE DISPLAY
190 LINE INPUT #3: A$
200 CLOSE #3
210 OPEN #4: NAME "FIL0152B.DAT", ACCESS INPUT, ORGANIZATION STREAM, RECTYPE NATIVE
220 READ #4, WITH 150: X
230 CLOSE #4
240 IF A$ = "S1" AND X = 1.5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: <"; A$; "> "; X
250 END
