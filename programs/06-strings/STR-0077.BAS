1 REM FBCS STR-0077
2 REM CLAIM A-6.4.2-TR89
3 REM TYPE SELF
100 REM CONTROL OF STR-0074 TO STR-0076: MAXLEN OF A SIMPLE VARIABLE, OF AN ARRAY AND OF A FORMAL PARAMETER OF A SUB STAYS VALID
110 DECLARE STRING A$*5, B$(2)*7
120 CALL S(A$, R)
130 IF MAXLEN(A$) = 5 AND MAXLEN(B$) = 7 AND R = 5 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
140 SUB S(P$, R)
150   LET R = MAXLEN(P$)
160 END SUB
170 END
