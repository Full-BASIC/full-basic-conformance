1 REM FBCS STR-0040
2 REM CLAIM E-1504
3 REM TYPE SELF
100 REM VAL underflow is reported as nonfatal 1504 (recommended, l.12819):
110 REM a handler can intercept it.
120 WHEN EXCEPTION IN
130   LET X = VAL("1E-9999")
140   PRINT "*** TEST FAILED: NO EXCEPTION ***"
150 USE
160   IF EXTYPE = 1504 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
170 END WHEN
180 END
