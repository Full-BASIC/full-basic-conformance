1 REM FBCS STR-0008
2 REM CLAIM A-6.2.4-01
3 REM TYPE SELF
100 REM Scope of a string variable is its program-unit; a parameter of an
110 REM internal procedure is scoped to that definition.
119 DECLARE SUB S, T
120 LET FAIL = 0
130 LET A$ = "MAIN"
140 CALL S
150 IF A$ <> "SUB" THEN LET FAIL = FAIL + 1
160 CALL T(A$)
170 IF A$ <> "PARAM" THEN LET FAIL = FAIL + 1
180 LET OKP = 0
190 WHEN EXCEPTION IN
200   LET X = LEN(P$)
210   LET NOEXC = 1
220 USE
230   IF EXTYPE = 3102 THEN LET OKP = 1
240 END WHEN
250 IF OKP = 0 THEN LET FAIL = FAIL + 1
260 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
270 SUB S
280   LET A$ = "SUB"
290 END SUB
300 SUB T(P$)
310   LET P$ = "PARAM"
320 END SUB
330 END
