1 REM FBCS STR-0045
2 REM CLAIM A-6.5.5-EXC
3 REM TYPE SELF
100 REM Storing into a string variable a value longer than its maximum length
110 REM raises fatal 1106 (l.2820).
120 DECLARE STRING S$ * 5
130 LET S$ = "ABCD"
140 WHEN EXCEPTION IN
150   LET S$ = "ABCDEF"
160   PRINT "*** TEST FAILED: NO EXCEPTION ***"
170 USE
180   IF EXTYPE = 1106 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
190 END WHEN
200 END
