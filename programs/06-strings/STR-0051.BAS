1 REM FBCS STR-0051
2 REM CLAIM A-6.6.4-01
3 REM TYPE SELF
100 REM OPTION COLLATE STANDARD selects the Table 8 ordering: ORD("A")=65,
110 REM ORD("a")=97, so "A" < "a"; digits before letters; prefix < longer.
120 OPTION COLLATE STANDARD
130 LET FAIL = 0
140 IF ORD("A") <> 65 THEN LET FAIL = FAIL + 1
150 IF ORD("a") <> 97 THEN LET FAIL = FAIL + 1
160 IF NOT ("A" < "a") THEN LET FAIL = FAIL + 1
170 IF NOT ("Z" < "a") THEN LET FAIL = FAIL + 1
180 IF NOT ("9" < "A") THEN LET FAIL = FAIL + 1
190 IF NOT ("ABC" < "ABCD") THEN LET FAIL = FAIL + 1
200 IF NOT ("" < "A") THEN LET FAIL = FAIL + 1
210 IF CHR$(65) <> "A" THEN LET FAIL = FAIL + 1
220 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END
