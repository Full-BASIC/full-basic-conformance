1 REM FBCS STR-0039
2 REM CLAIM E-4010
3 REM TYPE SELF
100 REM REPEAT$ with a repeat count below zero: 4010, fatal.
110 WHEN EXCEPTION IN
120   LET S$ = REPEAT$("X", -1)
130   PRINT "*** TEST FAILED: NO EXCEPTION ***"
140 USE
150   IF EXTYPE = 4010 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
160 END WHEN
170 END
