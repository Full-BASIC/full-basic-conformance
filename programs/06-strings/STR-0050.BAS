1 REM FBCS STR-0050
2 REM CLAIM A-6.6.3-EX
3 REM TYPE SELF
100 REM Examples of 6.6.3: COLLATE NATIVE plus STRING*8 with per-variable
110 REM length-max. Precedence (6.6.4): own length-max wins, else the type's.
120 OPTION COLLATE NATIVE
130 DECLARE STRING *8 LAST_NAME$ *20, FIRST_NAME$, MIDDLE_NAME$
140 LET FAIL = 0
150 IF MAXLEN(LAST_NAME$) <> 20 THEN LET FAIL = FAIL + 1
160 IF MAXLEN(FIRST_NAME$) <> 8 THEN LET FAIL = FAIL + 1
170 IF MAXLEN(MIDDLE_NAME$) <> 8 THEN LET FAIL = FAIL + 1
180 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
