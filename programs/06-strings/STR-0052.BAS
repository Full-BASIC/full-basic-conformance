1 REM FBCS STR-0052
2 REM CLAIM A-6.6.4-01
3 REM TYPE SELF
100 REM OPTION COLLATE NATIVE selects the host system's own ordering; on this
110 REM host (ASCII/UTF-8 byte order) "A" < "a" and CHR$(65) = "A" still hold.
120 OPTION COLLATE NATIVE
130 LET FAIL = 0
140 IF NOT ("A" < "a") THEN LET FAIL = FAIL + 1
150 IF NOT ("9" < "A") THEN LET FAIL = FAIL + 1
160 IF ORD("A") <> 65 THEN LET FAIL = FAIL + 1
170 IF CHR$(65) <> "A" THEN LET FAIL = FAIL + 1
180 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
