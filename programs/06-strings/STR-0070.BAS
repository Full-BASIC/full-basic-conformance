1 REM FBCS STR-0070
2 REM CLAIM A-6.4.4-07
3 REM TYPE SELF
100 REM STR$ of a value with magnitude < 1 has no digit left of the period (FIXED*5.2 gives the same text as PRINT)
110 REM Standard 6.4.4 l.2702-2705 with 10.3.4.1 l.5390-5391
120 OPTION ARITHMETIC FIXED*5.2
130 LET FAIL = 0
140 LET A = 1 / 2
150 LET B = -1 / 4
160 IF STR$(A) <> ".50" THEN LET FAIL = FAIL + 1
170 IF STR$(B) <> "-.25" THEN LET FAIL = FAIL + 1
180 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
