1 REM FBCS STR-0032
2 REM CLAIM A-6.4.4-06
3 REM TYPE SELF
100 REM Three-argument POS searches from the Mth character on; standard example:
110 REM A$="GRANDSTANDING": POS(A$,"AN",1)=3, POS(A$,"AN",4)=8, POS(A$,"AN",9)=0.
120 REM POS(A$,"",M) = MAX(M,1) while M <= LEN(A$); M > LEN(A$) gives 0.
130 LET FAIL = 0
140 LET A$ = "GRANDSTANDING"
150 IF POS(A$,"AN",1) <> 3 THEN LET FAIL = FAIL + 1
160 IF POS(A$,"AN",4) <> 8 THEN LET FAIL = FAIL + 1
170 IF POS(A$,"AN",9) <> 0 THEN LET FAIL = FAIL + 1
180 IF POS("ABC","",2) <> 2 THEN LET FAIL = FAIL + 1
190 IF POS("ABC","",0) <> 1 THEN LET FAIL = FAIL + 1
200 IF POS("ABC","",5) <> 0 THEN LET FAIL = FAIL + 1
210 IF POS(A$,"Z",1) <> 0 THEN LET FAIL = FAIL + 1
220 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
230 END
