1 REM FBCS STR-0058
2 REM CLAIM D-6.4-3
3 REM TYPE SELF
100 REM Calendar and clock availability (implementation-defined): available.
110 REM DATE$ is "YYYYMMDD" (l.2620) and TIME$ is 24-hour "HH:MM:SS" (l.2712).
120 LET FAIL = 0
130 LET D$ = DATE$
140 LET T$ = TIME$
150 IF LEN(D$) <> 8 THEN LET FAIL = FAIL + 1
160 IF VAL(D$(1:4)) < 1900 OR VAL(D$(1:4)) > 3000 THEN LET FAIL = FAIL + 1
170 IF VAL(D$(5:6)) < 1 OR VAL(D$(5:6)) > 12 THEN LET FAIL = FAIL + 1
180 IF VAL(D$(7:8)) < 1 OR VAL(D$(7:8)) > 31 THEN LET FAIL = FAIL + 1
190 IF LEN(T$) <> 8 THEN LET FAIL = FAIL + 1
200 IF T$(3:3) <> ":" THEN LET FAIL = FAIL + 1
210 IF T$(6:6) <> ":" THEN LET FAIL = FAIL + 1
220 IF VAL(T$(1:2)) < 0 OR VAL(T$(1:2)) > 23 THEN LET FAIL = FAIL + 1
230 IF VAL(T$(4:5)) < 0 OR VAL(T$(4:5)) > 59 THEN LET FAIL = FAIL + 1
240 IF VAL(T$(7:8)) < 0 OR VAL(T$(7:8)) > 59 THEN LET FAIL = FAIL + 1
250 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
260 END
