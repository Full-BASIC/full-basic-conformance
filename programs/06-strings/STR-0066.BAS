1 REM FBCS STR-0066
2 REM CLAIM E-4002
3 REM TYPE SELF
100 REM The index argument of CHR$/REPEAT$ is rounded first (6.4.4 l.2596-2597,
110 REM index = INT(X+.5) per 5.2.4 l.1700-1702), then range-checked:
120 REM CHR$(255.6) rounds to 256 -> 4002 (6.4.5 l.2745-2746); CHR$(-.6) rounds
130 REM to -1 -> 4002; REPEAT$("A",-.6) rounds to -1 -> 4010 (6.4.5 l.2751-2752).
140 WHEN EXCEPTION IN
150   LET S$ = CHR$(255.6)
160   PRINT "*** TEST FAILED: NO EXCEPTION (255.6) ***"
170 USE
180   IF EXTYPE = 4002 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
190 END WHEN
200 WHEN EXCEPTION IN
210   LET S$ = CHR$(-.6)
220   PRINT "*** TEST FAILED: NO EXCEPTION (-.6) ***"
230 USE
240   IF EXTYPE = 4002 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
250 END WHEN
260 WHEN EXCEPTION IN
270   LET S$ = REPEAT$("A", -.6)
280   PRINT "*** TEST FAILED: NO EXCEPTION (repeat) ***"
290 USE
300   IF EXTYPE = 4010 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: EXTYPE ***"; EXTYPE
310 END WHEN
320 END
