1 REM FBCS STR-0055
2 REM CLAIM A-6.6.4-04
3 REM TYPE SELF
100 REM A length-max of 0 in a STRING declaration caps the variable at the
110 REM null string (l.2898-2899): storing "" is OK, anything longer is 1106.
120 DECLARE STRING Z$ * 0
130 LET FAIL = 0
140 IF MAXLEN(Z$) <> 0 THEN LET FAIL = FAIL + 1
150 LET Z$ = ""
160 IF LEN(Z$) <> 0 THEN LET FAIL = FAIL + 1
170 WHEN EXCEPTION IN
180   LET Z$ = "A"
190   PRINT "*** TEST FAILED: NO EXCEPTION ***"
200 USE
210   IF EXTYPE = 1106 THEN LET OK1106 = 1 ELSE LET OK1106 = 0
220 END WHEN
230 IF OK1106 = 0 THEN LET FAIL = FAIL + 1
240 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
250 END
